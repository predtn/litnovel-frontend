@page
@model litnovel_frontend.Pages.Admin.NovelOverride.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Novel Override";
    ViewData["ActiveNav"] = "admin";
    var novel = Model.Novel;
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Novel Override</h1>
        <p class="page-header__subtitle">Quản lý trạng thái, tác giả và chapter của novel.</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

<form class="admin-toolbar" method="get">
    <input class="form-input" name="q" value="@Model.Query" placeholder="Tìm novel theo tên" />
    <button class="btn btn-primary" type="submit">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <a class="btn btn-secondary" href="/Admin/NovelOverride">Clear</a>
    }
</form>

<section class="card mb-xl">
    <div class="flex justify-between items-center gap-md mb-md" style="flex-wrap:wrap;">
        <h2 class="text-display-sm">Novel list</h2>
        <span class="badge badge-secondary">Page @Model.Page / @Model.TotalPages</span>
    </div>
    @if (Model.SearchResults.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state__title">No novels found</div>
            <p class="empty-state__text">Try a different keyword.</p>
        </div>
    }
    else
    {
        <div class="admin-list">
            @foreach (var item in Model.SearchResults)
            {
                <a class="admin-list-row @(novel?.Id == item.Id ? "active" : "")" href="/Admin/NovelOverride?novelId=@item.Id&q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Model.Page">
                    @if (!string.IsNullOrWhiteSpace(item.CoverImage))
                    {
                        <img src="@item.CoverImage" alt="@item.Title" class="publish-cover-sm" />
                    }
                    else
                    {
                        <div class="publish-cover-sm publish-cover-empty">@(string.IsNullOrWhiteSpace(item.Title) ? "N" : item.Title[..1])</div>
                    }
                    <div class="admin-list-row__body">
                        <div class="font-medium truncate">@item.Title</div>
                        <div class="text-caption text-mute truncate">@item.Author?.Username · @item.TotalChapters chương · @item.Status</div>
                    </div>
                    <span class="btn btn-secondary btn-sm">Select</span>
                </a>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="pagination mt-md">
                <a class="pagination__btn @(Model.Page <= 1 ? "disabled" : "")" href="/Admin/NovelOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Math.Max(1, Model.Page - 1)">‹</a>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="pagination__btn @(i == Model.Page ? "active" : "")" href="/Admin/NovelOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@i">@i</a>
                }
                <a class="pagination__btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="/Admin/NovelOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Math.Min(Model.TotalPages, Model.Page + 1)">›</a>
            </div>
        }
    }
</section>

@if (novel != null)
{
    <div class="admin-detail-grid">
        <section class="card">
            <div class="flex gap-lg items-start admin-profile-header">
                @if (!string.IsNullOrWhiteSpace(novel.CoverImage))
                {
                    <img src="@novel.CoverImage" alt="@novel.Title" class="publish-cover-lg" />
                }
                else
                {
                    <div class="publish-cover-lg publish-cover-empty">@novel.Title[..1]</div>
                }
                <div class="w-full" style="min-width:0;">
                    <div class="flex gap-sm items-center mb-sm" style="flex-wrap:wrap;">
                        <span class="status-badge status-@novel.Status.ToLowerInvariant()">@novel.Status</span>
                        @if (novel.Category != null)
                        {
                            <span class="badge badge-secondary">@novel.Category.Name</span>
                        }
                    </div>
                    <h2 class="text-display-md">@novel.Title</h2>
                    <p class="text-body text-mute mt-sm">Tác giả: @novel.Author?.Username</p>
                    @if (!string.IsNullOrWhiteSpace(novel.Description))
                    {
                        <div class="text-body mt-md">@Html.Raw(novel.Description)</div>
                    }
                </div>
            </div>
            <div class="grid-4 mt-xl">
                <div class="card-soft"><div class="text-caption text-mute">Views</div><div class="text-display-sm">@novel.ViewCount</div></div>
                <div class="card-soft"><div class="text-caption text-mute">Likes</div><div class="text-display-sm">@novel.LikeCount</div></div>
                <div class="card-soft"><div class="text-caption text-mute">Chapters</div><div class="text-display-sm">@novel.TotalChapters</div></div>
                <div class="card-soft"><div class="text-caption text-mute">Rating</div><div class="text-display-sm">@novel.RatingAverage.ToString("0.0")</div></div>
            </div>

            <div class="divider"></div>
            <h3 class="text-display-sm mb-md">Volume và chapter</h3>
            @if (novel.Volumes.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state__title">Novel chưa có chapter</div>
                </div>
            }
            else
            {
                <div class="admin-volume-list">
                    @foreach (var volume in novel.Volumes.OrderBy(v => v.VolumeNumber))
                    {
                        <details class="card-soft admin-volume">
                            <summary>
                                <span class="font-semibold">@volume.Title</span>
                                <span class="text-caption text-mute">@volume.Chapters.Count chương</span>
                            </summary>
                            <div class="admin-chapter-list">
                                @foreach (var chapter in volume.Chapters.OrderBy(c => c.ChapterNumber))
                                {
                                    <div class="admin-chapter-row">
                                        <div>
                                            <div class="font-medium truncate">Chương @chapter.ChapterNumber: @chapter.Title</div>
                                            <div class="text-caption text-mute">@chapter.WordCount từ · @chapter.UpdatedAt.ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <span class="status-badge status-@chapter.Status.ToLowerInvariant()">@chapter.Status</span>
                                        <a class="btn btn-secondary btn-sm" href="/Admin/ChapterOverride?novelId=@novel.Id&chapterId=@chapter.Id">Override</a>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </section>

        <aside class="card">
            <h2 class="text-display-sm mb-md">Override panel</h2>
            <form method="post" asp-page-handler="Status" class="flex-col gap-md">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@novel.Id" />
                <label class="form-group">
                    <span class="form-label">Trạng thái novel</span>
                    <select class="form-select" name="status">
                        @foreach (var status in new[] { "Ongoing", "Ended", "Hiatus", "Dropped", "Canceled" })
                        {
                            <option value="@status" selected="@(novel.Status == status)">@status</option>
                        }
                    </select>
                </label>
                <input class="form-input" name="reason" placeholder="Lý do thay đổi" required />
                <button class="btn btn-primary" type="submit">Đổi trạng thái</button>
            </form>
            <div class="divider"></div>
            <form method="post" asp-page-handler="Author" class="flex-col gap-md">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@novel.Id" />
                <label class="form-group">
                    <span class="form-label">Tác giả mới</span>
                    <select class="form-select" name="authorId" required>
                        <option value="">Chọn tác giả</option>
                        @foreach (var user in Model.AuthorCandidates)
                        {
                            <option value="@user.Id" selected="@(novel.Author?.Id == user.Id)">@user.Username (@user.Email)</option>
                        }
                    </select>
                </label>
                <input class="form-input" name="reason" placeholder="Lý do thay đổi" required />
                <button class="btn btn-secondary" type="submit">Đổi tác giả</button>
            </form>
            <div class="divider"></div>
            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Force delete this novel?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@novel.Id" />
                <button class="btn btn-danger w-full" type="submit">Force delete</button>
            </form>
        </aside>
    </div>
}
else if (string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="empty-state">
        <div class="empty-state__title">Select a novel</div>
        <p class="empty-state__text">Choose a novel from the list to open the override panel.</p>
    </div>
}
