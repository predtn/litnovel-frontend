@page
@using System.Globalization
@using litnovel_frontend.Services
@model litnovel_frontend.Pages.Admin.Statistics.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Statistics Charts";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Statistics Charts</h1>
        <p class="page-header__subtitle">Daily and monthly growth snapshots.</p>
    </div>
</div>

<form class="admin-toolbar admin-toolbar--chart-ranges" method="get">
    <label class="form-group">
        <span class="form-label">Daily range</span>
        <select class="form-select" name="dayRange" onchange="this.form.submit()">
            <option value="7" selected="@(Model.DayRange == "7")">7 days</option>
            <option value="30" selected="@(Model.DayRange == "30")">30 days</option>
            <option value="90" selected="@(Model.DayRange == "90")">90 days</option>
        </select>
    </label>
    <label class="form-group">
        <span class="form-label">Month detail</span>
        <input class="form-input" type="month" name="month" value="@Model.SelectedMonth" onchange="this.form.submit()" />
    </label>
    <button class="btn btn-secondary" type="submit">Apply</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Khong tai duoc bieu do</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}

<div class="admin-chart-grid">
    <section class="card admin-chart-card">
        <div class="admin-chart-card__header">
            <h2 class="text-display-sm">Daily growth</h2>
            <span class="text-caption text-mute">@Model.DayRange days</span>
        </div>
        @if (Model.DailyGrowth.Points.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No chart data</div>
                <p class="empty-state__text">The chart API returned no points for this range.</p>
            </div>
        }
        else
        {
            var points = Model.DailyGrowth.Points;
            var max = Math.Max(1, points.Max(p => p.Value));
            var pointCount = Math.Max(1, points.Count - 1);
            var coordinates = BuildCoordinates(points, max, pointCount);

            <div class="admin-line-chart" role="img" aria-label="Daily user growth">
                <svg viewBox="0 0 500 200" preserveAspectRatio="none">
                    <line x1="24" y1="172" x2="476" y2="172" class="admin-line-chart__axis" />
                    <line x1="24" y1="40" x2="24" y2="172" class="admin-line-chart__axis" />
                    <polyline points="@coordinates" class="admin-line-chart__line" />
                    @foreach (var point in points.Select((value, index) => new { value, index }))
                    {
                        var x = 24 + (point.index * 452.0 / pointCount);
                        var y = 172 - (point.value.Value * 132.0 / max);
                        <circle cx="@SvgNumber(x)" cy="@SvgNumber(y)" r="4" class="admin-line-chart__dot" tabindex="0">
                            <title>@point.value.Date: @point.value.Value</title>
                        </circle>
                    }
                </svg>
            </div>
            <div class="admin-chart__legend">
                <span>@points.First().Date</span>
                <span>Max @max</span>
                <span>@points.Last().Date</span>
            </div>
        }
    </section>

    <section class="card admin-chart-card">
        <div class="admin-chart-card__header">
            <h2 class="text-display-sm">Monthly growth</h2>
            <span class="text-caption text-mute">@(string.IsNullOrWhiteSpace(Model.SelectedMonth) ? "12 months" : Model.SelectedMonth)</span>
        </div>
        @if (Model.MonthlyGrowth.Points.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No chart data</div>
                <p class="empty-state__text">The chart API returned no points for this range.</p>
            </div>
        }
        else
        {
            var points = Model.MonthlyGrowth.Points;
            var max = Math.Max(1, points.Max(p => p.Value));
            var pointCount = Math.Max(1, points.Count - 1);
            var coordinates = BuildCoordinates(points, max, pointCount);

            <div class="admin-line-chart" role="img" aria-label="Monthly user growth">
                <svg viewBox="0 0 500 200" preserveAspectRatio="none">
                    <line x1="24" y1="172" x2="476" y2="172" class="admin-line-chart__axis" />
                    <line x1="24" y1="40" x2="24" y2="172" class="admin-line-chart__axis" />
                    <polyline points="@coordinates" class="admin-line-chart__line" />
                    @foreach (var point in points.Select((value, index) => new { value, index }))
                    {
                        var x = 24 + (point.index * 452.0 / pointCount);
                        var y = 172 - (point.value.Value * 132.0 / max);
                        <circle cx="@SvgNumber(x)" cy="@SvgNumber(y)" r="4" class="admin-line-chart__dot" tabindex="0">
                            <title>@point.value.Date: @point.value.Value</title>
                        </circle>
                    }
                </svg>
            </div>
            <div class="admin-chart__legend">
                <span>@points.First().Date</span>
                <span>Max @max</span>
                <span>@points.Last().Date</span>
            </div>
        }
    </section>
</div>

@functions {
    private static string BuildCoordinates(List<ChartPointDto> points, int max, int pointCount)
        => string.Join(" ", points.Select((point, index) =>
        {
            var x = 24 + (index * 452.0 / pointCount);
            var y = 172 - (point.Value * 132.0 / max);
            return $"{SvgNumber(x)},{SvgNumber(y)}";
        }));

    private static string SvgNumber(double value)
        => value.ToString("0.##", CultureInfo.InvariantCulture);
}
