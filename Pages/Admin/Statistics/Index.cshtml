@page
@model litnovel_frontend.Pages.Admin.Statistics.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Statistics Charts";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Statistics Charts</h1>
        <p class="page-header__subtitle">Chart-only analytics. Numeric summaries stay on the Admin Dashboard.</p>
    </div>
    <form class="admin-toolbar admin-toolbar--inline" method="get">
        <input class="form-input" type="date" name="from" value="@Model.FromDate" />
        <input class="form-input" type="date" name="to" value="@Model.ToDate" />
        <button class="btn btn-secondary" type="submit">Apply</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Khong tai duoc bieu do</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}

<div class="admin-chart-grid">
    <section class="card admin-chart-card">
        <h2 class="text-display-sm mb-md">User growth</h2>
        @if (Model.UserGrowth.Points.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No chart data</div>
                <p class="empty-state__text">The chart API returned no points for this range.</p>
            </div>
        }
        else
        {
            var max = Math.Max(1, Model.UserGrowth.Points.Max(p => p.Value));
            <div class="admin-chart">
                @foreach (var point in Model.UserGrowth.Points)
                {
                    <div class="admin-chart__row">
                        <span class="admin-chart__date">@point.Date</span>
                        <div class="admin-chart__track"><div class="admin-chart__bar" style="width:@(point.Value * 100 / max)%"></div></div>
                        <span class="admin-chart__value">@point.Value</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="card admin-chart-card">
        <h2 class="text-display-sm mb-md">Novel publish rate</h2>
        @if (Model.NovelPublishRate.Points.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No chart data</div>
                <p class="empty-state__text">The chart API returned no points for this range.</p>
            </div>
        }
        else
        {
            var max = Math.Max(1, Model.NovelPublishRate.Points.Max(p => p.Value));
            <div class="admin-chart">
                @foreach (var point in Model.NovelPublishRate.Points)
                {
                    <div class="admin-chart__row">
                        <span class="admin-chart__date">@point.Date</span>
                        <div class="admin-chart__track"><div class="admin-chart__bar" style="width:@(point.Value * 100 / max)%"></div></div>
                        <span class="admin-chart__value">@point.Value</span>
                    </div>
                }
            </div>
        }
    </section>
</div>
