@page
@model litnovel_frontend.Pages.Admin.Statistics.IndexModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Thống kê hệ thống"; var s = Model.Stats; }
@section Sidebar {
    <a href="/Admin/Dashboard" class="sidebar__link">Tổng quan</a>
    <a href="/Admin/Statistics" class="sidebar__link active">Thống kê</a>
    <div class="sidebar__section-label">Nội dung</div>
    <a href="/Admin/Users" class="sidebar__link">Người dùng</a>
    <a href="/Admin/Categories" class="sidebar__link">Thể loại</a>
}
<!-- SCR-59: Statistics Dashboard -->
<div class="page-header"><h1 class="page-header__title">📊 Thống kê hệ thống</h1></div>

<div class="grid-4 mb-xl">
    <div class="stat-card"><div class="stat-card__label">Người dùng mới (30d)</div><div class="stat-card__value">@s.NewUsers</div><div class="stat-card__change up">▲ +@s.UserGrowthPercent%</div></div>
    <div class="stat-card"><div class="stat-card__label">Truyện mới (30d)</div><div class="stat-card__value">@s.NewNovels</div></div>
    <div class="stat-card"><div class="stat-card__label">Chương đăng (7d)</div><div class="stat-card__value">@s.ChaptersThisWeek</div></div>
    <div class="stat-card"><div class="stat-card__label">Tổng lượt xem</div><div class="stat-card__value">@FormatNum(s.TotalViews)</div></div>
</div>

<div class="grid-2 mb-xl">
    <div class="card">
        <h3 class="text-body-sm font-semibold mb-md">📚 Top truyện lượt xem</h3>
        @foreach (var n in s.TopNovels)
        {
            <div class="flex items-center gap-sm mb-sm">
                <div style="width:24px;height:24px;border-radius:50%;background:var(--color-canvas-soft-2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;">@n.Rank</div>
                <div style="flex:1;min-width:0;"><div class="text-body-sm truncate">@n.Title</div><div class="text-caption text-mute">@FormatNum(n.ViewCount) lượt xem</div></div>
            </div>
        }
    </div>
    <div class="card">
        <h3 class="text-body-sm font-semibold mb-md">👤 Tác giả tích cực nhất</h3>
        @foreach (var a in s.TopAuthors)
        {
            <div class="flex items-center gap-sm mb-sm">
                <div class="avatar-placeholder" style="width:28px;height:28px;border-radius:50%;background:var(--color-canvas-soft-2);display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@a.Username.Substring(0,1).ToUpper()</div>
                <div style="flex:1;min-width:0;"><div class="text-body-sm">@a.Username</div><div class="text-caption text-mute">@a.NovelsCreated truyện · @FormatNum(a.TotalViews) views</div></div>
            </div>
        }
    </div>
</div>

@functions { string FormatNum(int n) => n >= 1000000 ? $"{n/1000000.0:0.#}M" : n >= 1000 ? $"{n/1000.0:0.#}K" : n.ToString(); }
