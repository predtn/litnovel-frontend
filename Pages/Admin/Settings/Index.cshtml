@page
@model litnovel_frontend.Pages.Admin.Settings.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Cài đặt hệ thống";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Cài đặt hệ thống</h1>
        <p class="page-header__subtitle">Điều chỉnh thông tin chung, nội dung và quy trình kiểm duyệt.</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

<form method="post" class="admin-stack">
    @Html.AntiForgeryToken()
    <section class="card">
        <h2 class="text-display-sm mb-md">General</h2>
        <div class="publish-form-grid">
            <label class="form-group"><span class="form-label">Site name</span><input name="siteName" class="form-input" value="@Model.Settings.General.SiteName" required /></label>
            <label class="form-group"><span class="form-label">Tagline</span><input name="tagline" class="form-input" value="@Model.Settings.General.Tagline" required /></label>
        </div>
        <label class="form-check mt-md"><input type="checkbox" name="maintenanceMode" value="true" checked="@Model.Settings.General.MaintenanceMode" /> Maintenance mode</label>
    </section>

    <section class="card">
        <h2 class="text-display-sm mb-md">Content</h2>
        <div class="publish-form-grid">
            <label class="form-group"><span class="form-label">Max novel description length</span><input name="maxNovelDescriptionLength" type="number" min="1" class="form-input" value="@Model.Settings.Content.MaxNovelDescriptionLength" /></label>
            <label class="form-group"><span class="form-label">Max chapter length</span><input name="maxChapterLength" type="number" min="1" class="form-input" value="@Model.Settings.Content.MaxChapterLength" /></label>
        </div>
    </section>

    <section class="card">
        <h2 class="text-display-sm mb-md">Moderation</h2>
        <div class="publish-form-grid">
            <label class="form-group"><span class="form-label">Review SLA hours</span><input name="reviewSLAHours" type="number" min="1" class="form-input" value="@Model.Settings.Moderation.ReviewSLAHours" /></label>
            <label class="form-group"><span class="form-label">Auto-flag keywords</span><input name="autoFlagKeywords" class="form-input" value="@string.Join(", ", Model.Settings.Moderation.AutoFlagKeywords)" /></label>
        </div>
    </section>

    <div class="publish-form-actions">
        <button type="submit" class="btn btn-primary">Lưu cài đặt</button>
    </div>
</form>
