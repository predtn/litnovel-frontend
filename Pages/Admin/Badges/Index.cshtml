@page
@model litnovel_frontend.Pages.Admin.Badges.IndexModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Quản lý huy hiệu"; }
@section Sidebar {<a href="/Admin/Dashboard" class="sidebar__link">Tổng quan</a><div class="sidebar__section-label">Nội dung</div><a href="/Admin/Users" class="sidebar__link">Người dùng</a><a href="/Admin/Categories" class="sidebar__link">Thể loại</a><a href="/Admin/Tags" class="sidebar__link">Tag</a><a href="/Admin/Badges" class="sidebar__link active">Huy hiệu</a>}
<!-- SCR-51 -->
<div class="page-header"><h1 class="page-header__title">🏅 Quản lý huy hiệu</h1><button class="btn btn-primary" onclick="openModal('addModal')">+ Thêm huy hiệu</button></div>
@if (TempData["Success"] is string ok) { <div class="alert alert-success mb-md alert-auto-close">@ok</div> }
<div class="grid-4" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:var(--space-md);">
    @foreach (var b in Model.Badges)
    {
        <div class="card" style="text-align:center;padding:var(--space-xl);">
            <div style="font-size:40px;margin-bottom:var(--space-sm);">@b.Icon</div>
            <div class="text-body-sm font-semibold">@b.Name</div>
            <div class="text-caption text-mute mt-xs">@b.Description</div>
            <div class="text-caption text-mute mt-xs">@b.EarnedCount người đạt</div>
        </div>
    }
</div>
<div class="modal-overlay" id="addModal"><div class="modal">
    <div class="modal__header"><div class="modal__title">Thêm huy hiệu</div><button class="modal__close" onclick="closeModal('addModal')">✕</button></div>
    <form method="post" asp-page-handler="Add">@Html.AntiForgeryToken()
        <div class="form-group"><label class="form-label">Icon (emoji)</label><input name="icon" class="form-input" placeholder="🏅" maxlength="4" /></div>
        <div class="form-group"><label class="form-label">Tên huy hiệu</label><input name="name" class="form-input" required /></div>
        <div class="form-group"><label class="form-label">Mô tả</label><input name="description" class="form-input" /></div>
        <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Hủy</button><button type="submit" class="btn btn-primary">Thêm</button></div>
    </form>
</div></div>
