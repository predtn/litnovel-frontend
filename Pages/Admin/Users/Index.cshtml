@page
@model litnovel_frontend.Pages.Admin.Users.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Quản lý người dùng</h1>
        <p class="page-header__subtitle">@Model.TotalElements người dùng</p>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success mb-md alert-auto-close">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-error mb-md">@error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Không tải được danh sách người dùng</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}

<div class="admin-toolbar">
    <div class="search-bar" style="width:min(320px, 100%);">
        <svg class="search-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <form method="get">
            <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tên, email..." onchange="this.form.submit()" />
            <input type="hidden" name="role" value="@Model.RoleFilter" />
            <input type="hidden" name="status" value="@Model.StatusFilter" />
        </form>
    </div>
    <select class="form-select" onchange="updateQueryParam('role', this.value)">
        <option value="">Tất cả vai trò</option>
        <option value="User" selected="@(Model.RoleFilter == "User")">User</option>
        <option value="Staff" selected="@(Model.RoleFilter == "Staff")">Staff</option>
        <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
    </select>
    <select class="form-select" onchange="updateQueryParam('status', this.value)">
        <option value="">Tất cả trạng thái</option>
        <option value="Online" selected="@(Model.StatusFilter == "Online")">Online</option>
        <option value="Offline" selected="@(Model.StatusFilter == "Offline")">Offline</option>
        <option value="Banned" selected="@(Model.StatusFilter == "Banned")">Banned</option>
    </select>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Người dùng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày tham gia</th>
                <th class="col-actions">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td data-label="Người dùng">
                        <div class="flex gap-sm items-center">
                            <div class="avatar-placeholder avatar-sm" style="flex-shrink:0;">@(user.Username[..1].ToUpper())</div>
                            <div class="text-body-sm font-medium truncate">@user.Username</div>
                        </div>
                    </td>
                    <td data-label="Email" class="text-body-sm text-mute">@user.Email</td>
                    <td data-label="Vai trò"><span class="badge badge-secondary role-@user.Role.ToLowerInvariant()">@user.Role</span></td>
                    <td data-label="Trạng thái"><span class="status-badge status-@user.Status.ToLowerInvariant()">@user.Status</span></td>
                    <td data-label="Ngày tham gia" class="text-caption text-mute">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td data-label="Hành động" class="col-actions">
                        <div class="flex gap-xs justify-end">
                            <a href="/Admin/Users/@user.Id" class="btn btn-secondary btn-sm">Chi tiết</a>
                            @if (!user.Status.Equals("Banned", StringComparison.OrdinalIgnoreCase))
                            {
                                <form method="post" asp-page-handler="Ban" style="display:inline;" onsubmit="return confirm('Xác nhận cấm người dùng này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Cấm</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Unban" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-secondary btn-sm">Bỏ cấm</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex justify-center mt-xl">
        <div class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="?page=@i&keyword=@Model.Keyword&role=@Model.RoleFilter&status=@Model.StatusFilter"
                   class="pagination__btn @(i == Model.Page ? "active" : "")">@i</a>
            }
        </div>
    </div>
}
