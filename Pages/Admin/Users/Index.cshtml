@page
@model litnovel_frontend.Pages.Admin.Users.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Quản lý người dùng</h1>
        <p class="page-header__subtitle">@Model.TotalElements người dùng</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Không tải được danh sách người dùng</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}

<form class="admin-toolbar" method="get" id="userQuickFilter">
    <div class="search-bar" style="width:min(320px, 100%);">
        <svg class="search-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tên, email..." data-quick-filter-input />
    </div>
    <select class="form-select" name="status" data-quick-filter-select>
        <option value="">Tất cả trạng thái</option>
        <option value="Online" selected="@(Model.StatusFilter == "Online")">Đang online</option>
        <option value="Offline" selected="@(Model.StatusFilter == "Offline")">Offline</option>
    </select>
    @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
    {
        <a class="btn btn-secondary" href="/Admin/Users">Xóa lọc</a>
    }
</form>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Người dùng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày tham gia</th>
                <th class="col-actions">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td data-label="Người dùng">
                        <div class="flex gap-sm items-center">
                            <div class="avatar-placeholder avatar-sm" style="flex-shrink:0;">@((string.IsNullOrWhiteSpace(user.Username) ? "?" : user.Username[..1]).ToUpper())</div>
                            <div class="text-body-sm font-medium truncate">@user.Username</div>
                        </div>
                    </td>
                    <td data-label="Email" class="text-body-sm text-mute">@user.Email</td>
                    <td data-label="Vai trò"><span class="badge badge-secondary role-@user.Role.ToLowerInvariant()">@DisplayText.Role(user.Role)</span></td>
                    <td data-label="Trạng thái"><span class="status-badge status-@user.Status.ToLowerInvariant()">@DisplayText.Status(user.Status)</span></td>
                    <td data-label="Ngày tham gia" class="text-caption text-mute">@(user.JoinedDate == default ? "-" : user.JoinedDate.ToString("dd/MM/yyyy"))</td>
                    <td data-label="Hành động" class="col-actions">
                        <div class="flex gap-xs justify-end">
                            <a href="/Admin/Users/@user.Id" class="btn btn-secondary btn-sm">Chi tiết</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex justify-center mt-xl">
        <div class="pagination">
            <a href="?page=@Math.Max(1, Model.Page - 1)&keyword=@Model.Keyword&status=@Model.StatusFilter"
               class="pagination__btn @(Model.Page <= 1 ? "disabled" : "")">‹</a>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="?page=@i&keyword=@Model.Keyword&status=@Model.StatusFilter"
                   class="pagination__btn @(i == Model.Page ? "active" : "")">@i</a>
            }
            <a href="?page=@Math.Min(Model.TotalPages, Model.Page + 1)&keyword=@Model.Keyword&status=@Model.StatusFilter"
               class="pagination__btn @(Model.Page >= Model.TotalPages ? "disabled" : "")">›</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('userQuickFilter');
            if (!form) return;

            let timer;
            const submit = () => {
                const page = form.querySelector('input[name="page"]');
                if (page) page.remove();
                form.requestSubmit();
            };

            form.querySelector('[data-quick-filter-input]')?.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(submit, 400);
            });
            form.querySelector('[data-quick-filter-select]')?.addEventListener('change', submit);
        })();
    </script>
}
