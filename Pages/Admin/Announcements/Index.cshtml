@page
@model litnovel_frontend.Pages.Admin.Announcements.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Thông báo trang";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Banner thông báo</h1>
        <p class="page-header__subtitle">Gửi một dòng nhắn nổi bật để người đọc dễ bắt kịp thông tin quan trọng.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openModal('addModal')">Thêm thông báo</button>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

@if (Model.Announcements.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__title">Chưa có banner</div>
        <p class="empty-state__text">Khi có tin cần nhắn nhanh, bạn có thể thêm một banner ngắn gọn cho người đọc.</p>
    </div>
}
else
{
    <div class="admin-announcement-grid">
        @foreach (var announcement in Model.Announcements.OrderByDescending(item => item.StartDate))
        {
            <article class="card admin-announcement-card">
                <div class="admin-announcement-card__meta">
                    <span class="status-badge @(announcement.IsActive ? "status-resolved" : "status-offline")">@(announcement.IsActive ? "Đang bật" : "Đang tắt")</span>
                    <span class="text-caption text-mute">
                        @DisplayDateTime.Format(announcement.StartDate, "dd/MM/yyyy HH:mm")
                        -
                        @DisplayDateTime.Format(announcement.EndDate, "dd/MM/yyyy HH:mm", "Không giới hạn")
                    </span>
                </div>
                <h2 class="text-display-sm">@announcement.Title</h2>
                <div class="admin-announcement-preview mt-sm">@Html.Raw(announcement.Content)</div>
                <div class="publish-actions mt-md">
                    <form method="post" asp-page-handler="Toggle">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@announcement.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">@(announcement.IsActive ? "Tắt" : "Bật")</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa thông báo này?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@announcement.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                    </form>
                </div>
            </article>
        }
    </div>
}

<div class="modal-overlay" id="addModal">
    <div class="modal modal--wide">
        <div class="modal__header">
            <div>
                <div class="modal__title">Thêm thông báo mới</div>
            </div>
            <button class="modal__close" type="button" onclick="closeModal('addModal')">x</button>
        </div>
        <form method="post" asp-page-handler="Add" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <label class="form-group">
                <span class="form-label">Tiêu đề</span>
                <input name="title" class="form-input" required maxlength="200" />
            </label>
            <label class="form-group">
                <span class="form-label">Nội dung thông báo</span>
                <textarea name="content" class="form-textarea" rows="4" required maxlength="2000"></textarea>
                <span class="form-hint">Thông báo sẽ phát ngay sau khi tạo, mỗi lượt 30 giây, cách nhau 15 phút và tối đa 3 lượt.</span>
            </label>
            <label class="form-check"><input type="checkbox" name="isActive" value="true" checked /> Banner công khai đang bật</label>
            <div class="modal__footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">Tạo</button>
            </div>
        </form>
    </div>
</div>
