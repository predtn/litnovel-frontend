@page
@model litnovel_frontend.Pages.Admin.Announcements.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Announcements";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Announcements</h1>
        <p class="page-header__subtitle">Banner/thông báo công khai hiển thị trên homepage hoặc khu vực announcement.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openModal('addModal')">Create announcement</button>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

@if (Model.Announcements.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__title">No announcements</div>
        <p class="empty-state__text">Create a public homepage banner or highlighted platform notice.</p>
    </div>
}
else
{
    <div class="admin-announcement-grid">
        @foreach (var announcement in Model.Announcements.OrderByDescending(item => item.StartDate))
        {
            <article class="card admin-announcement-card">
                <div class="admin-announcement-card__meta">
                    <span class="status-badge @(announcement.IsActive ? "status-resolved" : "status-offline")">@(announcement.IsActive ? "Active" : "Inactive")</span>
                    <span class="text-caption text-mute">
                        @announcement.StartDate.ToString("dd/MM/yyyy HH:mm")
                        -
                        @(announcement.EndDate?.ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")
                    </span>
                </div>
                <h2 class="text-display-sm">@announcement.Title</h2>
                <div class="admin-announcement-preview mt-sm">@Html.Raw(announcement.Content)</div>
                <div class="publish-actions mt-md">
                    <form method="post" asp-page-handler="Toggle">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@announcement.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">@(announcement.IsActive ? "Tắt" : "Bật")</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this announcement?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@announcement.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </article>
        }
    </div>
}

<div class="modal-overlay" id="addModal">
    <div class="modal modal--wide">
        <div class="modal__header">
            <div>
                <div class="modal__title">Create public announcement</div>
            </div>
            <button class="modal__close" type="button" onclick="closeModal('addModal')">x</button>
        </div>
        <form method="post" asp-page-handler="Add" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <label class="form-group">
                <span class="form-label">Title</span>
                <input name="title" class="form-input" placeholder="Scheduled Maintenance Notice" required maxlength="200" />
            </label>
            <label class="form-group">
                <span class="form-label">Content HTML</span>
                <textarea name="content" class="form-textarea" rows="6" placeholder="<p>The platform will be down for maintenance.</p>" required maxlength="2000"></textarea>
                <span class="form-hint">Max 2000 chars.</span>
            </label>
            <div class="publish-form-grid">
                <label class="form-group">
                    <span class="form-label">Start date</span>
                    <input name="startDate" type="datetime-local" class="form-input" required />
                </label>
                <label class="form-group">
                    <span class="form-label">End date</span>
                    <input name="endDate" type="datetime-local" class="form-input" />
                </label>
            </div>
            <label class="form-check"><input type="checkbox" name="isActive" value="true" checked /> Active public banner</label>
            <div class="modal__footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>
