@page
@model litnovel_frontend.Pages.Admin.Categories.IndexModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Quản lý thể loại"; }
@section Sidebar {
    <a href="/Admin/Dashboard" class="sidebar__link">Tổng quan</a>
    <div class="sidebar__section-label">Nội dung</div>
    <a href="/Admin/Users" class="sidebar__link">Người dùng</a>
    <a href="/Admin/Categories" class="sidebar__link active">Thể loại</a>
    <a href="/Admin/Tags" class="sidebar__link">Tag</a>
    <a href="/Admin/Badges" class="sidebar__link">Huy hiệu</a>
}
<!-- SCR-52: Novel Categories -->
<div class="page-header"><h1 class="page-header__title">Thể loại</h1>
    <button class="btn btn-primary" onclick="openModal('addModal')">+ Thêm thể loại</button>
</div>
@if (TempData["Success"] is string ok) { <div class="alert alert-success mb-md alert-auto-close">@ok</div> }
<div class="table-wrapper">
    <table class="table">
        <thead><tr><th>#</th><th>Tên</th><th>Số truyện</th><th class="col-actions">Hành động</th></tr></thead>
        <tbody>
            @{int i=1;}
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td class="text-caption text-mute">@(i++)</td>
                    <td class="text-body-sm font-medium">@c.Name</td>
                    <td class="text-body-sm">@c.NovelCount</td>
                    <td class="col-actions"><div class="flex gap-xs justify-end">
                        <button class="btn btn-secondary btn-sm" onclick="openEdit(@c.Id, '@c.Name')">Sửa</button>
                        <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Xóa thể loại này?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Thêm thể loại</div><button class="modal__close" onclick="closeModal('addModal')">✕</button></div>
        <form method="post" asp-page-handler="Add">@Html.AntiForgeryToken()
            <div class="form-group"><label class="form-label">Tên thể loại</label><input name="name" class="form-input" placeholder="Tên..." required /></div>
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Hủy</button><button type="submit" class="btn btn-primary">Thêm</button></div>
        </form>
    </div>
</div>
<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Sửa thể loại</div><button class="modal__close" onclick="closeModal('editModal')">✕</button></div>
        <form method="post" asp-page-handler="Edit">@Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="id" />
            <div class="form-group"><label class="form-label">Tên thể loại</label><input id="editName" name="name" class="form-input" required /></div>
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Hủy</button><button type="submit" class="btn btn-primary">Lưu</button></div>
        </form>
    </div>
</div>
@section Scripts {<script>
function openEdit(id,name){document.getElementById('editId').value=id;document.getElementById('editName').value=name;openModal('editModal');}
</script>}
