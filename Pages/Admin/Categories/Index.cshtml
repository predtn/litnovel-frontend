@page
@model litnovel_frontend.Pages.Admin.Categories.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Novel Categories";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Novel Categories</h1>
        <p class="page-header__subtitle">Manage category names and URL slugs.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openModal('addModal')">Add category</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-error mb-md">@error</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success mb-md alert-auto-close">@ok</div>
}

<div class="table-wrapper">
    <table class="table table--compact">
        <thead><tr><th>Name</th><th>Novels using</th><th class="col-actions">Actions</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Categories)
        {
            <tr>
                <td class="font-medium">@c.Name</td>
                <td>@c.NovelCount</td>
                <td class="col-actions">
                    <div class="publish-actions">
                        <button class="btn btn-secondary btn-sm" type="button" onclick="openEdit(@c.Id, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.Name)', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.Slug)')">Edit</button>
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this category?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Add category</div><button class="modal__close" type="button" onclick="closeModal('addModal')">x</button></div>
        <form method="post" asp-page-handler="Add" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <input class="form-input" name="name" placeholder="Name" required />
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="editModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Edit category</div><button class="modal__close" type="button" onclick="closeModal('editModal')">x</button></div>
        <form method="post" asp-page-handler="Edit" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="id" />
            <input class="form-input" id="editName" name="name" required />
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEdit(id, name, slug) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            openModal('editModal');
        }
    </script>
}
