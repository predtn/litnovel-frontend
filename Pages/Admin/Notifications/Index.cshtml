@page
@model litnovel_frontend.Pages.Admin.Notifications.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Notification Management";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Notification Management</h1>
        <p class="page-header__subtitle">Send platform alerts and review sent history.</p>
    </div>
</div>

<div class="grid-2">
    <section class="card">
        <h2 class="text-display-sm mb-md">Send notification</h2>
        <form class="flex-col gap-md" method="post" asp-page-handler="Send">
            @Html.AntiForgeryToken()
            <label class="form-group">
                <span class="form-label">Type</span>
                <select class="form-select" name="notificationType">
                    <option>SystemAlert</option>
                    <option>ReportUpdate</option>
                    <option>BadgeEarned</option>
                    <option>NewChapter</option>
                </select>
            </label>
            <label class="form-group">
                <span class="form-label">Message</span>
                <textarea class="form-textarea" name="message" maxlength="1000" required></textarea>
            </label>
            <label class="form-check"><input type="checkbox" name="targetAll" value="true" checked /> All users</label>
            <label class="form-group">
                <span class="form-label">Specific user ID</span>
                <input class="form-input" name="targetUserId" type="number" min="1" />
            </label>
            <button class="btn btn-primary" type="submit">Send notification</button>
        </form>
    </section>

    <section class="card">
        <h2 class="text-display-sm mb-md">Sent history</h2>
        <div class="flex-col gap-sm">
            @foreach (var item in Model.Notifications)
            {
                <div class="notif-item">
                    <div class="notif-icon">!</div>
                    <div class="notif-content">
                        <div class="flex gap-sm items-center mb-sm">
                            <span class="badge badge-info">@item.NotificationType</span>
                            <span class="text-caption text-mute">@item.Target</span>
                        </div>
                        <div class="notif-message">@item.Message</div>
                        <div class="notif-time">@((item.SentAt ?? item.CreatedAt)?.ToString("dd/MM/yyyy HH:mm") ?? "No timestamp") - @item.ReadCount reads</div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
