@page
@model litnovel_frontend.Pages.Admin.AuditLogs.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Audit Logs";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Audit Logs</h1>
        <p class="page-header__subtitle">System-level record of administrative actions.</p>
    </div>
</div>

<form class="admin-toolbar" method="get">
    <input class="form-input" name="actorId" type="number" min="1" placeholder="Actor ID" />
    <input class="form-input" name="entityType" placeholder="Entity type" />
    <input class="form-input" name="fromDate" type="date" />
    <input class="form-input" name="toDate" type="date" />
    <button class="btn btn-secondary" type="submit">Filter</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

<div class="table-wrapper">
    <table class="table">
        <thead><tr><th>Timestamp</th><th>Actor</th><th>Action</th><th>Entity</th><th>IP</th></tr></thead>
        <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td class="text-caption text-mute">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td class="text-body-sm">@log.Actor?.Username</td>
                <td><span class="badge badge-secondary">@log.Action</span></td>
                <td class="text-body-sm">@log.EntityType #@log.EntityId</td>
                <td class="text-caption text-mute text-mono">@log.IpAddress</td>
            </tr>
        }
        </tbody>
    </table>
</div>
