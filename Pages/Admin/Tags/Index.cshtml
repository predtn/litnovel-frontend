@page
@model litnovel_frontend.Pages.Admin.Tags.IndexModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Quản lý Tag"; }
@section Sidebar {
    <a href="/Admin/Dashboard" class="sidebar__link">Tổng quan</a>
    <div class="sidebar__section-label">Nội dung</div>
    <a href="/Admin/Users" class="sidebar__link">Người dùng</a>
    <a href="/Admin/Categories" class="sidebar__link">Thể loại</a>
    <a href="/Admin/Tags" class="sidebar__link active">Tag</a>
    <a href="/Admin/Badges" class="sidebar__link">Huy hiệu</a>
}
<!-- SCR-53: Tag Management -->
<div class="page-header"><h1 class="page-header__title">Quản lý Tag</h1><button class="btn btn-primary" onclick="openModal('addModal')">+ Thêm Tag</button></div>
@if (TempData["Success"] is string ok) { <div class="alert alert-success mb-md alert-auto-close">@ok</div> }
<div class="flex gap-xs mt-md" style="flex-wrap:wrap;">
    @foreach (var t in Model.Tags)
    {
        <div class="flex items-center gap-xs" style="background:var(--color-canvas-soft-2);padding:var(--space-xs) var(--space-sm);border-radius:var(--radius-full);border:1px solid var(--color-hairline);">
            <span class="text-body-sm">@t.Name</span>
            <span class="text-caption text-mute">(@t.NovelCount)</span>
            <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Xóa tag?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@t.Id" />
                <button type="submit" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;padding:0 2px;">✕</button>
            </form>
        </div>
    }
</div>
<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Thêm Tag</div><button class="modal__close" onclick="closeModal('addModal')">✕</button></div>
        <form method="post" asp-page-handler="Add">@Html.AntiForgeryToken()
            <div class="form-group"><label class="form-label">Tên tag</label><input name="name" class="form-input" placeholder="Nhập tag..." required /></div>
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Hủy</button><button type="submit" class="btn btn-primary">Thêm</button></div>
        </form>
    </div>
</div>
