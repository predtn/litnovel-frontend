@page
@model litnovel_frontend.Pages.Admin.Tags.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Tag Management";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Tag Management</h1>
        <p class="page-header__subtitle">Manage tag names and URL slugs.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openModal('addModal')">Add tag</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}
<partial name="~/Pages/Admin/_TaxonomyList.cshtml" model="Model.Items" />

@if (Model.TotalPages > 1)
{
    <div class="pagination mt-md">
        <a class="pagination__btn @(Model.Page <= 1 ? "disabled" : "")" href="?page=@Math.Max(1, Model.Page - 1)">‹</a>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a class="pagination__btn @(i == Model.Page ? "active" : "")" href="?page=@i">@i</a>
        }
        <a class="pagination__btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="?page=@Math.Min(Model.TotalPages, Model.Page + 1)">›</a>
    </div>
}

<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Add tag</div><button class="modal__close" type="button" onclick="closeModal('addModal')">x</button></div>
        <form method="post" asp-page-handler="Add" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <input class="form-input" name="name" placeholder="Name" required />
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="editModal">
    <div class="modal">
        <div class="modal__header"><div class="modal__title">Edit tag</div><button class="modal__close" type="button" onclick="closeModal('editModal')">x</button></div>
        <form method="post" asp-page-handler="Edit" class="flex-col gap-md">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="id" />
            <input class="form-input" id="editName" name="name" required />
            <div class="modal__footer"><button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEdit(id, name, slug) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            openModal('editModal');
        }
    </script>
}
