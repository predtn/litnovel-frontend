@page
@model litnovel_frontend.Pages.Admin.Staff.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Staff Management";
    ViewData["ActiveNav"] = "admin";
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Staff Management</h1>
        <p class="page-header__subtitle">Assign and revoke Staff accounts.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Khong tai duoc danh sach Staff</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}
<div class="admin-stack">
    <section class="card admin-card">
        <div class="flex justify-between items-center gap-md mb-md">
            <h2 class="text-display-sm">Current staff</h2>
            <span class="badge badge-secondary">@Model.StaffTotalElements accounts</span>
        </div>
        @if (Model.StaffUsers.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No staff accounts</div>
                <p class="empty-state__text">The API returned an empty staff list.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table table--compact">
                    <thead><tr><th>User</th><th>Status</th><th>Moderation</th><th class="col-actions">Action</th></tr></thead>
                    <tbody>
                    @foreach (var user in Model.StaffUsers)
                    {
                        <tr>
                            <td>
                                <div class="font-medium">@user.Username</div>
                                <div class="text-caption text-mute truncate">@user.Email</div>
                            </td>
                            <td><span class="status-badge status-@user.Status.ToLower()">@user.Status</span></td>
                            <td>@Model.StaffModerationCounts.GetValueOrDefault(user.Id)</td>
                            <td class="col-actions">
                                <form method="post" asp-page-handler="Revoke">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.StaffTotalPages > 1)
            {
                <div class="pagination mt-md">
                    <a class="pagination__btn @(Model.StaffPage <= 1 ? "disabled" : "")"
                       href="?staffPage=@Math.Max(1, Model.StaffPage - 1)&candidatePage=@Model.CandidatePage">‹</a>
                    @for (int i = 1; i <= Model.StaffTotalPages; i++)
                    {
                        <a class="pagination__btn @(i == Model.StaffPage ? "active" : "")"
                           href="?staffPage=@i&candidatePage=@Model.CandidatePage">@i</a>
                    }
                    <a class="pagination__btn @(Model.StaffPage >= Model.StaffTotalPages ? "disabled" : "")"
                       href="?staffPage=@Math.Min(Model.StaffTotalPages, Model.StaffPage + 1)&candidatePage=@Model.CandidatePage">›</a>
                </div>
            }
        }
    </section>

    <section class="card admin-card">
        <div class="flex justify-between items-center gap-md mb-md">
            <h2 class="text-display-sm">Promote user</h2>
            <span class="badge badge-secondary">@Model.CandidateTotalElements candidates</span>
        </div>
        @if (Model.CandidateUsers.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">No eligible users</div>
                <p class="empty-state__text">The API returned no User-role accounts to promote.</p>
            </div>
        }
        else
        {
            <div class="admin-list">
                @foreach (var user in Model.CandidateUsers)
                {
                    <form class="admin-list-row" method="post" asp-page-handler="Assign">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id" />
                        <div class="avatar-placeholder avatar-sm">@((string.IsNullOrWhiteSpace(user.Username) ? "?" : user.Username[..1]).ToUpper())</div>
                        <div class="admin-list-row__body">
                            <div class="font-medium truncate">@user.Username</div>
                            <div class="text-caption text-mute truncate">@user.Email</div>
                        </div>
                        <button class="btn btn-primary btn-sm" type="submit">Assign</button>
                    </form>
                }
            </div>
            @if (Model.CandidateTotalPages > 1)
            {
                <div class="pagination mt-md">
                    <a class="pagination__btn @(Model.CandidatePage <= 1 ? "disabled" : "")"
                       href="?staffPage=@Model.StaffPage&candidatePage=@Math.Max(1, Model.CandidatePage - 1)">‹</a>
                    @for (int i = 1; i <= Model.CandidateTotalPages; i++)
                    {
                        <a class="pagination__btn @(i == Model.CandidatePage ? "active" : "")"
                           href="?staffPage=@Model.StaffPage&candidatePage=@i">@i</a>
                    }
                    <a class="pagination__btn @(Model.CandidatePage >= Model.CandidateTotalPages ? "disabled" : "")"
                       href="?staffPage=@Model.StaffPage&candidatePage=@Math.Min(Model.CandidateTotalPages, Model.CandidatePage + 1)">›</a>
                </div>
            }
        }
    </section>
</div>
