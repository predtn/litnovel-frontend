@page
@model litnovel_frontend.Pages.Admin.DashboardModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Bảng điều khiển quản trị";
    ViewData["ActiveNav"] = "admin";
    var s = Model.Stats;
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<!-- SCR-47: Admin Dashboard -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Tổng quan hệ thống</h1>
        <p class="page-header__subtitle">Cập nhật lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">
        <div class="font-semibold mb-sm">Không tải được dữ liệu thống kê</div>
        <p class="text-body-sm text-body">@Model.LoadError</p>
    </div>
}

<!-- Main stats -->
<div class="grid-4 mb-xl">
    <div class="stat-card">
        <div class="stat-card__header">
            <div class="stat-card__label">Tổng người dùng</div>
            <span class="home-title-icon admin-dashboard-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/></svg></span>
        </div>
        <div class="stat-card__value">@FormatNum(s.Users.Total)</div>
        <div class="stat-card__change up">▲ +@s.Users.NewThisWeek tuần này</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <div class="stat-card__label">Tiểu thuyết</div>
            <span class="home-title-icon admin-dashboard-icon home-title-icon--rated" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z"/></svg></span>
        </div>
        <div class="stat-card__value">@FormatNum(s.Novels.Total)</div>
        <div class="stat-card__change up">▲ +@s.Novels.NewThisMonth tháng này</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <div class="stat-card__label">Chương đã đăng</div>
            <span class="home-title-icon admin-dashboard-icon home-title-icon--new" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span>
        </div>
        <div class="stat-card__value">@FormatNum(s.Chapters.Total)</div>
        <div class="stat-card__change up">▲ +@s.Chapters.PublishedThisWeek tuần này</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <div class="stat-card__label">Báo cáo mở</div>
            <span class="home-title-icon admin-dashboard-icon home-title-icon--hot" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10.3 3.3 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.3a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
        </div>
        <div class="stat-card__value" style="color:@(s.Reports.Open > 0 ? "var(--color-error)" : "var(--color-ink)");">@s.Reports.Open</div>
        <div class="text-caption text-mute">/ @s.Reports.Total tổng</div>
    </div>
</div>

<!-- Engagement stats -->
<div class="grid-3 mb-xl">
    <div class="card-soft">
        <div class="admin-metric-card__header">
            <span class="home-title-icon admin-dashboard-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg></span>
            <div class="text-caption text-mute">Bình luận</div>
        </div>
        <div class="text-display-sm font-semibold">@FormatNum(s.Engagement.TotalComments)</div>
    </div>
    <div class="card-soft">
        <div class="admin-metric-card__header">
            <span class="home-title-icon admin-dashboard-icon home-title-icon--rated" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg></span>
            <div class="text-caption text-mute">Đánh giá</div>
        </div>
        <div class="text-display-sm font-semibold">@FormatNum(s.Engagement.TotalRatings)</div>
    </div>
    <div class="card-soft">
        <div class="admin-metric-card__header">
            <span class="home-title-icon admin-dashboard-icon home-title-icon--hot" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg></span>
            <div class="text-caption text-mute">Yêu thích</div>
        </div>
        <div class="text-display-sm font-semibold">@FormatNum(s.Engagement.TotalFavorites)</div>
    </div>
</div>

<!-- Quick links grid -->
<div class="grid-2">
    <div class="card">
        <h3 class="text-body-sm font-semibold admin-quick-card__title"><span class="home-title-icon admin-dashboard-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg></span> Quản lý nhân viên</h3>
        <div class="flex gap-sm" style="flex-wrap:wrap;">
            <a href="/Admin/Staff" class="btn btn-secondary btn-sm">Nhân viên</a>
        </div>
    </div>
    <div class="card">
        <h3 class="text-body-sm font-semibold admin-quick-card__title"><span class="home-title-icon admin-dashboard-icon home-title-icon--rated" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z"/></svg></span> Nội dung</h3>
        <div class="flex gap-sm" style="flex-wrap:wrap;">
            <a href="/Admin/Categories" class="btn btn-secondary btn-sm">Thể loại</a>
            <a href="/Admin/Tags" class="btn btn-secondary btn-sm">Tag</a>
            <a href="/Admin/Badges" class="btn btn-secondary btn-sm">Huy hiệu</a>
        </div>
    </div>
    <div class="card">
        <h3 class="text-body-sm font-semibold admin-quick-card__title"><span class="home-title-icon admin-dashboard-icon home-title-icon--new" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span> Kiểm duyệt</h3>
        <div class="flex gap-sm" style="flex-wrap:wrap;">
            <a href="/Staff/PendingNovels" class="btn btn-secondary btn-sm" style="@(s.Novels.Pending > 0 ? "color:var(--color-warning)" : "")">Tiểu thuyết (@s.Novels.Pending)</a>
            <a href="/Staff/Reports" class="btn btn-secondary btn-sm" style="@(s.Reports.Open > 0 ? "color:var(--color-error)" : "")">Báo cáo (@s.Reports.Open)</a>
        </div>
    </div>
    <div class="card">
        <h3 class="text-body-sm font-semibold admin-quick-card__title"><span class="home-title-icon admin-dashboard-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2a2 2 0 1 1-4 0V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.4.7Z"/></svg></span> Hệ thống</h3>
        <div class="flex gap-sm" style="flex-wrap:wrap;">
            <a href="/Admin/AuditLogs" class="btn btn-secondary btn-sm">Nhật ký kiểm toán</a>
            <a href="/Admin/Announcements" class="btn btn-secondary btn-sm">Thông báo trang</a>
        </div>
    </div>
</div>

@functions { string FormatNum(int n) => n >= 1000000 ? $"{n/1000000.0:0.#}M" : n >= 1000 ? $"{n/1000.0:0.#}K" : n.ToString(); }
