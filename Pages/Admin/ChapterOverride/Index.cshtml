@page
@model litnovel_frontend.Pages.Admin.ChapterOverride.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Chapter Override";
    ViewData["ActiveNav"] = "admin";
    var novel = Model.Novel;
    var chapter = Model.Chapter;
}

@section Sidebar { <partial name="~/Pages/Admin/_AdminSidebar.cshtml" /> }

<div class="page-header">
    <div>
        <h1 class="page-header__title">Chapter Override</h1>
        <p class="page-header__subtitle">Chọn novel, chọn volume, rồi override chapter.</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="card-soft mb-xl" style="border-color:var(--color-warning);">@Model.LoadError</div>
}

<form class="admin-toolbar" method="get">
    <input class="form-input" name="q" value="@Model.Query" placeholder="Tìm novel theo tên" />
    <button class="btn btn-primary" type="submit">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <a class="btn btn-secondary" href="/Admin/ChapterOverride">Clear</a>
    }
</form>

<section class="card mb-xl">
    <div class="flex justify-between items-center gap-md mb-md" style="flex-wrap:wrap;">
        <h2 class="text-display-sm">Novel list</h2>
        <span class="badge badge-secondary">Page @Model.Page / @Model.TotalPages</span>
    </div>
    @if (Model.SearchResults.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state__title">No novels found</div>
            <p class="empty-state__text">Try a different keyword.</p>
        </div>
    }
    else
    {
        <div class="admin-list">
            @foreach (var item in Model.SearchResults)
            {
                <a class="admin-list-row @(novel?.Id == item.Id ? "active" : "")" href="/Admin/ChapterOverride?novelId=@item.Id&q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Model.Page">
                    @if (!string.IsNullOrWhiteSpace(item.CoverImage))
                    {
                        <img src="@item.CoverImage" alt="@item.Title" class="publish-cover-sm" />
                    }
                    else
                    {
                        <div class="publish-cover-sm publish-cover-empty">@(string.IsNullOrWhiteSpace(item.Title) ? "N" : item.Title[..1])</div>
                    }
                    <div class="admin-list-row__body">
                        <div class="font-medium truncate">@item.Title</div>
                        <div class="text-caption text-mute truncate">@item.Author?.Username · @item.TotalChapters chương · @item.Status</div>
                    </div>
                    <span class="btn btn-secondary btn-sm">Select</span>
                </a>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="pagination mt-md">
                <a class="pagination__btn @(Model.Page <= 1 ? "disabled" : "")" href="/Admin/ChapterOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Math.Max(1, Model.Page - 1)">‹</a>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="pagination__btn @(i == Model.Page ? "active" : "")" href="/Admin/ChapterOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@i">@i</a>
                }
                <a class="pagination__btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="/Admin/ChapterOverride?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@Math.Min(Model.TotalPages, Model.Page + 1)">›</a>
            </div>
        }
    }
</section>

@if (novel != null)
{
    <section class="card mb-xl">
        <div class="flex justify-between items-start gap-md mb-lg" style="flex-wrap:wrap;">
            <div>
                <div class="text-caption text-mute">Novel</div>
                <h2 class="text-display-sm">@novel.Title</h2>
                <p class="text-body-sm text-mute">@novel.Author?.Username · @novel.TotalChapters chương</p>
            </div>
            <a class="btn btn-secondary btn-sm" href="/Admin/NovelOverride?novelId=@novel.Id">Mở Novel Override</a>
        </div>
        @if (novel.Volumes.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">Novel chưa có chapter</div>
            </div>
        }
        else
        {
            <div class="admin-volume-list">
                @foreach (var volume in novel.Volumes.OrderBy(v => v.VolumeNumber))
                {
                    <details class="card-soft admin-volume">
                        <summary>
                            <span class="font-semibold">@volume.Title</span>
                            <span class="text-caption text-mute">@volume.Chapters.Count chương</span>
                        </summary>
                        <div class="admin-chapter-list">
                            @foreach (var item in volume.Chapters.OrderBy(c => c.ChapterNumber))
                            {
                                <a class="admin-chapter-row @(chapter?.Id == item.Id ? "active" : "")" href="/Admin/ChapterOverride?novelId=@novel.Id&chapterId=@item.Id&q=@Uri.EscapeDataString(Model.Query ?? "")">
                                    <div>
                                        <div class="font-medium truncate">Chương @item.ChapterNumber: @item.Title</div>
                                        <div class="text-caption text-mute">@item.WordCount từ · @item.UpdatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <span class="status-badge status-@item.Status.ToLowerInvariant()">@item.Status</span>
                                    <span class="btn btn-secondary btn-sm">Chọn</span>
                                </a>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>
}

@if (chapter != null)
{
    <div class="admin-detail-grid">
        <section class="card">
            <div class="text-caption text-mute mb-sm">@chapter.Novel?.Title / @chapter.Volume?.Title</div>
            <h2 class="text-display-md mb-sm">@chapter.Title</h2>
            <span class="status-badge status-@chapter.Status.ToLowerInvariant()">@chapter.Status</span>
            <div class="reader-content mt-xl">@Html.Raw(chapter.Content)</div>
        </section>
        <aside class="card">
            <h2 class="text-display-sm mb-md">Override panel</h2>
            <form method="post" asp-page-handler="Save" class="flex-col gap-md">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@chapter.Id" />
                <input type="hidden" name="novelId" value="@(novel?.Id ?? chapter.Novel?.Id)" />
                <label class="form-group"><span class="form-label">Title</span><input class="form-input" name="title" value="@chapter.Title" required /></label>
                <label class="form-group">
                    <span class="form-label">Status</span>
                    <select class="form-select" name="status">
                        @foreach (var status in new[] { "Draft", "Published", "Scheduled" })
                        {
                            <option value="@status" selected="@(chapter.Status == status)">@status</option>
                        }
                    </select>
                </label>
                <label class="form-group"><span class="form-label">Content</span><textarea class="form-textarea" name="content" style="min-height:260px;">@chapter.Content</textarea></label>
                <button class="btn btn-primary" type="submit">Save override</button>
            </form>
            <div class="divider"></div>
            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Force delete this chapter?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@chapter.Id" />
                <button class="btn btn-danger w-full" type="submit">Force delete</button>
            </form>
        </aside>
    </div>
}
else if (novel == null && string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="empty-state">
        <div class="empty-state__title">Select a novel</div>
        <p class="empty-state__text">Choose a novel from the list to view its volumes and chapters.</p>
    </div>
}
