@using Microsoft.AspNetCore.Http
@inject IAuthService AuthService
@inject IConfiguration Configuration
@{
    var sessionNotice = Context.Session.GetString("SessionNotice");
    var sessionNoticeType = Context.Session.GetString("SessionNoticeType") ?? "info";
    var toastMessages = new List<(string Message, string Type)>();
    if (!string.IsNullOrWhiteSpace(sessionNotice)) toastMessages.Add((sessionNotice, sessionNoticeType));
    if (TempData["ToastMessage"] is string tempToast && !string.IsNullOrWhiteSpace(tempToast)) toastMessages.Add((tempToast, TempData["ToastType"] as string ?? "info"));
    if (TempData["Success"] is string tempSuccess && !string.IsNullOrWhiteSpace(tempSuccess)) toastMessages.Add((tempSuccess, "success"));
    if (TempData["SuccessMessage"] is string tempSuccessMessage && !string.IsNullOrWhiteSpace(tempSuccessMessage)) toastMessages.Add((tempSuccessMessage, "success"));
    if (TempData["Error"] is string tempError && !string.IsNullOrWhiteSpace(tempError)) toastMessages.Add((tempError, "error"));
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    var isStaffArea = activeNav.StartsWith("staff", StringComparison.OrdinalIgnoreCase) ||
        Context.Request.Path.StartsWithSegments("/Staff");
    var dashboardHome = isStaffArea ? "/Staff/Dashboard" : "/Admin/Dashboard";
    var dashboardLabel = isStaffArea ? "Staff Console" : "Admin Console";
    if (!string.IsNullOrWhiteSpace(sessionNotice))
    {
        Context.Session.Remove("SessionNotice");
        Context.Session.Remove("SessionNoticeType");
    }
    var signalRToken = AuthService.GetToken(Context) ?? "";
    var publicApiBaseUrl = (Configuration["PublicApiBaseUrl"] ?? Configuration["ApiBaseUrl"] ?? "http://localhost:5181").TrimEnd('/');
    var signalRHubUrl = $"{publicApiBaseUrl}/hubs/notifications";
    var layoutAnnouncements = new List<AnnouncementDto>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - LitNovel" : "LitNovel")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(signalRToken))
    {
        <meta name="signalr-token" content="@signalRToken" />
        <meta name="signalr-hub-url" content="@signalRHubUrl" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="dashboard-shell dashboard-shell--admin">
        <aside class="sidebar admin-sidebar" id="dashSidebar">
            <div class="admin-brand">
                <a href="@dashboardHome" class="admin-brand__logo">Lit<span>Novel</span></a>
                <div class="admin-brand__label">@dashboardLabel</div>
            </div>
            @await RenderSectionAsync("Sidebar", required: false)
            <div class="admin-sidebar__footer">
                <div class="text-caption text-mute">@ViewData["UserName"]</div>
                <form method="post" action="/Auth/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm w-full">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <main class="dashboard-content admin-content">
            <section class="site-announcement-ticker site-announcement-ticker--dashboard @(layoutAnnouncements.Count == 0 ? "hidden" : "")" id="siteAnnouncementTicker" aria-live="polite" aria-label="Thông báo hệ thống">
                <div class="site-announcement-ticker__inner">
                    <span class="site-announcement-ticker__label">Tin mới</span>
                    <div class="site-announcement-ticker__viewport">
                        <div class="site-announcement-ticker__track" id="siteAnnouncementTickerTrack">
                            @foreach (var announcement in layoutAnnouncements)
                            {
                                var textContent = System.Text.RegularExpressions.Regex.Replace(announcement.Content ?? "", "<.*?>", " ").Trim();
                                <span class="site-announcement-ticker__item" data-announcement-id="@announcement.Id">@announcement.Title@(string.IsNullOrWhiteSpace(textContent) ? "" : $" - {textContent}")</span>
                            }
                        </div>
                    </div>
                </div>
            </section>
            @RenderBody()
        </main>
    </div>

    <div class="toast-container" id="toastContainer"></div>
    @foreach (var toast in toastMessages)
    {
        <div class="server-toast" data-message="@toast.Message" data-type="@toast.Type" hidden></div>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(signalRToken))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
