@using Microsoft.AspNetCore.Http
@{
    var sessionNotice = Context.Session.GetString("SessionNotice");
    var sessionNoticeType = Context.Session.GetString("SessionNoticeType") ?? "info";
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    var isStaffArea = activeNav.StartsWith("staff", StringComparison.OrdinalIgnoreCase) ||
        Context.Request.Path.StartsWithSegments("/Staff");
    var dashboardHome = isStaffArea ? "/Staff/Dashboard" : "/Admin/Dashboard";
    var dashboardLabel = isStaffArea ? "Staff Console" : "Admin Console";
    if (!string.IsNullOrWhiteSpace(sessionNotice))
    {
        Context.Session.Remove("SessionNotice");
        Context.Session.Remove("SessionNoticeType");
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - LitNovel" : "LitNovel")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="dashboard-shell dashboard-shell--admin">
        <aside class="sidebar admin-sidebar" id="dashSidebar">
            <div class="admin-brand">
                <a href="@dashboardHome" class="admin-brand__logo">Lit<span>Novel</span></a>
                <div class="admin-brand__label">@dashboardLabel</div>
            </div>
            @await RenderSectionAsync("Sidebar", required: false)
            <div class="admin-sidebar__footer">
                <div class="text-caption text-mute">@ViewData["UserName"]</div>
                <form method="post" action="/Auth/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm w-full">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <main class="dashboard-content admin-content">
            @RenderBody()
        </main>
    </div>

    <div class="toast-container" id="toastContainer"></div>
    @if (!string.IsNullOrWhiteSpace(sessionNotice))
    {
        <div id="serverToast" data-message="@sessionNotice" data-type="@sessionNoticeType" hidden></div>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
