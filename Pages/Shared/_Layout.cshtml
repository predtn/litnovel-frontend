@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IAuthService AuthService
@inject IApiService ApiService
@{
    var sessionNotice = Context.Session.GetString("SessionNotice");
    var sessionNoticeType = Context.Session.GetString("SessionNoticeType") ?? "info";
    var toastMessages = new List<(string Message, string Type)>();
    if (!string.IsNullOrWhiteSpace(sessionNotice)) toastMessages.Add((sessionNotice, sessionNoticeType));
    if (TempData["ToastMessage"] is string tempToast && !string.IsNullOrWhiteSpace(tempToast)) toastMessages.Add((tempToast, TempData["ToastType"] as string ?? "info"));
    if (TempData["Success"] is string tempSuccess && !string.IsNullOrWhiteSpace(tempSuccess)) toastMessages.Add((tempSuccess, "success"));
    if (TempData["SuccessMessage"] is string tempSuccessMessage && !string.IsNullOrWhiteSpace(tempSuccessMessage)) toastMessages.Add((tempSuccessMessage, "success"));
    if (TempData["Error"] is string tempError && !string.IsNullOrWhiteSpace(tempError)) toastMessages.Add((tempError, "error"));
    var layoutUserName = ViewData["UserName"]?.ToString() ?? Context.User.FindFirst(ClaimTypes.Name)?.Value;
    var layoutUserEmail = ViewData["UserEmail"]?.ToString() ?? Context.User.FindFirst(ClaimTypes.Email)?.Value;
    var layoutUserAvatar = ViewData["UserAvatar"]?.ToString() ?? Context.User.FindFirst("avatar")?.Value;
    var layoutUserInitial = !string.IsNullOrWhiteSpace(layoutUserName) ? layoutUserName.Trim().Substring(0, 1).ToUpper() : "U";
    if (!string.IsNullOrWhiteSpace(sessionNotice))
    {
        Context.Session.Remove("SessionNotice");
        Context.Session.Remove("SessionNoticeType");
    }
    var signalRToken = AuthService.GetToken(Context) ?? "";
    var isAdminViewer = Context.User.IsInRole("Admin");
    var layoutAnnouncements = new List<AnnouncementDto>();
    if (!isAdminViewer)
    {
        var announcementResult = await ApiService.GetAsync<List<AnnouncementDto>>("/api/announcements", signalRToken);
        layoutAnnouncements = ((announcementResult?.Success == true ? announcementResult.Data : null) ?? [])
            .Where(item => item.IsActive)
            .OrderByDescending(item => item.StartDate)
            .Take(3)
            .ToList();
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "LitNovel — Nền tảng đọc và xuất bản truyện chữ trực tuyến")" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — LitNovel" : "LitNovel")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(signalRToken))
    {
        <meta name="signalr-token" content="@signalRToken" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <!-- ── Navigation Bar ── -->
    <nav class="navbar" id="navbar">
        <div class="navbar__inner">
            <!-- Logo -->
            <a href="/" class="navbar__logo">Lit<span>Novel</span></a>

            <!-- Desktop Links -->
            <div class="navbar__links">
                <a href="/Novels" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "catalog" ? "active" : "")">Thư viện</a>
                <a href="/Novels/Search" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "search" ? "active" : "")">Tìm kiếm</a>
                <a href="/Forum" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "forum" ? "active" : "")">Diễn đàn</a>
                @if (Context.User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Publish" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "publish" ? "active" : "")">Viết truyện</a>
                }
                @if (Context.User.IsInRole("Staff") || Context.User.IsInRole("Admin"))
                {
                    <a href="/Staff/Dashboard" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "staff" ? "active" : "")">Kiểm duyệt</a>
                }
                @if (Context.User.IsInRole("Admin"))
                {
                    <a href="/Admin/Dashboard" class="navbar__link @(ViewData["ActiveNav"]?.ToString() == "admin" ? "active" : "")">Quản trị</a>
                }
            </div>

            <!-- Actions -->
            <div class="navbar__actions">
                @if (Context.User.Identity?.IsAuthenticated == true)
                {
                    <!-- Notification Bell -->
                    <a href="/Notifications" class="navbar__bell" id="notifBell" title="Thông báo" data-authenticated="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        <span class="navbar__bell-count @(ViewData["UnreadCount"] is int initialCount && initialCount > 0 ? "" : "hidden")" id="notifBellCount">
                            @if (ViewData["UnreadCount"] is int countValue && countValue > 0)
                            {
                                @(countValue > 9 ? "9+" : countValue)
                            }
                        </span>
                        @if (ViewData["UnreadCount"] is int count && count > 0)
                        {
                            <span class="sr-only">@count thông báo chưa đọc</span>
                        }
                    </a>

                    <!-- User Avatar Dropdown -->
                    <div class="dropdown" id="userDropdown">
                        <div class="navbar__avatar" onclick="toggleDropdown()">
                            @if (!string.IsNullOrWhiteSpace(layoutUserAvatar))
                            {
                                <img src="@layoutUserAvatar" alt="Avatar" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                                <div class="navbar__avatar-placeholder hidden">
                                    @layoutUserInitial
                                </div>
                            }
                            else
                            {
                                <div class="navbar__avatar-placeholder">
                                    @layoutUserInitial
                                </div>
                            }
                        </div>
                        <div class="dropdown__menu">
                            <div style="padding: var(--space-xs) var(--space-sm); margin-bottom: var(--space-xs);">
                                <div style="font-size: 14px; font-weight: 500; color: var(--color-ink);">@layoutUserName</div>
                                <div style="font-size: 12px; color: var(--color-mute);">@layoutUserEmail</div>
                            </div>
                            <div class="dropdown__divider"></div>
                            <a href="/Profile" class="dropdown__item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Hồ sơ cá nhân
                            </a>
                            <a href="/Publish" class="dropdown__item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7-7 7 7"/></svg>
                                Tiểu thuyết
                            </a>
                            <a href="/Reading/History" class="dropdown__item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                                Lịch sử đọc
                            </a>
                            <a href="/Reading/Favorites" class="dropdown__item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                Yêu thích
                            </a>
                            <div class="dropdown__divider"></div>
                            <a href="/Profile/ChangePassword" class="dropdown__item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                Đổi mật khẩu
                            </a>
                            <form method="post" action="/Auth/Logout" style="display:contents">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown__item danger">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="btn btn-nav-login">Đăng nhập</a>
                    <a href="/Auth/Register" class="btn btn-nav-signup">Đăng ký</a>
                }

                <!-- Hamburger -->
                <button class="navbar__hamburger" onclick="toggleMobileMenu()" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </nav>

    <section class="site-announcement-ticker @(layoutAnnouncements.Count == 0 ? "hidden" : "")" id="siteAnnouncementTicker" aria-live="polite" aria-label="Thông báo hệ thống">
        <div class="site-announcement-ticker__inner">
            <span class="site-announcement-ticker__label">Tin mới</span>
            <div class="site-announcement-ticker__viewport">
                <div class="site-announcement-ticker__track" id="siteAnnouncementTickerTrack">
                    @foreach (var announcement in layoutAnnouncements)
                    {
                        var textContent = System.Text.RegularExpressions.Regex.Replace(announcement.Content ?? "", "<.*?>", " ").Trim();
                        <span class="site-announcement-ticker__item" data-announcement-id="@announcement.Id">@announcement.Title@(string.IsNullOrWhiteSpace(textContent) ? "" : $" - {textContent}")</span>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="mobile-menu__close" onclick="toggleMobileMenu()">✕</button>
        <a href="/Novels" class="mobile-menu__link">Thư viện</a>
        <a href="/Novels/Search" class="mobile-menu__link">Tìm kiếm</a>
        <a href="/Forum" class="mobile-menu__link">Diễn đàn</a>
        @if (Context.User.Identity?.IsAuthenticated == true)
        {
            <a href="/Profile" class="mobile-menu__link">Hồ sơ</a>
            <a href="/Publish" class="mobile-menu__link">Tiểu thuyết của tôi</a>
            <a href="/Notifications" class="mobile-menu__link">Thông báo</a>
        }
        else
        {
            <a href="/Auth/Login" class="mobile-menu__link">Đăng nhập</a>
            <a href="/Auth/Register" class="mobile-menu__link">Đăng ký</a>
        }
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer__inner">
            <div>
                <div class="footer__brand-name">LitNovel</div>
                <div class="footer__brand-desc">Nền tảng đọc và xuất bản truyện chữ trực tuyến hàng đầu Việt Nam.</div>
            </div>
            <div>
                <div class="footer__col-title">Khám phá</div>
                <a href="/Novels" class="footer__link">Thư viện</a>
                <a href="/Novels?sort=viewCount" class="footer__link">Xếp hạng</a>
                <a href="/Novels?status=Ongoing" class="footer__link">Đang ra</a>
                <a href="/Novels?status=Ended" class="footer__link">Hoàn thành</a>
            </div>
            <div>
                <div class="footer__col-title">Tác giả</div>
                <a href="/Publish" class="footer__link">Viết truyện</a>
                <a href="/Publish/Create" class="footer__link">Tạo mới</a>
            </div>
            <div>
                <div class="footer__col-title">Hỗ trợ</div>
                <a href="/Privacy" class="footer__link">Chính sách</a>
                <a href="/Terms" class="footer__link">Điều khoản</a>
            </div>
        </div>
        <div class="footer__bottom">
            <span>© 2025 LitNovel. All rights reserved.</span>
            <div class="flex gap-md">
                <a href="/Privacy" class="footer__link" style="margin:0">Quyền riêng tư</a>
                <a href="/Terms" class="footer__link" style="margin:0">Điều khoản</a>
            </div>
        </div>
    </footer>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>
    @foreach (var toast in toastMessages)
    {
        <div class="server-toast" data-message="@toast.Message" data-type="@toast.Type" hidden></div>
    }

    <!-- JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(signalRToken))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
