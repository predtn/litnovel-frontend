@page
@model litnovel_frontend.Pages.Auth.ResetPasswordModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__logo">Lit<span style="color:var(--color-link);">Novel</span></div>
        <h1 class="auth-card__title">Đặt lại mật khẩu</h1>
        <p class="auth-card__subtitle">Tạo mật khẩu mới cho tài khoản của bạn.</p>
@if (Model.Success)
        {
            <div class="alert alert-success mb-md">Mật khẩu đã được đặt lại! <a href="/Auth/Login" style="color:inherit;font-weight:600;">Đăng nhập →</a></div>
        }
        else
        {
            <form method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Token" />
                <div class="form-group">
                    <label class="form-label">Mật khẩu mới</label>
                    <input name="password" type="password" class="form-input" placeholder="Tối thiểu 8 ký tự" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <input name="confirmPassword" type="password" class="form-input" placeholder="Nhập lại mật khẩu" required />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;height:44px;border-radius:var(--radius-sm);">Đặt lại mật khẩu</button>
            </form>
        }
        <div class="auth-card__footer"><a href="/Auth/Login">← Quay lại đăng nhập</a></div>
    </div>
</div>
