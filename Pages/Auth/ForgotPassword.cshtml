@page
@model litnovel_frontend.Pages.Auth.ForgotPasswordModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__logo">Lit<span style="color:var(--color-link);">Novel</span></div>
        <h1 class="auth-card__title">Quên mật khẩu</h1>
        <p class="auth-card__subtitle">Nhập email để nhận liên kết đặt lại mật khẩu.</p>

        @if (Model.Sent)
        {
            <div class="alert alert-success">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                Nếu email tồn tại, bạn sẽ nhận được liên kết đặt lại trong vài phút.
            </div>
            <div style="margin-top:var(--space-lg); text-align:center;">
                <a href="/Auth/Login" class="btn btn-secondary" style="width:100%;">Quay lại đăng nhập</a>
            </div>
        }
        else
        {
            <form method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <input id="email" name="email" type="email" class="form-input" placeholder="email@example.com" required />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; height:44px; border-radius:var(--radius-sm);">
                    Gửi liên kết đặt lại
                </button>
            </form>
        }

        <div class="auth-card__footer"><a href="/Auth/Login">← Quay lại đăng nhập</a></div>
    </div>
</div>
