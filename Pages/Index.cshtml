<!-- Call to action (unauthenticated) -->
@if (!User.Identity!.IsAuthenticated)
{
    <section class="home-cta">
        <div class="container">
            <h2 class="home-cta__title">
                Bắt đầu hành trình của bạn.
            </h2>
            <p class="home-cta__text">
                Đăng ký miễn phí, đọc không giới hạn và chia sẻ câu chuyện của bạn.
            </p>
            <div class="home-cta__actions">
                <a href="/Auth/Register" class="btn btn-secondary-lg">Đăng ký ngay</a>
                <a href="/Auth/Login" class="home-cta__link">Đã có tài khoản? →</a>
            </div>
        </div>
    </section>
}

@functions {
    string FormatCount(int n) => n >= 1000000 ? $"{n / 1000000.0:0.#}M" : n >= 1000 ? $"{n / 1000.0:0.#}K" : n.ToString();
    string TimeAgo(DateTime dt) {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        return dt.ToString("dd/MM/yyyy");
    }
    private static string StatusLabel(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "ongoing" => "Đang ra",
        "ended" => "Hoàn thành",
        "hiatus" => "Tạm dừng",
        "dropped" => "Đã bỏ",
        _ => string.IsNullOrWhiteSpace(status) ? "Không rõ" : status
    };
}

@section Scripts {
<script>
function toggleFavorite(event, novelId) {
    event.preventDefault();
    event.stopPropagation();
    
    const btns = document.querySelectorAll(`.novel-item-card[data-novel-id="${novelId}"] .novel-card__fav-btn`);
    const isActive = btns[0]?.classList.contains('active');
    const method = isActive ? 'DELETE' : 'POST';
    const url = `/api/novels/${novelId}/favorites`;

    fetch(url, {
        method: method,
        headers: {
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        }
    })
    .then(async response => {
        if (response.status === 401) {
            showToast("Vui lòng đăng nhập để thực hiện tính năng này.", "error");
            return;
        }
        
        const result = await response.json();
        if (response.ok && result.success) {
            if (isActive) {
                btns.forEach(btn => btn.classList.remove('active'));
                showToast("Đã xóa khỏi danh sách yêu thích.", "success");
            } else {
                btns.forEach(btn => {
                    btn.classList.add('active');
                    btn.style.transform = 'scale(1.25)';
                    setTimeout(() => btn.style.transform = '', 300);
                });
                showToast("Đã thêm vào danh sách yêu thích.", "success");
            }
        } else {
            showToast(result.message || "Đã xảy ra lỗi, vui lòng thử lại.", "error");
        }
    })
    .catch(error => {
        console.error(error);
        showToast("Không thể kết nối tới máy chủ.", "error");
    });
}
</script>
}

