@page
@model IndexModel
@{
    ViewData["Title"] = "Đọc truyện, Khám phá thế giới mới";
    ViewData["Description"] = "LitNovel — Nền tảng đọc và xuất bản truyện chữ trực tuyến hàng đầu Việt Nam.";
}

<!-- SCR-01: Landing Page -->

<section class="home-announcements @(Model.Announcements.Count == 0 ? "hidden" : "")" aria-label="Announcements" id="homeAnnouncements">
    <div class="container">
        <div class="home-announcements__list" id="homeAnnouncementsList">
            @foreach (var announcement in Model.Announcements)
            {
                <article class="home-announcement" data-announcement-id="@announcement.Id">
                    <div class="home-announcement__icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11v2a2 2 0 0 0 2 2h2l4 4V5L7 9H5a2 2 0 0 0-2 2Z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19 6a9 9 0 0 1 0 12"/></svg>
                    </div>
                    <div class="home-announcement__body">
                        <h2 class="home-announcement__title">@announcement.Title</h2>
                        <div class="home-announcement__content">@Html.Raw(announcement.Content)</div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Hero Section -->
<section class="hero">
    <div class="hero__gradient"></div>
    <div class="container hero__inner">
        <div class="hero__badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Nền tảng truyện chữ hàng đầu
        </div>
        <h1 class="hero__title">Đọc truyện hay,<br>Khám phá thế giới mới.</h1>
        <p class="hero__subtitle">Hàng nghìn tiểu thuyết từ các tác giả tài năng. Đọc miễn phí, mọi lúc, mọi nơi.</p>
        <div class="hero__cta">
            <a href="/Novels" class="btn btn-primary-lg">Khám phá ngay</a>
            <a href="/Auth/Register" class="btn btn-secondary-lg">Bắt đầu viết</a>
        </div>
    </div>
</section>

<!-- Category Strip -->
<section class="home-category-strip">
    <div class="container">
        <div class="home-category-strip__scroller">
            <a href="/Novels" class="tab-pill active">Tất cả</a>
            @foreach (var cat in Model.Categories)
            {
                <a href="/Novels?categoryId=@cat.Id" class="tab-pill">@cat.Name</a>
            }
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated == true && Model.ContinueReading.Count > 0)
{
    <!-- Continue Reading -->
    <section class="section home-continue-section">
        <div class="container">
            <div class="home-section-header mb-xl">
                <div>
                    <h2 class="section-title">Tiếp tục đọc</h2>
                    <p class="section-subtitle">Quay lại những truyện bạn đang đọc dở</p>
                </div>
                <a href="/Reading/History" class="btn btn-ghost">Lịch sử đọc →</a>
            </div>
            <div class="home-continue-grid">
                @foreach (var item in Model.ContinueReading)
                {
                    var novel = item.Novel;
                    var chapter = item.LastChapter;
                    var novelUrl = !string.IsNullOrWhiteSpace(novel?.Slug) ? novel.Slug : novel?.Id.ToString();
                    var chapterUrl = !string.IsNullOrWhiteSpace(chapter?.Slug) ? chapter.Slug : chapter?.Id.ToString();
                    <a href="@(chapter != null ? $"/Novels/{novelUrl}/{chapterUrl}/read" : $"/Novels/{novelUrl}")" class="home-continue-card">
                        @if (!string.IsNullOrEmpty(novel?.CoverImage))
                        {
                            <img src="@novel.CoverImage" alt="@novel.Title" class="home-continue-card__cover" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                            <div class="home-continue-card__cover home-continue-card__cover--placeholder hidden">Sách</div>
                        }
                        else
                        {
                            <div class="home-continue-card__cover home-continue-card__cover--placeholder">Sách</div>
                        }
                        <div class="home-continue-card__body">
                            <div class="text-body-sm font-medium text-ink truncate">@(novel?.Title ?? "Truyện đang đọc")</div>
                            <div class="text-caption text-mute mt-sm">@(chapter?.Title ?? "Chưa có chương gần nhất")</div>
                            <div class="home-progress mt-sm">
                                <div class="home-progress__bar" style="width:@item.ProgressPercentage%;"></div>
                            </div>
                            <div class="text-caption text-mute mt-sm">@item.ProgressPercentage% · @TimeAgo(item.LastReadAt)</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Trending Novels -->
<section class="section">
    <div class="container">
        <div class="home-section-header mb-xl">
            <div>
                <h2 class="section-title">🔥 Đang hot</h2>
                <p class="section-subtitle">Những tiểu thuyết được đọc nhiều nhất</p>
            </div>
            <a href="/Novels?sort=viewCount&order=desc" class="btn btn-ghost">Xem tất cả →</a>
        </div>
        <div class="home-novel-grid">
            @foreach (var novel in Model.TrendingNovels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                <a href="/Novels/@novelUrl" class="novel-card">
                    @if (!string.IsNullOrEmpty(novel.CoverImage))
                    {
                        <img class="novel-card__cover" src="@novel.CoverImage" alt="@novel.Title" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                        <div class="novel-card__cover-placeholder hidden">📖</div>
                    }
                    else
                    {
                        <div class="novel-card__cover-placeholder">📖</div>
                    }
                    <div class="novel-card__body">
                        <div class="novel-card__title">@novel.Title</div>
                        <div class="novel-card__author">@novel.Author?.Username</div>
                        <div class="novel-card__meta">
                            <span>⭐ @novel.RatingAverage.ToString("0.0")</span>
                            <span>👁 @FormatCount(novel.ViewCount)</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- New Updates -->
<section class="section home-update-section">
    <div class="container">
        <div class="home-section-header mb-xl">
            <div>
                <h2 class="section-title">🆕 Mới cập nhật</h2>
                <p class="section-subtitle">Chapter mới nhất từ các truyện đang ra</p>
            </div>
            <a href="/Novels?sort=updatedAt&order=desc&status=Ongoing" class="btn btn-ghost">Xem tất cả →</a>
        </div>
        <div class="home-update-grid">
            @foreach (var novel in Model.NewNovels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                <a href="/Novels/@novelUrl" class="home-update-card">
                    @if (!string.IsNullOrEmpty(novel.CoverImage))
                    {
                        <img src="@novel.CoverImage" alt="@novel.Title" class="home-update-card__cover" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                        <div class="home-update-card__cover home-update-card__cover--placeholder hidden">Sách</div>
                    }
                    else
                    {
                        <div class="home-update-card__cover home-update-card__cover--placeholder">Sách</div>
                    }
                    <div class="home-update-card__body">
                        <div class="text-body-sm font-medium text-ink truncate">@novel.Title</div>
                        <div class="text-caption text-mute mt-sm">@novel.Author?.Username</div>
                        <div class="home-update-card__badges mt-sm">
                            <span class="status-badge status-@novel.Status.ToLower()">@novel.Status</span>
                            @if (novel.Category != null)
                            {
                                <span class="badge badge-secondary">@novel.Category.Name</span>
                            }
                        </div>
                        <div class="text-caption text-mute mt-sm">
                            Ch.@novel.TotalChapters · Cập nhật @TimeAgo(novel.UpdatedAt)
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- Top Rated -->
<section class="section">
    <div class="container">
        <div class="home-section-header mb-xl">
            <div>
                <h2 class="section-title">⭐ Được đánh giá cao</h2>
                <p class="section-subtitle">Tiểu thuyết được yêu thích nhất</p>
            </div>
            <a href="/Novels?sort=ratingAverage&order=desc" class="btn btn-ghost">Xem tất cả →</a>
        </div>
        <div class="home-novel-grid">
            @foreach (var novel in Model.TopRatedNovels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                <a href="/Novels/@novelUrl" class="novel-card">
                    @if (!string.IsNullOrEmpty(novel.CoverImage))
                    {
                        <img class="novel-card__cover" src="@novel.CoverImage" alt="@novel.Title" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                        <div class="novel-card__cover-placeholder hidden">📖</div>
                    }
                    else
                    {
                        <div class="novel-card__cover-placeholder">📖</div>
                    }
                    <div class="novel-card__body">
                        <div class="novel-card__title">@novel.Title</div>
                        <div class="novel-card__meta">
                            <span style="color:#f59e0b; font-weight:500;">★ @novel.RatingAverage.ToString("0.0")</span>
                            <span>(@novel.RatingCount)</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- Call to action (unauthenticated) -->
@if (!User.Identity!.IsAuthenticated)
{
    <section class="home-cta">
        <div class="container">
            <h2 class="home-cta__title">
                Bắt đầu hành trình của bạn.
            </h2>
            <p class="home-cta__text">
                Đăng ký miễn phí, đọc không giới hạn và chia sẻ câu chuyện của bạn.
            </p>
            <div class="home-cta__actions">
                <a href="/Auth/Register" class="btn btn-secondary-lg">Đăng ký ngay</a>
                <a href="/Auth/Login" class="home-cta__link">Đã có tài khoản? →</a>
            </div>
        </div>
    </section>
}

@functions {
    string FormatCount(int n) => n >= 1000000 ? $"{n / 1000000.0:0.#}M" : n >= 1000 ? $"{n / 1000.0:0.#}K" : n.ToString();
    string TimeAgo(DateTime dt) {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        return dt.ToString("dd/MM/yyyy");
    }
}
