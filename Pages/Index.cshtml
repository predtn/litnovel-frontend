@page
@model IndexModel
@{
    ViewData["Title"] = "Đọc truyện, Khám phá thế giới mới";
    ViewData["Description"] = "LitNovel — Nơi thỏa sức sáng tạo viết lên câu truyện của chính mình.";
    var writeUrl = User.Identity?.IsAuthenticated == true ? Url.Page("/Publish/Index") : Url.Page("/Auth/Register");

    // Prepare random/dynamic marquee content belonging to the project
    var marqueeItems = new List<string>();
    if (Model.TrendingNovels != null && Model.TrendingNovels.Any())
    {
        foreach (var novel in Model.TrendingNovels.Take(5))
        {
            marqueeItems.Add($"     HOT: {novel.Title} - {novel.Author?.Username} ({novel.RatingAverage.ToString("0.0")})");
        }
    }
    if (Model.NewNovels != null && Model.NewNovels.Any())
    {
        foreach (var novel in Model.NewNovels.Take(5))
        {
            marqueeItems.Add($"     MỚI: {novel.Title} - Ch. {novel.TotalChapters}");
        }
    }
    marqueeItems.Add("     Chào mừng bạn đến với LitNovel - Welcome!");
    marqueeItems.Add("     Bạn có ý tưởng truyện độc đáo? Hãy nhấn 'Bắt đầu viết' để chia sẻ tác phẩm của mình ngay hôm nay!");
    marqueeItems.Add("     Đăng ký tài khoản miễn phí để lưu lịch sử đọc truyện và nhận thông báo khi có chương mới!");
    marqueeItems.Add("     Tham gia Diễn đàn thảo luận cùng hàng nghìn độc giả và tác giả khác!");
    marqueeItems.Add("     Đọc truyện hay, khám phá những thế giới kỳ bí đầy màu sắc.");

    var random = new Random();
    var shuffledMarquee = marqueeItems.OrderBy(x => random.Next()).ToList();
    var marqueeText = string.Join("   ✦   ", shuffledMarquee);
}

<!-- Marquee Line -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <div class="marquee-content">
            @marqueeText   ✦   @marqueeText
        </div>
    </div>
</div>

<!-- SCR-01: Landing Page -->

<!-- Hero Section -->
<section class="hero">
    <div class="hero__gradient"></div>
    <div class="container hero__inner">
        <div class="hero__badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Nền tảng truyện chữ hàng đầu
        </div>
        <h1 class="hero__title">Tự tay sáng tạo,<br>Hãy viết lên câu truyện của chính mình.</h1>
        <p class="hero__subtitle">Hàng nghìn tiểu thuyết từ các tác giả tự do tài năng. Đọc miễn phí, mọi lúc, mọi nơi.</p>
        <div class="hero__cta">
            <a href="/Novels" class="btn btn-primary-lg">Khám phá ngay</a>
            <a href="@writeUrl" class="btn btn-secondary-lg">Bắt đầu viết</a>
        </div>
    </div>
</section>

<!-- Category Strip -->
<section class="home-category-strip">
    <div class="container">
        <div class="home-category-strip__scroller">
            <a href="/Novels" class="tab-pill active">Tất cả</a>
            @foreach (var cat in Model.Categories)
            {
                <a href="/Novels?categoryId=@cat.Id" class="tab-pill">@cat.Name</a>
            }
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated == true && Model.ContinueReading.Count > 0)
{
    <!-- Continue Reading -->
    <section class="section home-continue-section">
        <div class="container">
            <div class="home-section-header mb-xl">
                <div>
                    <h2 class="section-title">Tiếp tục đọc</h2>
                    <p class="section-subtitle">Quay lại những truyện bạn đang đọc dở</p>
                </div>
                <a href="/Reading/History" class="btn btn-ghost">Lịch sử đọc →</a>
            </div>
            <div class="home-continue-grid">
                @foreach (var item in Model.ContinueReading)
                {
                    var novel = item.Novel;
                    var chapter = item.LastChapter;
                    var novelUrl = !string.IsNullOrWhiteSpace(novel?.Slug) ? novel.Slug : novel?.Id.ToString();
                    var chapterUrl = !string.IsNullOrWhiteSpace(chapter?.Slug) ? chapter.Slug : chapter?.Id.ToString();
                    <a href="@(chapter != null ? $"/Novels/{novelUrl}/{chapterUrl}/read" : $"/Novels/{novelUrl}")" class="home-continue-card">
                        @if (!string.IsNullOrEmpty(novel?.CoverImage))
                        {
                            <img src="@novel.CoverImage" alt="@novel.Title" class="home-continue-card__cover" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                            <div class="home-continue-card__cover home-continue-card__cover--placeholder hidden">Sách</div>
                        }
                        else
                        {
                            <div class="home-continue-card__cover home-continue-card__cover--placeholder">Sách</div>
                        }
                        <div class="home-continue-card__body">
                            <div class="text-body-sm font-medium text-ink truncate">@(novel?.Title ?? "Truyện đang đọc")</div>
                            <div class="text-caption text-mute mt-sm">@(chapter?.Title ?? "Chưa có chương gần nhất")</div>
                            <div class="home-progress mt-sm">
                                <div class="home-progress__bar" style="width:@item.ProgressPercentage%;"></div>
                            </div>
                            <div class="text-caption text-mute mt-sm">@item.ProgressPercentage% · @TimeAgo(item.LastReadAt)</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Trending Novels -->
<section class="section">
    <div class="container">
        <div class="home-section-header mb-xl">
            <div>
                <h2 class="section-title">
                    <span class="home-title-icon home-title-icon--hot" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3s5 4.5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-4.4 3.4-6.4.8 2.2 2.4 3.2 4.1 3.7C14.4 7.8 13.4 5.5 12 3Z"/></svg>
                    </span>
                    Đang hot
                </h2>
                <p class="section-subtitle">Những tiểu thuyết được đọc nhiều nhất</p>
            </div>
            <a href="/Novels?sort=viewCount&order=desc" class="btn btn-ghost">Xem tất cả →</a>
        </div>
        <div class="home-novel-grid">
            @foreach (var novel in Model?.TrendingNovels ?? new List<NovelSummaryDto>())
            {
                var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                var latestChapterUrl = !string.IsNullOrWhiteSpace(novel.LatestChapterSlug) ? novel.LatestChapterSlug : null;
                var hasLatestChapter = !string.IsNullOrWhiteSpace(latestChapterUrl);
                var description = !string.IsNullOrWhiteSpace(novel.Description) ? novel.Description : "Truyện hiện chưa có mô tả.";
                <article class="novel-card home-spotlight-card">
                    <div class="home-spotlight-card__media">
                        @if (!string.IsNullOrEmpty(novel.CoverImage))
                        {
                            <img class="novel-card__cover" src="@novel.CoverImage" alt="@novel.Title" loading="lazy" onerror="this.classList.add('hidden'); if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                            <div class="novel-card__cover-placeholder hidden"><span class="cover-placeholder-icon" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <div class="novel-card__cover-placeholder"><span class="cover-placeholder-icon" aria-hidden="true"></span></div>
                        }
                    </div>
                    <div class="novel-card__body">
                        <a href="/Novels/@novelUrl" class="novel-card__title home-spotlight-card__title">@novel.Title</a>
                    </div>
                    <div class="home-spotlight-card__overlay">
                        <p class="home-spotlight-card__description">@description</p>
                        <div class="home-spotlight-card__actions">
                            @if (hasLatestChapter)
                            {
                                <a href="/Novels/@novelUrl/@latestChapterUrl/read" class="home-spotlight-card__read">Đọc ngay</a>
                            }
                            else
                            {
                                <span class="home-spotlight-card__read home-spotlight-card__read--disabled" aria-disabled="true">Đọc ngay</span>
                            }
                            <a href="/Novels/@novelUrl" class="home-spotlight-card__detail" aria-label="Xem chi tiết @novel.Title">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- New Updates -->
<section class="section home-update-section">
    <div class="container">
        <div class="home-section-header mb-xl">
            <div>
                <h2 class="section-title">
                    <span class="home-title-icon home-title-icon--new" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 5v7l4 2"/><path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v5h-5"/></svg>
                    </span>
                    Mới cập nhật
                </h2>
                <p class="section-subtitle">Chapter mới nhất từ các truyện đang ra</p>
            </div>
            <a href="/Novels?sort=updatedAt&order=desc" class="btn btn-ghost">Xem tất cả →</a>
        </div>
        <div class="home-latest-grid">
            @foreach (var novel in Model?.NewNovels ?? new List<NovelSummaryDto>())
            {
                var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                var chapterUrl = !string.IsNullOrWhiteSpace(novel.LatestChapterSlug) ? novel.LatestChapterSlug : null;
                var latestChapterNumber = novel.LatestChapterNumber ?? novel.TotalChapters;
                var latestChapterTitle = !string.IsNullOrWhiteSpace(novel.LatestChapterTitle) ? novel.LatestChapterTitle : "Chuong moi nhat";
                <article class="novel-item-card home-latest-card" data-novel-id="@novel.Id">
                    <a href="/Novels/@novelUrl" class="novel-card__cover-wrapper home-latest-card__cover-link" aria-label="@novel.Title">
                        @if (!string.IsNullOrWhiteSpace(novel.CoverImage))
                        {
                            <img class="novel-card__cover home-latest-card__cover" src="@novel.CoverImage" alt="@novel.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="novel-card__cover-placeholder home-latest-card__cover"><span class="cover-placeholder-icon" aria-hidden="true"></span></div>
                        }
                    </a>
                    <div class="home-latest-card__main">
                        <a href="/Novels/@novelUrl" class="home-latest-card__title">@novel.Title</a>
                        <div class="home-latest-card__line">
                            @if (novel.Category != null)
                            {
                                <span class="novel-card__category">@novel.Category.Name</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(chapterUrl))
                            {
                                <a href="/Novels/@novelUrl/@chapterUrl/read" class="home-latest-card__chapter-text">Ch. @latestChapterNumber - @latestChapterTitle</a>
                            }
                            else
                            {
                                <span class="home-latest-card__chapter-text">Ch. @latestChapterNumber - @latestChapterTitle</span>
                            }
                        </div>
                    </div>
                    <div class="home-latest-card__meta">
                        <div class="home-latest-card__author">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span>@(novel.Author?.Username ?? "Unknown")</span>
                        </div>
                        <time class="home-latest-card__time" datetime="@novel.UpdatedAt.ToString("O")">@TimeAgo(novel.UpdatedAt)</time>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
<!-- Top Rated -->
