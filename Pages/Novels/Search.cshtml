@page
@model litnovel_frontend.Pages.Novels.SearchModel
@{ ViewData["Title"] = "Tìm kiếm — " + Model.Keyword; ViewData["ActiveNav"] = "search"; }
<!-- SCR-11: Search Results -->
<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);">
    <!-- Search bar -->
    <div style="max-width:600px;margin:0 auto var(--space-2xl);">
        <form method="get">
            <div class="search-bar" style="--input-h:48px;">
                <svg class="search-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm tên truyện, tác giả..." style="height:48px;font-size:16px;" autofocus />
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.Keyword))
    {
        <div class="page-header">
            <div>
                <h1 class="page-header__title">Kết quả cho "@Model.Keyword"</h1>
                <p class="page-header__subtitle">@Model.TotalElements kết quả</p>
            </div>
        </div>
        @if (!Model.Results.Any())
        {
            <div class="empty-state">
                <div class="empty-state__icon">🔍</div>
                <div class="empty-state__title">Không tìm thấy kết quả</div>
                <div class="empty-state__desc">Thử từ khóa khác hoặc dùng bộ lọc thể loại.</div>
                <a href="/Novels" class="btn btn-primary mt-md">Duyệt thư viện</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:var(--space-sm);">
                @foreach (var n in Model.Results)
                {
                    var novelUrl = !string.IsNullOrWhiteSpace(n.Slug) ? n.Slug : n.Id.ToString();
                    <a href="/Novels/@novelUrl" style="display:flex;gap:var(--space-md);padding:var(--space-md);border-radius:var(--radius-md);border:1px solid var(--color-hairline);background:var(--color-canvas);text-decoration:none;transition:box-shadow .15s;" onmouseenter="this.style.boxShadow='var(--shadow-3)'" onmouseleave="this.style.boxShadow=''">
                        <div style="width:56px;height:76px;background:var(--color-canvas-soft-2);border-radius:var(--radius-xs);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">📖</div>
                        <div style="flex:1;min-width:0;">
                            <div class="text-body-sm font-medium text-ink mb-xs">@n.Title</div>
                            <div class="text-caption text-mute mb-xs">@n.Author?.Username · @n.TotalChapters chương</div>
                            <div class="flex gap-xs" style="flex-wrap:wrap;">
                                <span class="status-badge status-@n.Status.ToLower()">@DisplayText.Status(n.Status)</span>
                                @if (n.Category != null) { <span class="badge badge-secondary">@n.Category.Name</span> }
                                @foreach (var t in n.Tags.Take(3)) { <span class="tag">@t.Name</span> }
                            </div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;">
                            <div class="text-body-sm" style="color:#f59e0b;">★ @n.RatingAverage.ToString("0.0")</div>
                            <div class="text-caption text-mute">@FormatNum(n.ViewCount) views</div>
                        </div>
                    </a>
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center mt-xl">
                    <div class="pagination">
                        @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                        { <a href="?keyword=@Model.Keyword&page=@i" class="pagination__btn @(i == Model.Page ? "active" : "")">@i</a> }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="text-center text-body-sm text-mute">Nhập từ khóa để tìm kiếm truyện...</div>
    }
</div>
@functions { string FormatNum(int n) => n >= 1000 ? $"{n/1000.0:0.#}K" : n.ToString(); }
