@page "/Novels/{slug}"
@model litnovel_frontend.Pages.Novels.DetailModel
@{
    ViewData["Title"] = Model.Novel?.Title ?? "Chi tiết truyện";
    var novel = Model.Novel;
}

@if (novel == null)
{
    <div class="container" style="padding-top:80px;">
        <div class="empty-state">
            <div class="empty-state__icon">Không tìm thấy</div>
            <div class="empty-state__title">Không tìm thấy truyện</div>
            <a href="/Novels" class="btn btn-primary mt-md">Quay lại thư viện</a>
        </div>
    </div>
    return;
}

<div class="container novel-detail">
    <div class="breadcrumb">
        <a href="/">Trang chủ</a><span class="breadcrumb__sep">/</span>
        <a href="/Novels">Thư viện</a><span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">@novel.Title</span>
    </div>

    <div class="novel-detail__hero">
        <div class="novel-detail__aside">
            @if (!string.IsNullOrWhiteSpace(novel.CoverImage))
            {
                <img src="@novel.CoverImage" alt="@novel.Title" class="novel-detail__cover" />
            }
            else
            {
                <div class="novel-detail__cover-empty">Không có bìa</div>
            }

            <div class="novel-detail__actions">
                @{
                    var firstChapter = novel.Volumes.SelectMany(v => v.Chapters).FirstOrDefault();
                    var continueChapter = Model.CurrentReadingProgress?.LastChapter;
                    var targetChapter = continueChapter ?? firstChapter;
                    var novelUrl = !string.IsNullOrWhiteSpace(novel.Slug) ? novel.Slug : novel.Id.ToString();
                }
                @if (targetChapter != null)
                {
                    var targetChapterUrl = !string.IsNullOrWhiteSpace(targetChapter.Slug) ? targetChapter.Slug : targetChapter.Id.ToString();
                    var readActionText = continueChapter != null ? "Đọc tiếp" : "Đọc ngay";
                    <a href="/Novels/@novelUrl/@targetChapterUrl/read" class="btn btn-primary novel-detail__action">@readActionText</a>
                }
                else
                {
                    <span class="btn btn-primary novel-detail__action" style="opacity:.5; cursor:default;">Chưa có chương</span>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button id="likeBtn"
                            data-liked="@novel.IsLiked?.ToString().ToLower()"
                            onclick="toggleNovelLike(@novel.Id, this)"
                            class="btn btn-secondary novel-detail__action">
                        <span class="like-text">@(novel.IsLiked == true ? "Bỏ thích" : "Thích")</span>
                    </button>

                    <button id="favBtn"
                            data-favorited="@novel.IsFavorited?.ToString().ToLower()"
                            onclick="toggleFavorite(@novel.Id, this)"
                            class="btn btn-secondary novel-detail__action">
                        <span class="fav-text">@(novel.IsFavorited == true ? "Bỏ yêu thích" : "Yêu thích")</span>
                    </button>

                    @if (Model.CurrentUserId != novel.Author?.Id)
                    {
                        <button type="button"
                                onclick="openModal('reportModal')"
                                class="btn btn-secondary novel-detail__action" style="color: var(--color-danger); border-color: var(--color-hairline);">
                            <span>Báo cáo</span>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="novel-detail__main">
            <div class="flex gap-sm items-center" style="flex-wrap:wrap; margin-bottom:var(--space-sm);">
                <span class="status-badge status-@novel.Status.ToLower()">@StatusLabel(novel.Status)</span>
                @if (novel.Category != null)
                {
                    <a href="/Novels?categoryId=@novel.Category.Id" class="badge badge-secondary">@novel.Category.Name</a>
                }
                @foreach (var tag in novel.Tags)
                {
                    <a href="/Novels?tagId=@tag.Id" class="tag">@tag.Name</a>
                }
            </div>

            <h1 style="font-size:var(--text-display-md); font-weight:600; letter-spacing:var(--ls-display-md); color:var(--color-ink); margin-bottom:var(--space-xs);">@novel.Title</h1>

            @if (IsPendingDeletion(novel.Status))
            {
                <div class="alert alert-info mb-md">
                    Tác giả đã lên lịch xóa truyện này@(novel.ScheduledHardDeleteAt.HasValue ? $", nội dung sẽ được dọn vào {FormatDateTime(novel.ScheduledHardDeleteAt.Value)}" : "").
                </div>
            }

            <div class="novel-detail__meta">
                <a href="/Profile/@novel.Author?.Id" class="novel-detail__author">
                    @if (!string.IsNullOrWhiteSpace(novel.Author?.Avatar))
                    {
                        <img src="@novel.Author.Avatar" alt="@novel.Author.Username" class="avatar avatar-sm" />
                    }
                    else
                    {
                        <div class="avatar-placeholder avatar-sm">@(novel.Author?.Username?.Substring(0, 1).ToUpper() ?? "A")</div>
                    }
                    <span class="text-body-sm font-medium">@novel.Author?.Username</span>
                </a>
                <span class="text-body-sm text-mute">@novel.TotalChapters chương</span>
                <span class="text-body-sm text-mute">@novel.TotalVolumes tập</span>
            </div>

            <div class="novel-detail__stats">
                <div class="novel-detail__stat">
                    <div id="novelViewCount" class="novel-detail__stat-value" data-count="@novel.ViewCount">@FormatNum(novel.ViewCount)</div>
                    <div class="text-caption text-mute">Lượt xem</div>
                </div>
                <div class="novel-detail__stat">
                    <div id="novelLikeCount" class="novel-detail__stat-value" data-count="@novel.LikeCount">@FormatNum(novel.LikeCount)</div>
                    <div class="text-caption text-mute">Lượt thích</div>
                </div>
                <div class="novel-detail__stat">
                    <div class="novel-detail__stat-value novel-detail__stat-value--rating">@(novel.RatingAverage > 0 ? novel.RatingAverage.ToString("0.0") : "0.0") ★</div>
                    <div class="text-caption text-mute">@(novel.RatingCount > 0 ? $"{novel.RatingCount} đánh giá" : "0 đánh giá")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(novel.Description))
            {
                var shouldCollapseDescription = novel.Description.Length > 360;
                <div class="novel-detail__description-wrap @(shouldCollapseDescription ? "is-collapsed" : "")" id="novelDescriptionWrap">
                    <div class="novel-detail__description" id="novelDescription">
                        @Html.Raw(novel.Description)
                    </div>
                    @if (shouldCollapseDescription)
                    {
                        <button type="button" class="novel-detail__description-toggle" onclick="toggleNovelDescription(this)">
                            Xem thêm
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="tabs mt-xl">
        <button class="tab active" data-tab="chapters" onclick="switchTab('chapters')">Danh sách chương</button>
        <button class="tab" data-tab="reviews" onclick="switchTab('reviews')">Đánh giá (@novel.RatingCount)</button>
    </div>

    <div id="tab-chapters">
        @foreach (var vol in novel.Volumes)
        {
            <div class="novel-detail__volume">
                <div class="novel-detail__volume-title">@vol.Title</div>
                <div class="novel-detail__chapter-list">
                    @foreach (var ch in vol.Chapters)
                    {
                        var chapterUrl = !string.IsNullOrWhiteSpace(ch.Slug) ? ch.Slug : ch.Id.ToString();
                        <a href="/Novels/@novelUrl/@chapterUrl/read" class="novel-detail__chapter @(ch.IsRead ? "novel-detail__chapter--read" : "")">
                            <span class="novel-detail__chapter-number">Ch.@ch.ChapterNumber</span>
                            <span class="truncate">@ch.Title</span>
                            @if (string.Equals(ch.Status, "Published", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="novel-detail__chapter-date">@DisplayDateTime.Format(ch.CreatedAt, "dd/MM")</span>
                            }
                            else
                            {
                                <span class="status-badge status-@ch.Status.ToLower()" style="justify-self:end;">@StatusLabel(ch.Status)</span>
                            }
                        </a>
                    }
                </div>
            </div>
        }
        @if (!novel.Volumes.Any())
        {
            <div class="empty-state">
                <div class="empty-state__icon">Trống</div>
                <div class="empty-state__title">Chưa có chương nào</div>
            </div>
        }
    </div>

    <div id="tab-reviews" class="hidden novel-detail__reviews">
        <section class="novel-detail__rating-summary">
            <div class="novel-detail__rating-score">@(novel.RatingAverage > 0 ? novel.RatingAverage.ToString("0.0") : "0.0")</div>
            <div>
                <div class="novel-detail__stars" aria-label="@(novel.RatingAverage > 0 ? novel.RatingAverage.ToString("0.0") : "0.0") trên 5">★★★★★</div>
                <div class="text-caption text-mute">@(novel.RatingCount > 0 ? $"{novel.RatingCount} đánh giá" : "Chưa có đánh giá")</div>
            </div>
        </section>

        @if (User.Identity?.IsAuthenticated == true && Model.CurrentUserId != novel.Author?.Id)
        {
            <section class="novel-detail__review-form">
                @if (novel.UserReviewId.HasValue)
                {
                    <h3 class="novel-detail__review-title">Chỉnh sửa đánh giá của bạn</h3>
                    <form method="post" asp-page-handler="UpdateReview" class="novel-detail__review-form-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reviewId" value="@novel.UserReviewId" />
                        <div class="star-rating js-star-rating" data-input="editRatingInput" data-value="@(novel.UserRating ?? 0)">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <span class="star" data-val="@s">★</span>
                            }
                        </div>
                        <input type="hidden" id="editRatingInput" name="rating" value="@(novel.UserRating ?? 0)" />
                        <div class="form-group">
                            <textarea class="form-textarea" name="reviewText" placeholder="Chia sẻ cảm nhận của bạn..." rows="3">@novel.UserReview</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary novel-detail__review-submit">Lưu đánh giá</button>
                    </form>
                }
                else
                {
                    <h3 class="novel-detail__review-title">Viết đánh giá của bạn</h3>
                    <form method="post" asp-page-handler="Review" class="novel-detail__review-form-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@novel.Id" />
                        <div class="star-rating js-star-rating" id="starRating" data-input="ratingInput" data-value="0">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <span class="star" data-val="@s">★</span>
                            }
                        </div>
                        <input type="hidden" id="ratingInput" name="rating" value="0" />
                        <div class="form-group">
                            <textarea class="form-textarea" name="reviewText" placeholder="Chia sẻ cảm nhận của bạn..." rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary novel-detail__review-submit">Gửi đánh giá</button>
                    </form>
                }
            </section>
        }

        <div class="novel-detail__review-list">
            @foreach (var review in Model.Reviews)
            {
                <div class="review-card">
                    <div class="review-card__header">
                        @if (!string.IsNullOrWhiteSpace(review.User?.Avatar))
                        {
                            <img src="@review.User.Avatar" alt="@(review.User?.Username ?? "User")" class="avatar avatar-sm" />
                        }
                        else
                        {
                            <div class="avatar-placeholder avatar-sm">@(review.User?.Username?.Substring(0, 1).ToUpper() ?? "U")</div>
                        }
                        <div>
                            <div class="text-body-sm font-medium">@review.User?.Username</div>
                            <div class="text-caption text-mute">@DisplayDateTime.Format(review.CreatedAt, "dd/MM/yyyy")</div>
                        </div>
                        <div class="flex gap-xxs ml-auto">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <span style="color:@(s <= review.Rating ? "#d97706" : "var(--color-hairline)");">★</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Review))
                    {
                        <div class="review-card__content">@review.Review</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-overlay" id="reportModal">
    <div class="modal">
        <div class="modal__header">
            <div class="modal__title">Báo cáo vi phạm</div>
            <button class="modal__close" onclick="closeModal('reportModal')">×</button>
        </div>
        <form method="post" asp-page-handler="Report">
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetNovelId" value="@novel.Id" />
            <div class="form-group">
                <label class="form-label">Loại vi phạm</label>
                <select class="form-select" name="reportType">
                    <option value="Inappropriate">Nội dung không phù hợp</option>
                    <option value="Copyright">Vi phạm bản quyền</option>
                    <option value="Spam">Spam</option>
                    <option value="Other">Khác</option>
                </select>
            </div>
            @{
                var allChapters = novel.Volumes.SelectMany(v => v.Chapters).Where(c => c.Status == "Published").ToList();
            }
            @if (allChapters.Any())
            {
                <div class="form-group">
                    <label class="form-label">Chương vi phạm <span class="text-muted" style="font-weight:400">(không bắt buộc)</span></label>
                    <select class="form-select" name="targetChapterId">
                        @foreach (var ch in allChapters)
                        {
                            <option value="@ch.Id">Ch.@ch.ChapterNumber - @ch.Title</option>
                        }
                    </select>
                </div>
            }
            <div class="form-group">
                <label class="form-label">Mô tả</label>
                <textarea class="form-textarea" name="description" placeholder="Chi tiết vi phạm..." rows="4" required></textarea>
            </div>
            <div class="modal__footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('reportModal')">Hủy</button>
                <button type="submit" class="btn btn-danger">Gửi báo cáo</button>
            </div>
        </form>
    </div>
</div>

@functions {
    string FormatNum(int n) => n >= 1000000 ? $"{n / 1000000.0:0.#}M" : n >= 1000 ? $"{n / 1000.0:0.#}K" : n.ToString();

    static string StatusLabel(string? status) => DisplayText.Status(status);

    static bool IsPendingDeletion(string? status)
        => string.Equals(status, "PendingDeletion", StringComparison.OrdinalIgnoreCase);

    static string FormatDateTime(DateTime value) => DisplayDateTime.Format(value, "dd/MM/yyyy HH:mm");
}

@section Scripts {
<script>
function switchTab(tab) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('[id^="tab-"]').forEach(c => c.classList.add('hidden'));
    document.querySelector(`[data-tab="${tab}"]`)?.classList.add('active');
    document.getElementById(`tab-${tab}`)?.classList.remove('hidden');
}

function toggleNovelDescription(btn) {
    const wrap = document.getElementById('novelDescriptionWrap');
    if (!wrap) return;

    const collapsed = wrap.classList.toggle('is-collapsed');
    btn.textContent = collapsed ? 'Xem thêm' : 'Thu gọn';
}

document.querySelectorAll('.js-star-rating').forEach(container => {
    const input = document.getElementById(container.dataset.input || '');
    const stars = container.querySelectorAll('.star');
    stars.forEach(s => s.textContent = '\u2605');

    const paint = value => {
        stars.forEach((s, j) => s.style.color = j < value ? '#d97706' : '#ebebeb');
    };

    if (input && !input.value) input.value = container.dataset.value || '0';
    paint(parseInt(input?.value || container.dataset.value || '0', 10) || 0);

    stars.forEach((star, i) => {
        star.addEventListener('mouseover', () => paint(i + 1));
        star.addEventListener('mouseleave', () => paint(parseInt(input?.value || '0', 10) || 0));
        star.addEventListener('click', () => {
            if (input) input.value = (i + 1).toString();
            paint(i + 1);
        });
    });
});

let novelViewRecorded = false;
setTimeout(async () => {
    if (novelViewRecorded) return;
    novelViewRecorded = true;

    try {
        const res = await fetch('/api/novels/@novel.Id/views', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true
        });
        if (!res.ok) return;

        const viewCount = document.getElementById('novelViewCount');
        if (!viewCount) return;

        const current = Number.parseInt(viewCount.dataset.count || viewCount.textContent || '0', 10) || 0;
        const next = current + 1;
        viewCount.dataset.count = next.toString();
        viewCount.textContent = typeof formatCompactNumber === 'function'
            ? formatCompactNumber(next)
            : next.toString();
    } catch (e) {
        // View tracking should not interrupt reading.
    }
}, 2000);
</script>
}
