@page "/Novels/{novelSlug}/{chapterSlug}/read"
@model litnovel_frontend.Pages.Novels.ReadModel
@{
    ViewData["Title"] = Model.Chapter?.Title ?? "Đọc chương";
    var ch = Model.Chapter;
    var novelUrl = !string.IsNullOrWhiteSpace(ch?.Novel?.Slug) ? ch.Novel.Slug : ch?.Novel?.Id.ToString();
    var allVolumes = Model.Novel?.Volumes ?? [];
    var interactionsLocked = ch != null && (IsPendingDeletion(ch.Novel?.Status) || IsPendingDeletion(ch.Status));
}
@if (ch == null)
{
    <div class="container" style="padding-top:80px;">
        <div class="empty-state">
            <div class="empty-state__icon">⌕</div>
            <div class="empty-state__title">Không tìm thấy chương này</div>
            <a href="/Novels" class="btn btn-primary mt-md">Quay lại</a>
        </div>
    </div>
    return;
}

<div class="reader-toolbar">
    <div class="reader-toolbar__inner">
        <div class="reader-toolbar__context">
            <a href="/Novels/@novelUrl" class="reader-toolbar__novel">@ch.Novel?.Title</a>
            <span class="reader-toolbar__chapter">Ch.@ch.ChapterNumber</span>
        </div>

        <div class="reader-toolbar__nav" aria-label="Điều hướng chương">
            @if (ch.PrevChapter != null)
            {
                var prevUrl = !string.IsNullOrWhiteSpace(ch.PrevChapter.Slug) ? ch.PrevChapter.Slug : ch.PrevChapter.Id.ToString();
                <a href="/Novels/@novelUrl/@prevUrl/read" class="btn-icon reader-toolbar__button" title="Chương trước" aria-label="Chương trước">←</a>
            }
            else
            {
                <span class="btn-icon reader-toolbar__button disabled" aria-disabled="true">←</span>
            }

            <button type="button" class="btn-icon reader-toolbar__button reader-toolbar__menu" onclick="openModal('chapterListModal')" title="Danh sách chương" aria-label="Danh sách chương">
                <span></span><span></span><span></span>
            </button>

            @if (ch.NextChapter != null)
            {
                var nextUrl = !string.IsNullOrWhiteSpace(ch.NextChapter.Slug) ? ch.NextChapter.Slug : ch.NextChapter.Id.ToString();
                <a href="/Novels/@novelUrl/@nextUrl/read" class="btn-icon reader-toolbar__button" title="Chương tiếp theo" aria-label="Chương tiếp theo">→</a>
            }
            else
            {
                <span class="btn-icon reader-toolbar__button disabled" aria-disabled="true">→</span>
            }
        </div>

        <div class="reader-toolbar__font" aria-label="Cỡ chữ">
            <button onclick="changeFontSize(-1)" class="btn-icon reader-toolbar__button" title="Nhỏ hơn">A-</button>
            <button onclick="changeFontSize(1)" class="btn-icon reader-toolbar__button" title="Lớn hơn">A+</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="chapterListModal">
    <div class="modal modal-lg reader-chapter-modal" role="dialog" aria-modal="true" aria-labelledby="chapterListTitle">
        <div class="modal__header reader-chapter-modal__header">
            <div>
                <div class="modal__title" id="chapterListTitle">Danh sách chương</div>
                <div class="text-caption text-mute">@ch.Novel?.Title</div>
            </div>
            <button type="button" class="modal__close" onclick="closeModal('chapterListModal')" aria-label="Đóng">×</button>
        </div>
        <div class="reader-chapter-modal__body">
            @if (allVolumes.Any())
            {
                @foreach (var volume in allVolumes.OrderBy(v => v.VolumeNumber))
                {
                    <section class="reader-volume">
                        <div class="reader-volume__title">
                            <span>Tập @volume.VolumeNumber</span>
                            <strong>@volume.Title</strong>
                        </div>
                        <div class="reader-volume__chapters">
                            @foreach (var chapter in volume.Chapters.OrderBy(c => c.ChapterNumber))
                            {
                                var chapterUrl = !string.IsNullOrWhiteSpace(chapter.Slug) ? chapter.Slug : chapter.Id.ToString();
                                var isActive = chapter.Id == ch.Id;
                                <a href="/Novels/@novelUrl/@chapterUrl/read" class="reader-chapter-link @(isActive ? "active" : "") @(chapter.IsRead ? "read" : "")">
                                    <span class="reader-chapter-link__number">Ch.@chapter.ChapterNumber</span>
                                    <span class="reader-chapter-link__title">@chapter.Title</span>
                                </a>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="empty-state empty-state--compact">
                    <div class="empty-state__title">Chưa có danh sách chương</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteCommentModal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="deleteCommentTitle">
        <div class="modal__header">
            <div class="modal__title" id="deleteCommentTitle">Xóa bình luận</div>
            <button type="button" class="modal__close" onclick="closeDeleteCommentModal()" aria-label="Đóng">×</button>
        </div>
        <p class="text-body-sm text-body">Bình luận này sẽ bị xóa khỏi chương. Hành động này không thể hoàn tác.</p>
        <div class="modal__footer">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteCommentModal()">Hủy</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteCommentBtn" onclick="confirmDeleteComment()">Xóa bình luận</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="reportCommentModal">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal__header">
            <div class="modal__title">Báo cáo bình luận</div>
            <button type="button" class="modal__close" onclick="closeModal('reportCommentModal')">×</button>
        </div>
        <form id="reportCommentForm" onsubmit="submitReportComment(event)">
            <input type="hidden" id="reportCommentId" name="TargetCommentId" />
            <input type="hidden" id="reportUserId" name="TargetUserId" />
            <input type="hidden" name="ReportKind" value="User" />
            
            <div class="modal__body" style="padding:var(--space-md);">
                <div class="form-group mb-sm">
                    <label class="form-label">Loại vi phạm</label>
                    <select name="ReportType" class="form-control" required>
                        <option value="Spam">Spam / Quảng cáo</option>
                        <option value="Inappropriate">Ngôn từ không phù hợp / Xúc phạm</option>
                        <option value="Harassment">Quấy rối / Công kích cá nhân</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>
                <div class="form-group mb-md">
                    <label class="form-label">Mô tả thêm (Không bắt buộc)</label>
                    <textarea name="Description" class="form-textarea" rows="3" placeholder="Chi tiết vi phạm..."></textarea>
                </div>
            </div>
            <div class="modal__footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('reportCommentModal')">Hủy</button>
                <button type="submit" class="btn btn-danger" id="submitReportBtn">Gửi báo cáo</button>
            </div>
        </form>
    </div>
</div>

<div class="reader-layout reader-layout--main" id="readerLayout">
    <div class="reader-header">
        <div class="reader-novel-title">
            <a href="/Novels/@novelUrl" style="color:var(--color-mute); text-decoration:none;">@ch.Novel?.Title</a>
        </div>
        <h1 class="reader-chapter-title">@ch.Title</h1>
        @if (interactionsLocked)
        {
            var hardDeleteAt = ch.ScheduledHardDeleteAt ?? ch.Novel?.ScheduledHardDeleteAt;
            <div class="alert alert-info mt-md">
                Tác giả đã lên lịch xóa nội dung này@(hardDeleteAt.HasValue ? $", nội dung sẽ được dọn vào {FormatDateTime(hardDeleteAt.Value)}" : "").
            </div>
        }
        <div class="text-caption text-mute mt-xs">Chương @ch.ChapterNumber · @DisplayDateTime.Format(ch.CreatedAt, "dd/MM/yyyy")</div>
    </div>

    <div class="reader-content" id="chapterContent">
        @Html.Raw(ch.Content)
    </div>

    <div class="reader-nav">
        @if (ch.PrevChapter != null)
        {
            var prevUrl = !string.IsNullOrWhiteSpace(ch.PrevChapter.Slug) ? ch.PrevChapter.Slug : ch.PrevChapter.Id.ToString();
            <a href="/Novels/@novelUrl/@prevUrl/read" class="btn btn-secondary">← Ch.@ch.PrevChapter.ChapterNumber</a>
        }
        else
        {
            <span></span>
        }

        <button type="button" class="btn btn-ghost" onclick="openModal('chapterListModal')">Danh sách chương</button>

        @if (ch.NextChapter != null)
        {
            var nextUrl = !string.IsNullOrWhiteSpace(ch.NextChapter.Slug) ? ch.NextChapter.Slug : ch.NextChapter.Id.ToString();
            <a href="/Novels/@novelUrl/@nextUrl/read" class="btn btn-primary">Ch.@ch.NextChapter.ChapterNumber →</a>
        }
        else
        {
            <span></span>
        }
    </div>
</div>

<div style="background:var(--color-canvas); border-top:1px solid var(--color-hairline); padding:var(--space-2xl) 0;">
    <div class="reader-layout" style="padding-top:0; padding-bottom:0;">
        <h2 class="text-display-sm mb-xl">Bình luận (@Model.TotalComments)</h2>

        @if (interactionsLocked)
        {
            <div class="alert alert-info mb-xl">N&#7897;i dung &#273;ang &#7903; tr&#7841;ng th&#225;i ch&#7901; x&#243;a n&#234;n b&#236;nh lu&#7853;n &#273;&#227; t&#7841;m kh&#243;a.</div>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page-handler="Comment" class="mb-xl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="chapterId" value="@ch.Id" />
                <div class="flex gap-md">
                    @RenderAvatar(ViewData["UserName"]?.ToString(), ViewData["UserAvatar"]?.ToString(), "avatar avatar-sm")
                    <div style="flex:1;">
                        <textarea class="form-textarea" name="content" placeholder="Viết bình luận..." rows="3" required></textarea>
                        <div class="flex justify-between mt-xs">
                            <span class="form-hint">Tối đa 2000 ký tự</span>
                            <button type="submit" class="btn btn-primary" style="height:36px; border-radius:var(--radius-sm);">Gửi</button>
                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-info mb-xl"><a href="/Auth/Login" style="color:inherit; font-weight:500;">Đăng nhập</a> để bình luận.</div>
        }

        @foreach (var comment in Model.Comments)
        {
            <div class="comment" id="comment-@comment.Id">
                @RenderAvatar(comment.User?.Username, comment.User?.Avatar, "avatar avatar-sm")
                <div class="comment__body">
                    <div class="comment__header">
                        <span class="comment__author">@comment.User?.Username</span>
                        @if (comment.User?.Badges?.Any() == true)
                        {
                            <span class="comment-user-badges">
                                @foreach (var badge in comment.User.Badges)
                                {
                                    var badgeColor = string.IsNullOrWhiteSpace(badge.Color) ? "var(--color-ink)" : badge.Color;
                                    <span class="comment-user-badge" title="@badge.Name" style="--badge-color:@badgeColor;">
                                        <span>@badge.Name</span>
                                    </span>
                                }
                            </span>
                        }
                        @if (Model.CurrentUserId == comment.User?.Id)
                        {
                            <button type="button" class="comment__delete" onclick="deleteComment(@comment.Id)" title="Xóa bình luận" aria-label="Xóa bình luận">
                                <span aria-hidden="true">🗑</span>
                            </button>
                        }
                    </div>
                    <div class="comment__content">@comment.Content</div>
                    <div class="comment__actions">
                        @if (User.Identity?.IsAuthenticated == true && !interactionsLocked)
                        {
                            <button type="button"
                                    class="comment__action @(comment.IsLiked ? "active" : "")"
                                    data-liked="@comment.IsLiked.ToString().ToLowerInvariant()"
                                    data-count="@comment.LikeCount"
                                    onclick="toggleCommentLike(@comment.Id, this)">
                                <span class="comment-like-text">@(comment.IsLiked ? "Bỏ thích" : "Thích")</span>
                                <span class="comment-like-count">@comment.LikeCount</span>
                            </button>
                            <button type="button" class="comment__action" onclick="showReply(@comment.Id)">Trả lời</button>
                            @if (Model.CurrentUserId != comment.User?.Id)
                            {
                                <button type="button" class="comment__action text-mute" onclick="reportComment(@comment.Id, @(comment.User?.Id ?? 0))" title="Báo cáo bình luận">Báo cáo</button>
                            }
                        }
                        else
                        {
                            <span class="comment__action">Thích @comment.LikeCount</span>
                        }
                        <span class="comment__time">@TimeAgo(comment.CreatedAt)</span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true && !interactionsLocked)
                    {
                        <form method="post" asp-page-handler="Reply" id="replyForm-@comment.Id" class="hidden mt-sm" style="margin-left:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="chapterId" value="@ch.Id" />
                            <input type="hidden" name="parentCommentId" value="@comment.Id" />
                            <div class="flex gap-sm">
                                <textarea class="form-textarea" name="content" placeholder="Trả lời..." rows="2" style="min-height:60px;"></textarea>
                                <div class="flex flex-col gap-xs" style="flex-shrink:0;">
                                    <button type="submit" class="btn btn-primary btn-sm">Gửi</button>
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="showReply(@comment.Id)">Hủy</button>
                                </div>
                            </div>
                        </form>
                    }

                    @if (comment.Replies.Any())
                    {
                        <div class="comment__replies">
                            @foreach (var reply in comment.Replies)
                            {
                                <div class="comment" id="comment-@reply.Id" style="padding-top:var(--space-sm);">
                                    @RenderAvatar(reply.User?.Username, reply.User?.Avatar, "avatar avatar-xs")
                                    <div class="comment__body">
                                        <div class="comment__header">
                                            <span class="comment__author">@reply.User?.Username</span>
                                            @if (reply.User?.Badges?.Any() == true)
                                            {
                                                <span class="comment-user-badges">
                                                    @foreach (var badge in reply.User.Badges)
                                                    {
                                                        var badgeColor = string.IsNullOrWhiteSpace(badge.Color) ? "var(--color-ink)" : badge.Color;
                                                        <span class="comment-user-badge" title="@badge.Name" style="--badge-color:@badgeColor;">
                                                            <span>@badge.Name</span>
                                                        </span>
                                                    }
                                                </span>
                                            }
                                            @if (Model.CurrentUserId == reply.User?.Id)
                                            {
                                                <button type="button" class="comment__delete" onclick="deleteComment(@reply.Id)" title="Xóa bình luận" aria-label="Xóa bình luận">
                                                    <span aria-hidden="true">🗑</span>
                                                </button>
                                            }
                                        </div>
                                        <div class="comment__content">@reply.Content</div>
                                        <div class="comment__actions">
                                            @if (User.Identity?.IsAuthenticated == true && !interactionsLocked)
                                            {
                                                <button type="button"
                                                        class="comment__action @(reply.IsLiked ? "active" : "")"
                                                        data-liked="@reply.IsLiked.ToString().ToLowerInvariant()"
                                                        data-count="@reply.LikeCount"
                                                        onclick="toggleCommentLike(@reply.Id, this)">
                                                    <span class="comment-like-text">@(reply.IsLiked ? "Bỏ thích" : "Thích")</span>
                                                    <span class="comment-like-count">@reply.LikeCount</span>
                                                </button>
                                                @if (Model.CurrentUserId != reply.User?.Id)
                                                {
                                                    <button type="button" class="comment__action text-mute" onclick="reportComment(@reply.Id, @(reply.User?.Id ?? 0))" title="Báo cáo bình luận">Báo cáo</button>
                                                }
                                            }
                                            else
                                            {
                                                <span class="comment__action">Thích @reply.LikeCount</span>
                                            }
                                            <span class="comment__time">@TimeAgo(reply.CreatedAt)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (!Model.Comments.Any())
        {
            <div class="empty-state" style="padding:var(--space-2xl);">
                <div class="empty-state__icon">💬</div>
                <div class="empty-state__title">Chưa có bình luận nào</div>
                <div class="empty-state__desc">Hãy là người đầu tiên bình luận!</div>
            </div>
        }
    </div>
</div>

@functions {
    string TimeAgo(DateTime dt)
    {
        return DisplayDateTime.Relative(dt);
    }

    static bool IsPendingDeletion(string? status)
        => string.Equals(status, "PendingDeletion", StringComparison.OrdinalIgnoreCase);

    static string FormatDateTime(DateTime value) => DisplayDateTime.Format(value, "dd/MM/yyyy HH:mm");

    Microsoft.AspNetCore.Html.IHtmlContent RenderAvatar(string? username, string? avatar, string cssClass)
    {
        var initial = string.IsNullOrWhiteSpace(username) ? "U" : username.Trim().Substring(0, 1).ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(avatar))
        {
            return new Microsoft.AspNetCore.Html.HtmlString($"<img src=\"{System.Net.WebUtility.HtmlEncode(avatar)}\" alt=\"{System.Net.WebUtility.HtmlEncode(username ?? "User")}\" class=\"{cssClass}\" />");
        }

        if (cssClass.Contains("avatar-xs", StringComparison.Ordinal))
        {
            return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"avatar-placeholder\" style=\"width:28px;height:28px;border-radius:50%;font-size:12px;flex-shrink:0;\">{initial}</div>");
        }

        return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"avatar-placeholder avatar-sm\" style=\"flex-shrink:0;\">{initial}</div>");
    }
}

@section Scripts {
<script>
let fontSize = 17;
function changeFontSize(delta) {
    fontSize = Math.max(14, Math.min(24, fontSize + delta));
    document.getElementById('chapterContent').style.fontSize = fontSize + 'px';
    localStorage.setItem('readerFontSize', fontSize);
}
const saved = localStorage.getItem('readerFontSize');
if (saved) {
    fontSize = parseInt(saved);
    document.getElementById('chapterContent').style.fontSize = fontSize + 'px';
}

function showReply(id) {
    const form = document.getElementById('replyForm-' + id);
    if (form) form.classList.toggle('hidden');
}

async function toggleCommentLike(commentId, btn) {
    const isLiked = btn.dataset.liked === 'true';
    const method = isLiked ? 'DELETE' : 'POST';

    try {
        const res = await fetch(`/api/comments/${commentId}/likes`, { method, headers: getHeaders() });
        if (!res.ok) {
            showToast('Không thể cập nhật lượt thích.', 'error');
            return;
        }

        const nextLiked = !isLiked;
        const current = Number.parseInt(btn.dataset.count || '0', 10) || 0;
        const nextCount = Math.max(0, current + (nextLiked ? 1 : -1));

        btn.dataset.liked = nextLiked.toString();
        btn.dataset.count = nextCount.toString();
        btn.classList.toggle('active', nextLiked);
        btn.querySelector('.comment-like-text').textContent = nextLiked ? 'Bỏ thích' : 'Thích';
        btn.querySelector('.comment-like-count').textContent = nextCount.toString();
    } catch {
        showToast('Không thể cập nhật lượt thích.', 'error');
    }
}

let pendingDeleteCommentId = null;

function deleteComment(commentId) {
    pendingDeleteCommentId = commentId;
    openModal('deleteCommentModal');
}

function closeDeleteCommentModal() {
    pendingDeleteCommentId = null;
    closeModal('deleteCommentModal');
}

async function confirmDeleteComment() {
    if (!pendingDeleteCommentId) return;

    const commentId = pendingDeleteCommentId;
    const btn = document.getElementById('confirmDeleteCommentBtn');
    if (btn) btn.disabled = true;

    try {
        const res = await fetch(`/api/comments/${commentId}`, { method: 'DELETE', headers: getHeaders() });
        if (!res.ok) {
            showToast('Không thể xóa bình luận.', 'error');
            return;
        }

        document.getElementById(`comment-${commentId}`)?.remove();
        closeDeleteCommentModal();
        showToast('Đã xóa bình luận.', 'success');
    } catch {
        showToast('Không thể xóa bình luận.', 'error');
    } finally {
        if (btn) btn.disabled = false;
    }
}

function reportComment(commentId, targetUserId) {
    if (targetUserId === 0) return;
    document.getElementById('reportCommentId').value = commentId;
    document.getElementById('reportUserId').value = targetUserId;
    document.getElementById('reportCommentForm').reset();
    openModal('reportCommentModal');
}

async function submitReportComment(e) {
    e.preventDefault();
    const btn = document.getElementById('submitReportBtn');
    if (btn) btn.disabled = true;

    const form = e.target;
    const data = {
        TargetUserId: parseInt(form.TargetUserId.value),
        TargetCommentId: parseInt(form.TargetCommentId.value),
        ReportType: form.ReportType.value,
        Description: form.Description.value
    };

    try {
        const res = await fetch('/api/reports/users', {
            method: 'POST',
            headers: getHeaders(),
            body: JSON.stringify(data)
        });

        if (res.ok) {
            showToast('Đã gửi báo cáo bình luận thành công.', 'success');
            closeModal('reportCommentModal');
        } else {
            const error = await res.json();
            showToast(error?.message || 'Không thể gửi báo cáo.', 'error');
        }
    } catch {
        showToast('Có lỗi xảy ra khi gửi báo cáo.', 'error');
    } finally {
        if (btn) btn.disabled = false;
    }
}
</script>
}
