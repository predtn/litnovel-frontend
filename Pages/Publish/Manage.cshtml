@page "{id:int}/Manage"
@model litnovel_frontend.Pages.Publish.ManageModel
@{
    ViewData["Title"] = "Manage Novel";
}

<div class="publish-shell">
    <div class="breadcrumb">
        <a asp-page="/Publish/Index">My Novels</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">@Model.Novel.Title</span>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success mb-lg">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-error mb-lg">@error</div> }

    <section class="publish-hero-card">
        @if (!string.IsNullOrEmpty(Model.Novel.CoverImage))
        {
            <img src="@Model.Novel.CoverImage" alt="@Model.Novel.Title" class="publish-cover-lg" />
        }
        else
        {
            <div class="publish-cover-lg publish-cover-empty">B</div>
        }
        <div class="publish-hero-main">
            <div class="flex gap-sm items-center mb-sm">
                <span class="status-badge status-@Model.Novel.Status.ToLowerInvariant()">@Model.Novel.Status</span>
                <span class="text-caption text-mute">Updated @Model.Novel.UpdatedAt.ToString("dd/MM/yyyy")</span>
            </div>
            <h1 class="page-header__title">@Model.Novel.Title</h1>
            <div class="publish-meta-row">
                <span>@Model.Novel.TotalVolumes volumes</span>
                <span>@Model.Novel.TotalChapters chapters</span>
                <span>@Model.Novel.ViewCount.ToString("N0") views</span>
                <span>@Model.Novel.RatingAverage.ToString("0.0") rating</span>
            </div>
            <div class="publish-hero-actions">
                <a asp-page="/Publish/Edit" asp-route-id="@Model.Novel.Id" class="btn btn-secondary">Edit Novel Info</a>
                <a asp-page="/Publish/Volumes" asp-route-novelId="@Model.Novel.Id" class="btn btn-primary">Manage Volumes</a>
                <a asp-page="/Publish/Statistics" asp-route-id="@Model.Novel.Id" class="btn btn-secondary">Statistics</a>
            </div>
        </div>
    </section>

    <div class="publish-detail-grid">
        <section class="card">
            <div class="tabs">
                <a href="#overview" class="tab active">Overview</a>
                <a asp-page="/Publish/Volumes" asp-route-novelId="@Model.Novel.Id" class="tab">Volumes & Chapters</a>
                <a asp-page="/Publish/Statistics" asp-route-id="@Model.Novel.Id" class="tab">Statistics</a>
                <a href="#settings" class="tab">Settings</a>
            </div>
            <div id="overview" class="publish-richtext">@Html.Raw(Model.Novel.Description)</div>
            <div class="divider"></div>
            <div class="flex gap-xs" style="flex-wrap:wrap;">
                @foreach (var tag in Model.Novel.Tags)
                {
                    <span class="badge badge-secondary">@tag.Name</span>
                }
            </div>
        </section>

        <aside class="card publish-side-panel" id="settings">
            <h2 class="text-display-sm mb-md">Publishing Controls</h2>
            <form method="post" asp-page-handler="Submit" asp-route-id="@Model.Novel.Id" class="mb-sm">
                <button class="btn btn-primary w-full" type="submit">Submit for Review</button>
            </form>
            <a asp-page="/Publish/Moderation" class="btn btn-secondary w-full mb-sm">Moderation Status</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Novel.Id" onsubmit="return confirm('Delete this novel and all chapters?');">
                <button class="btn btn-danger w-full" type="submit">Delete Novel</button>
            </form>
        </aside>
    </div>
</div>
