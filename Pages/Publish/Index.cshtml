@page
@model litnovel_frontend.Pages.Publish.IndexModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Tiểu thuyết của tôi";
}

@section Sidebar {
    <a href="/Publish" class="sidebar__link active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Tiểu thuyết
    </a>
    <a href="/Publish/Create" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tạo mới
    </a>
    <div class="sidebar__section-label">Theo dõi</div>
    <a href="/Publish/ModerationStatus" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Trạng thái duyệt
    </a>
}

<!-- SCR-18: My Novels Dashboard -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Tiểu thuyết của tôi</h1>
        <p class="page-header__subtitle">Quản lý tất cả tiểu thuyết bạn đã tạo</p>
    </div>
    <a href="/Publish/Create" class="btn btn-primary">+ Tạo tiểu thuyết mới</a>
</div>

<!-- Stats row -->
<div class="grid-4 mb-xl" style="grid-template-columns: repeat(4, 1fr);">
    <div class="stat-card">
        <div class="stat-card__label">Tổng truyện</div>
        <div class="stat-card__value">@Model.Stats.Total</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Đang ra</div>
        <div class="stat-card__value" style="color:var(--color-link);">@Model.Stats.Ongoing</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Chờ duyệt</div>
        <div class="stat-card__value" style="color:var(--color-warning);">@Model.Stats.Pending</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Tổng lượt xem</div>
        <div class="stat-card__value">@FormatNum(Model.Stats.TotalViews)</div>
    </div>
</div>

<!-- Filter tabs -->
<div class="tabs">
    <a href="?status=" class="tab @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")">Tất cả</a>
    <a href="?status=Draft" class="tab @(Model.StatusFilter == "Draft" ? "active" : "")">Bản nháp</a>
    <a href="?status=Pending" class="tab @(Model.StatusFilter == "Pending" ? "active" : "")">Chờ duyệt</a>
    <a href="?status=Ongoing" class="tab @(Model.StatusFilter == "Ongoing" ? "active" : "")">Đang ra</a>
    <a href="?status=Ended" class="tab @(Model.StatusFilter == "Ended" ? "active" : "")">Hoàn thành</a>
</div>

<!-- Novels table -->
@if (!Model.Novels.Any())
{
    <div class="empty-state">
        <div class="empty-state__icon">📝</div>
        <div class="empty-state__title">Chưa có tiểu thuyết nào</div>
        <div class="empty-state__desc">Bắt đầu hành trình sáng tác của bạn ngay hôm nay!</div>
        <a href="/Publish/Create" class="btn btn-primary mt-md">Tạo tiểu thuyết đầu tiên</a>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Tiểu thuyết</th>
                    <th>Trạng thái</th>
                    <th>Chương</th>
                    <th>Lượt xem</th>
                    <th>Đánh giá</th>
                    <th>Cập nhật</th>
                    <th class="col-actions">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var novel in Model.Novels)
                {
                    <tr>
                        <td>
                            <div class="flex gap-md items-center">
                                @if (!string.IsNullOrEmpty(novel.CoverImage))
                                {
                                    <img src="@novel.CoverImage" style="width:40px;height:56px;object-fit:cover;border-radius:var(--radius-xs);" />
                                }
                                else
                                {
                                    <div style="width:40px;height:56px;background:var(--color-canvas-soft-2);border-radius:var(--radius-xs);display:flex;align-items:center;justify-content:center;font-size:18px;">📖</div>
                                }
                                <div>
                                    <div class="text-body-sm font-medium text-ink">@novel.Title</div>
                                    @if (novel.Category != null)
                                    {
                                        <div class="text-caption text-mute">@novel.Category.Name</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span class="status-badge status-@novel.Status.ToLower()">@novel.Status</span></td>
                        <td class="text-body-sm">@novel.TotalChapters</td>
                        <td class="text-body-sm">@FormatNum(novel.ViewCount)</td>
                        <td class="text-body-sm">⭐ @novel.RatingAverage.ToString("0.0")</td>
                        <td class="text-caption text-mute">@novel.UpdatedAt.ToString("dd/MM/yy")</td>
                        <td class="col-actions">
                            <div class="flex gap-xs justify-end">
                                <a href="/Publish/@novel.Id/manage" class="btn btn-ghost btn-sm">Quản lý</a>
                                <a href="/Publish/@novel.Id/edit" class="btn btn-secondary btn-sm">Sửa</a>
                                @if (novel.Status == "Draft")
                                {
                                    <form method="post" asp-page-handler="Submit" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="novelId" value="@novel.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Gửi duyệt</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions { string FormatNum(int n) => n >= 1000 ? $"{n/1000.0:0.#}K" : n.ToString(); }
