@page
@model litnovel_frontend.Pages.Publish.IndexModel
@{
    ViewData["Title"] = "My Novels";
}

<div class="publish-shell">
    <div class="page-header">
        <div>
            <h1 class="page-header__title">My Novels</h1>
            <p class="page-header__subtitle">Draft, submit, and manage your serialized novels.</p>
        </div>
        <a asp-page="/Publish/Create" class="btn btn-primary">Create Novel</a>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success mb-lg">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-error mb-lg">@error</div> }

    <div class="publish-stats">
        <div class="stat-card"><div class="stat-card__label">Total novels</div><div class="stat-card__value">@Model.TotalElements</div></div>
        <div class="stat-card"><div class="stat-card__label">Total chapters</div><div class="stat-card__value">@Model.TotalChapters</div></div>
        <div class="stat-card"><div class="stat-card__label">Total views</div><div class="stat-card__value">@Model.TotalViews.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">Avg rating</div><div class="stat-card__value">@Model.AverageRating.ToString("0.0")</div></div>
    </div>

    <div class="publish-toolbar">
        <div class="tabs publish-tabs">
            @foreach (var tab in new[] { ("", "All"), ("Draft", "Draft"), ("Pending", "Pending"), ("Ongoing", "Ongoing"), ("Ended", "Ended") })
            {
                <a class="tab @(Model.Status == tab.Item1 ? "active" : "")" asp-page="/Publish/Index" asp-route-status="@tab.Item1" asp-route-sort="@Model.Sort">@tab.Item2</a>
            }
        </div>
        <form method="get" class="publish-sort">
            <input type="hidden" name="status" value="@Model.Status" />
            <select name="sort" class="form-select" onchange="this.form.submit()">
                <option value="updatedAt" selected="@(Model.Sort == "updatedAt")">Updated</option>
                <option value="viewCount" selected="@(Model.Sort == "viewCount")">Views</option>
                <option value="ratingAverage" selected="@(Model.Sort == "ratingAverage")">Rating</option>
            </select>
        </form>
    </div>

    @if (!Model.Novels.Any())
    {
        <div class="empty-state card">
            <div class="empty-state__title">No novels yet</div>
            <div class="empty-state__desc">Start a draft and build your first volume.</div>
            <a asp-page="/Publish/Create" class="btn btn-primary">Create Novel</a>
        </div>
    }
    else
    {
        <div class="publish-table-card">
            <table class="table publish-table">
                <thead>
                    <tr>
                        <th>Novel</th>
                        <th>Status</th>
                        <th class="publish-col-center">Chapters</th>
                        <th class="publish-col-center">Views</th>
                        <th class="publish-col-center">Rating</th>
                        <th class="publish-col-center">Updated</th>
                        <th class="publish-col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var novel in Model.Novels)
                    {
                        <tr>
                            <td data-label="Novel">
                                <div class="publish-title-cell">
                                    @if (!string.IsNullOrEmpty(novel.CoverImage))
                                    {
                                        <img src="@novel.CoverImage" alt="@novel.Title" class="publish-cover-sm" />
                                    }
                                    else
                                    {
                                        <div class="publish-cover-sm publish-cover-empty">B</div>
                                    }
                                    <div>
                                        <div class="font-medium">@novel.Title</div>
                                        <div class="text-caption text-mute">@novel.Category?.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Status"><span class="status-badge status-@novel.Status.ToLowerInvariant()">@novel.Status</span></td>
                            <td data-label="Chapters" class="publish-col-center">@novel.TotalChapters</td>
                            <td data-label="Views" class="publish-col-center">@novel.ViewCount.ToString("N0")</td>
                            <td data-label="Rating" class="publish-col-center">@novel.RatingAverage.ToString("0.0")</td>
                            <td data-label="Updated" class="publish-col-center">@novel.UpdatedAt.ToString("dd/MM/yyyy")</td>
                            <td data-label="Actions" class="publish-col-actions">
                                <div class="publish-actions">
                                    <a asp-page="/Publish/Manage" asp-route-id="@novel.Id" class="btn btn-secondary btn-sm">Preview</a>
                                    <a asp-page="/Publish/Edit" asp-route-id="@novel.Id" class="btn btn-secondary btn-sm">Edit</a>
                                    <a asp-page="/Publish/Manage" asp-route-id="@novel.Id" class="btn btn-primary btn-sm">Manage</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@novel.Id" onsubmit="return confirm('Delete this novel?');">
                                        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
