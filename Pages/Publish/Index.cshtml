@page
@model litnovel_frontend.Pages.Publish.IndexModel
@{
    ViewData["Title"] = "Truyện của tôi";
}

<div class="publish-shell">
    <div class="page-header">
        <div>
            <h1 class="page-header__title">Truyện của tôi</h1>
            <p class="page-header__subtitle">Soạn bản nháp, gửi duyệt và quản lý các truyện dài kỳ của bạn.</p>
        </div>
        <a asp-page="/Publish/Create" class="btn btn-primary">Tạo truyện</a>
    </div>
<div class="publish-stats">
        <div class="stat-card"><div class="stat-card__label">Tổng truyện</div><div class="stat-card__value">@Model.TotalElements</div></div>
        <div class="stat-card"><div class="stat-card__label">Tổng chương</div><div class="stat-card__value">@Model.TotalChapters</div></div>
        <div class="stat-card"><div class="stat-card__label">Tổng lượt xem</div><div class="stat-card__value">@Model.TotalViews.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">Điểm trung bình</div><div class="stat-card__value">@Model.AverageRating.ToString("0.0")</div></div>
    </div>

    <div class="publish-toolbar">
        <div class="tabs publish-tabs">
            @foreach (var tab in new[] { ("", "Tất cả"), ("Draft", "Bản nháp"), ("Pending", "Chờ duyệt"), ("Ongoing", "Đang tiến hành"), ("Ended", "Đã kết thúc") })
            {
                <a class="tab @(Model.Status == tab.Item1 ? "active" : "")" asp-page="/Publish/Index" asp-route-status="@tab.Item1" asp-route-sort="@Model.Sort">@tab.Item2</a>
            }
        </div>
        <form method="get" class="publish-sort">
            <input type="hidden" name="status" value="@Model.Status" />
            <select name="sort" class="form-select" onchange="this.form.submit()">
                <option value="updatedAt" selected="@(Model.Sort == "updatedAt")">Cập nhật</option>
                <option value="viewCount" selected="@(Model.Sort == "viewCount")">Lượt xem</option>
                <option value="ratingAverage" selected="@(Model.Sort == "ratingAverage")">Đánh giá</option>
            </select>
        </form>
    </div>

    @if (!Model.Novels.Any())
    {
        <div class="empty-state card">
            <div class="empty-state__title">Chưa có truyện</div>
            <div class="empty-state__desc">Bắt đầu một bản nháp và tạo tập đầu tiên của bạn.</div>
            <a asp-page="/Publish/Create" class="btn btn-primary">Tạo truyện</a>
        </div>
    }
    else
    {
        <div class="publish-table-card">
            <table class="table publish-table">
                <thead>
                    <tr>
                        <th>Truyện</th>
                        <th>Trạng thái</th>
                        <th class="publish-col-center">Chương</th>
                        <th class="publish-col-center">Lượt xem</th>
                        <th class="publish-col-center">Đánh giá</th>
                        <th class="publish-col-center">Cập nhật</th>
                        <th class="publish-col-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var novel in Model.Novels)
                    {
                        var canDelete = !novel.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase);
                        var canEdit = Model.CanEditNovel(novel.Status);
                        <tr>
                            <td data-label="Truyện">
                                <div class="publish-title-cell">
                                    @if (!string.IsNullOrEmpty(novel.CoverImage))
                                    {
                                        <img src="@novel.CoverImage" alt="@novel.Title" class="publish-cover-sm" />
                                    }
                                    else
                                    {
                                        <div class="publish-cover-sm publish-cover-empty">B</div>
                                    }
                                    <div>
                                        <div class="font-medium">@novel.Title</div>
                                        <div class="text-caption text-mute">@novel.Category?.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Trạng thái"><span class="status-badge status-@novel.Status.ToLowerInvariant()">@DisplayText.Status(novel.Status)</span></td>
                            <td data-label="Chương" class="publish-col-center">@novel.TotalChapters</td>
                            <td data-label="Lượt xem" class="publish-col-center">@novel.ViewCount.ToString("N0")</td>
                            <td data-label="Đánh giá" class="publish-col-center">@novel.RatingAverage.ToString("0.0")</td>
                            <td data-label="Cập nhật" class="publish-col-center">@novel.UpdatedAt.ToString("dd/MM/yyyy")</td>
                            <td data-label="Hành động" class="publish-col-actions">
                                <div class="publish-actions">
                                    <a asp-page="/Publish/Manage" asp-route-id="@novel.Id" class="btn btn-secondary btn-sm">Xem</a>
                                    @if (canEdit)
                                    {
                                        <a asp-page="/Publish/Edit" asp-route-id="@novel.Id" class="btn btn-secondary btn-sm">Sửa</a>
                                    }
                                    <a asp-page="/Publish/Manage" asp-route-id="@novel.Id" class="btn btn-primary btn-sm">Quản lý</a>
                                    @if (canDelete)
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@novel.Id" onsubmit="return confirm('Xóa truyện này? Hành động này không thể hoàn tác.');">
                                            <button class="btn btn-danger btn-sm" type="submit">Xóa</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
