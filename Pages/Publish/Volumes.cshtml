@page "{novelId:int}/Volumes"
@model litnovel_frontend.Pages.Publish.VolumesModel
@{
    ViewData["Title"] = "Volume Management";
}

<div class="publish-shell">
    <div class="breadcrumb">
        <a asp-page="/Publish/Index">My Novels</a><span class="breadcrumb__sep">/</span>
        <a asp-page="/Publish/Manage" asp-route-id="@Model.Novel.Id">@Model.Novel.Title</a><span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Volumes</span>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success mb-lg">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-error mb-lg">@error</div> }

    <div class="page-header">
        <div>
            <h1 class="page-header__title">Volume Management</h1>
            <p class="page-header__subtitle">@Model.Novel.Title</p>
        </div>
    </div>

    <form method="post" asp-page-handler="Create" class="card publish-inline-form">
        <div class="form-group">
            <label class="form-label" asp-for="Input.VolumeNumber">Number</label>
            <input class="form-input" asp-for="Input.VolumeNumber" min="1" type="number" />
        </div>
        <div class="form-group publish-inline-grow">
            <label class="form-label" asp-for="Input.Title">Volume title</label>
            <input class="form-input" asp-for="Input.Title" maxlength="200" placeholder="Volume 2: The Rising Storm" />
        </div>
        <button class="btn btn-primary" type="submit">Add Volume</button>
    </form>

    <div class="publish-volume-list">
        @foreach (var volume in Model.Volumes.OrderBy(v => v.VolumeNumber))
        {
            <article class="card publish-volume-card">
                <div>
                    <div class="text-caption text-mute">Volume @volume.VolumeNumber</div>
                    <h2 class="text-display-sm">@volume.Title</h2>
                    <div class="publish-meta-row">
                        <span>@volume.ChapterCount chapters</span>
                        <span>Created @volume.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                <div class="publish-actions">
                    <a asp-page="/Publish/Chapters" asp-route-volumeId="@volume.Id" asp-route-novelId="@Model.Novel.Id" class="btn btn-primary btn-sm">Manage Chapters</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@volume.Id" onsubmit="return confirm('Delete this volume and all chapters?');">
                        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                    </form>
                </div>
            </article>
        }
    </div>
</div>
