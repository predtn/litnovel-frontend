@page "Moderation"
@model litnovel_frontend.Pages.Publish.ModerationModel
@{
    ViewData["Title"] = "Trạng thái xét duyệt";
}

<div class="publish-shell">
    <div class="page-header">
        <div>
            <h1 class="page-header__title">Trạng thái xét duyệt</h1>
            <p class="page-header__subtitle">Theo dõi truyện và chương đã gửi duyệt.</p>
        </div>
    </div>

    <div class="tabs">
        <a href="/Publish/Moderation?tab=novels" class="tab @(Model.Tab == "novels" ? "active" : "")">Truyện</a>
        <a href="/Publish/Moderation?tab=chapters" class="tab @(Model.Tab == "chapters" ? "active" : "")">Chương</a>
    </div>

    <div class="publish-table-card">
        <table class="table publish-table">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Loại</th>
                    <th>Ngày gửi</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú duyệt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><span class="font-medium">@item.Title</span></td>
                        <td>@DisplayText.ModerationType(item.Type)</td>
                        <td>@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="status-badge status-@item.Status.ToLowerInvariant()">@DisplayText.Status(item.Status)</span></td>
                        <td class="text-body-sm text-mute">@(item.ReviewerNotes ?? "Không có ghi chú")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
