@page "Moderation"
@model litnovel_frontend.Pages.Publish.ModerationModel
@{
    ViewData["Title"] = "Moderation Status";
}

<div class="publish-shell">
    <div class="page-header">
        <div>
            <h1 class="page-header__title">Moderation Status</h1>
            <p class="page-header__subtitle">Track submitted novels and chapters.</p>
        </div>
    </div>

    <div class="tabs">
        <a href="/Publish/Moderation?tab=novels" class="tab @(Model.Tab == "novels" ? "active" : "")">Novels</a>
        <a href="/Publish/Moderation?tab=chapters" class="tab @(Model.Tab == "chapters" ? "active" : "")">Chapters</a>
    </div>

    <div class="publish-table-card">
        <table class="table publish-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>Reviewer Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><span class="font-medium">@item.Title</span></td>
                        <td>@item.Type</td>
                        <td>@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="status-badge status-@item.Status.ToLowerInvariant()">@item.Status</span></td>
                        <td class="text-body-sm text-mute">@(item.ReviewerNotes ?? "No notes")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
