@page "Volumes/{volumeId:int}/Chapters/Create"
@model litnovel_frontend.Pages.Publish.ChapterCreateModel
@{
    ViewData["Title"] = "Tạo chương";
}

<div class="publish-editor-shell">
    <form method="post" class="publish-editor">
        <div class="publish-editor-bar">
            <div class="breadcrumb">
                <a asp-page="/Publish/Index">Truyện của tôi</a><span class="breadcrumb__sep">/</span>
                <a asp-page="/Publish/Manage" asp-route-id="@Model.Novel.Id">@Model.Novel.Title</a><span class="breadcrumb__sep">/</span>
                <a asp-page="/Publish/Chapters" asp-route-volumeId="@Model.Volume.Id" asp-route-novelId="@Model.Novel.Id">@Model.Volume.Title</a>
            </div>
            <div class="publish-editor-fields">
                <input class="form-input publish-chapter-number" asp-for="Input.ChapterNumber" type="number" min="1" />
                <input class="form-input" asp-for="Input.Title" maxlength="200" placeholder="Tiêu đề chương" />
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <textarea class="hidden" asp-for="Input.Content" data-rich-editor-output></textarea>
        <div class="publish-rich-editor" data-rich-editor>
            <div class="publish-rich-toolbar" aria-label="Thanh định dạng chương">
                <select class="form-select form-input-sm publish-rich-format" data-rich-format title="Kiểu văn bản">
                    <option value="p">Đoạn văn</option>
                    <option value="h2">Tiêu đề</option>
                    <option value="h3">Tiêu đề phụ</option>
                    <option value="blockquote">Trích dẫn</option>
                </select>
                <button type="button" class="btn-icon" data-rich-command="bold" title="In đậm"><strong>B</strong></button>
                <button type="button" class="btn-icon" data-rich-command="italic" title="In nghiêng"><em>I</em></button>
                <button type="button" class="btn-icon" data-rich-command="underline" title="Gạch chân"><u>U</u></button>
                <button type="button" class="btn-icon" data-rich-command="insertUnorderedList" title="Danh sách gạch đầu dòng">•</button>
                <button type="button" class="btn-icon" data-rich-command="insertOrderedList" title="Danh sách đánh số">1.</button>
                <button type="button" class="btn-icon" data-rich-command="justifyLeft" title="Căn trái">L</button>
                <button type="button" class="btn-icon" data-rich-command="justifyCenter" title="Căn giữa">C</button>
                <button type="button" class="btn-icon" data-rich-command="justifyRight" title="Căn phải">R</button>
                <button type="button" class="btn-icon" data-rich-command="undo" title="Hoàn tác">↶</button>
                <button type="button" class="btn-icon" data-rich-command="redo" title="Làm lại">↷</button>
            </div>
            <div class="publish-editor-area publish-rich-surface" contenteditable="true" data-rich-editor-surface aria-label="Nội dung chương">@Html.Raw(Model.Input.Content)</div>
        </div>

        <div class="publish-editor-bottom">
            <div class="publish-editor-meta">
                <span><span data-rich-word-count>@Model.WordCount</span> từ</span>
                <label class="form-label">Ngày phát hành</label>
                <input class="form-input" asp-for="Input.ReleaseDate" type="datetime-local" />
            </div>
            <div class="publish-actions">
                <a asp-page="/Publish/Chapters" asp-route-volumeId="@Model.Volume.Id" asp-route-novelId="@Model.Novel.Id" class="btn btn-secondary">Hủy</a>
                <button class="btn btn-secondary" type="submit">Lưu bản nháp</button>
                <button class="btn btn-primary" type="submit" name="submit" value="true">Gửi duyệt</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/publish-editor.js" asp-append-version="true"></script>
}
