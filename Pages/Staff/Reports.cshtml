@page
@model litnovel_frontend.Pages.Staff.ReportsModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Báo cáo vi phạm"; }
@section Sidebar { <partial name="_StaffSidebar" /> }
<!-- SCR-43: Reports Center -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        @TempData["SuccessMessage"]
    </div>
}
<div class="page-header">
    <div>
        <h1 class="page-header__title"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> Báo cáo vi phạm</h1>
    </div>
    <div class="filter-bar">
        <div class="filter-group">
            <span class="filter-label">Trạng thái:</span>
            <a href="?status=Pending"  class="btn btn-sm @(Model.StatusFilter == "Pending"  ? "btn-primary" : "btn-secondary")">Chờ xử lý (@Model.PendingCount)</a>
            <a href="?status=Resolved" class="btn btn-sm @(Model.StatusFilter == "Resolved" ? "btn-primary" : "btn-secondary")">Đã xử lý</a>
            <a href="?status=Rejected" class="btn btn-sm @(Model.StatusFilter == "Rejected" ? "btn-primary" : "btn-secondary")">Đã bác bỏ</a>
        </div>
    </div>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Loại</th>
                <th>Đối tượng</th>
                <th>Lý do báo cáo</th>
                <th>Người báo cáo</th>
                <th>Trạng thái</th>
                <th>Ngày gửi</th>
                <th class="col-actions">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reports)
            {
                <tr>
                    <td><span class="badge @(r.Kind == "Novel" ? "badge-primary" : "badge-secondary")">@r.Kind</span></td>
                    <td class="text-body-sm font-medium">
                        @if (r.Kind == "Novel")
                        { @(r.TargetNovel?.Title ?? "—") }
                        else
                        { @(r.TargetUser?.Username ?? "—") }
                    </td>
                    <td><span class="badge badge-secondary">@r.ReportType</span></td>
                    <td class="text-body-sm">@r.Reporter?.Username</td>
                    <td><span class="status-badge status-@r.Status.ToLower()">@DisplayText.Status(r.Status)</span></td>
                    <td class="text-caption text-mute">@DisplayDateTime.Format(r.CreatedAt, "dd/MM HH:mm")</td>
                    <td class="col-actions">
                        <a href="/Staff/ReportDetail?id=@r.Id&kind=@r.Kind" class="btn btn-secondary btn-sm">Xử lý</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Reports.Any())
{
    <div class="empty-state">
        <div class="empty-state__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="empty-state__title">Không có báo cáo nào</div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?page=@i&kind=@Model.KindFilter&status=@Model.StatusFilter"
               class="pagination__item @(i == Model.Page ? "active" : "")">@i</a>
        }
    </div>
}

