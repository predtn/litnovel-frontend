@page
@model litnovel_frontend.Pages.Staff.ReportDetailModel
@{
    Layout = "_LayoutDashboard";
    var kindLabel = DisplayText.ReportKind(Model.Report?.Kind ?? Model.Kind);
    ViewData["Title"] = $"Chi tiết báo cáo · {kindLabel}";
}
@section Sidebar { <partial name="_StaffSidebar" /> }
<!-- SCR-44: Report Detail -->
<div class="page-header">
    <div>
        <a href="/Staff/Reports" class="btn btn-secondary btn-sm">← Quay lại</a>
        <h1 class="page-header__title mt-sm">Chi tiết báo cáo #@Model.Report?.Id</h1>
        <p class="page-header__subtitle">
            @(Model.Report?.Kind == "Novel" ? "Báo cáo vi phạm về tiểu thuyết" : "Báo cáo vi phạm về người dùng")
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ActionMessage))
{
    <div class="alert alert-danger">@Model.ActionMessage</div>
}

@if (Model.Report != null)
{
    var r = Model.Report;
    <div class="review-grid">
        <div class="review-main">
            <div class="card">
                <div class="card__header">
                    <div>
                        <span class="badge @(r.Kind == "Novel" ? "badge-primary" : "badge-secondary") mr-xs">
                            @(r.Kind == "Novel" ? "Báo cáo tiểu thuyết" : "Báo cáo người dùng")
                        </span>
                        <span class="badge badge-secondary">@DisplayText.ReportType(r.ReportType)</span>
                    </div>
                    <span class="status-badge status-@r.Status.ToLower()">@DisplayText.Status(r.Status)</span>
                </div>
                <div class="card__body">
                    <div class="meta-grid">
                        <div class="meta-item">
                            <span class="meta-label">Loại báo cáo</span>
                            <span class="meta-value font-medium">
                                @(r.Kind == "Novel" ? "Tiểu thuyết" : "Người dùng")
                            </span>
                        </div>
                        @if (r.Kind == "Novel")
                        {
                            <div class="meta-item">
                                <span class="meta-label">Tiểu thuyết bị báo cáo</span>
                                <span class="meta-value font-medium">@(r.TargetNovel?.Title ?? "—")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Tác giả</span>
                                <span class="meta-value">@(r.TargetNovel?.Author?.Username ?? "—")</span>
                            </div>
                            @if (r.TargetChapter != null)
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Chương liên quan</span>
                                    <span class="meta-value">Ch.@r.TargetChapter.ChapterNumber — @r.TargetChapter.Title</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="meta-item">
                                <span class="meta-label">Người dùng bị báo cáo</span>
                                <span class="meta-value font-medium">@(r.TargetUser?.Username ?? "—")</span>
                            </div>
                            @if (r.TargetComment != null)
                            {
                                <div class="meta-item" style="grid-column:1 / -1;">
                                    <span class="meta-label">Bình luận bị báo cáo</span>
                                    <span class="meta-value">@r.TargetComment.Content</span>
                                </div>
                            }
                        }
                        <div class="meta-item">
                            <span class="meta-label">Người báo cáo</span>
                            <span class="meta-value">@r.Reporter?.Username</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Ngày gửi</span>
                            <span class="meta-value">@DisplayDateTime.Format(r.CreatedAt, "dd/MM/yyyy HH:mm")</span>
                        </div>
                        @if (r.ProcessedBy != null)
                        {
                            <div class="meta-item">
                                <span class="meta-label">Xử lý bởi</span>
                                <span class="meta-value">@r.ProcessedBy.Username</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(r.Description))
                    {
                        <div class="detail-section mt-md">
                            <h4 class="detail-section__title">Nội dung báo cáo</h4>
                            <p class="detail-section__content">@r.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(r.ActionTaken) || !string.IsNullOrEmpty(r.ResolutionNotes))
                    {
                        <div class="detail-section mt-md resolution-section">
                            <h4 class="detail-section__title">Kết quả xử lý</h4>
                            @if (!string.IsNullOrEmpty(r.ActionTaken))
                            {
                                <div class="mb-xs"><strong>Hành động:</strong> @r.ActionTaken</div>
                            }
                            @if (!string.IsNullOrEmpty(r.ResolutionNotes))
                            {
                                <div><strong>Ghi chú:</strong> @r.ResolutionNotes</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (r.Status == "Pending")
        {
            <div class="review-sidebar">

                <div class="card action-card">
                    <div class="card__header"><h3 class="card__title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Xử lý báo cáo</h3></div>
                    <div class="card__body">
                        <button class="btn btn-primary w-full mb-sm"
                                onclick="document.getElementById('resolveModal').showModal()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Xử lý toàn diện
                        </button>
                    </div>
                </div>
            </div>

            <dialog id="resolveModal" class="modal-dialog" style="width: 500px; max-width: 90vw;">
                <form method="post" class="modal-content">
                    <div class="modal-header"><h3>Xử lý báo cáo (Unified Resolution)</h3></div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="hidden" name="kind" value="@r.Kind" />
                        <input type="hidden" name="targetUserId" value="@(r.Kind == "User" ? r.TargetUser?.Id : r.TargetNovel?.Author?.Id)" />
                        
                        <div class="form-group mb-md">
                            <label class="form-label">1. Kết quả xử lý báo cáo (Bắt buộc)</label>
                            <select name="action" class="form-control" required>
                                <option value="Resolve">Chấp nhận báo cáo (Resolve)</option>
                                <option value="Reject">Bác bỏ báo cáo (Reject)</option>
                            </select>
                        </div>

                        <div class="form-group mb-md">
                            <label class="form-label">2. Xử lý nội dung vi phạm</label>
                            @if ((r.Kind == "User" && r.TargetComment != null) || (r.Kind == "Novel" && r.TargetChapter != null))
                            {
                                <label class="d-flex align-items-center gap-xs" style="cursor:pointer">
                                    <input type="checkbox" name="takeDownContent" value="true" />
                                    <span>
                                        @if (r.Kind == "User")
                                        { <strong>Xóa bình luận vi phạm (#@r.TargetComment!.Id)</strong> }
                                        else
                                        { <strong>Gỡ chương vi phạm về Draft: "@r.TargetChapter!.Title"</strong> }
                                    </span>
                                </label>
                            }
                            else
                            {
                                <span class="text-muted text-sm">Không có nội dung cụ thể để xử lý tự động.</span>
                            }
                        </div>

                        <div class="form-group mb-md">
                            <label class="form-label">3. Xử phạt người dùng (Tùy chọn)</label>
                            <label class="d-flex align-items-center gap-xs mb-xs" style="cursor:pointer">
                                <input type="checkbox" name="warnUser" value="true" />
                                <span>Gửi cảnh báo (Warn User)</span>
                            </label>
                            <label class="d-flex align-items-center gap-xs" style="cursor:pointer">
                                <input type="checkbox" name="banUser" value="true" />
                                <span class="text-danger">Khóa tài khoản (Ban User)</span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Ghi chú & Lý do (Bắt buộc)</label>
                            <textarea name="resolutionNotes" class="form-control" rows="3" required placeholder="Lý do này sẽ được dùng cho Ghi chú báo cáo, Cảnh báo và Khóa tài khoản (nếu có)..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="document.getElementById('resolveModal').close()">Hủy</button>
                        <button type="submit" class="btn btn-primary">Xác nhận thực thi</button>
                    </div>
                </form>
            </dialog>
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const actionSelect = document.querySelector('select[name="action"]');
            if (actionSelect) {
                actionSelect.addEventListener('change', function () {
                    const isReject = this.value === 'Reject';
                    
                    // Disable and uncheck takeDownContent
                    const takeDownCb = document.querySelector('input[name="takeDownContent"]');
                    if (takeDownCb) {
                        takeDownCb.disabled = isReject;
                        if (isReject) takeDownCb.checked = false;
                    }
                    
                    // Disable and uncheck warnUser
                    const warnUserCb = document.querySelector('input[name="warnUser"]');
                    if (warnUserCb) {
                        warnUserCb.disabled = isReject;
                        if (isReject) warnUserCb.checked = false;
                    }
                    
                    // Disable and uncheck banUser
                    const banUserCb = document.querySelector('input[name="banUser"]');
                    if (banUserCb) {
                        banUserCb.disabled = isReject;
                        if (isReject) banUserCb.checked = false;
                    }
                });
            }
        });
    </script>
}
