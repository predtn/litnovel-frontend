@page
@model litnovel_frontend.Pages.Staff.DashboardModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Kiểm duyệt";
    ViewData["ActiveNav"] = "staff";
}

@section Sidebar {
    <div class="sidebar__section-label">Kiểm duyệt</div>
    <a href="/Staff/Dashboard" class="sidebar__link active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Tổng quan
    </a>
    <a href="/Staff/PendingNovels" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Tiểu thuyết chờ duyệt
        @if (Model.Dashboard.PendingNovels > 0) { <span class="sidebar__badge">@Model.Dashboard.PendingNovels</span> }
    </a>
    <a href="/Staff/PendingChapters" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Chương chờ duyệt
        @if (Model.Dashboard.PendingChapters > 0) { <span class="sidebar__badge">@Model.Dashboard.PendingChapters</span> }
    </a>
    <div class="sidebar__section-label">Báo cáo</div>
    <a href="/Staff/Reports" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Quản lý báo cáo
        @if (Model.Dashboard.OpenReports > 0) { <span class="sidebar__badge">@Model.Dashboard.OpenReports</span> }
    </a>
    <a href="/Staff/ModerationHistory" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        Lịch sử kiểm duyệt
    </a>
}

<!-- SCR-38: Moderation Dashboard -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Kiểm duyệt nội dung</h1>
        <p class="page-header__subtitle">Quản lý nội dung chờ duyệt và xử lý báo cáo</p>
    </div>
</div>

<!-- Stats -->
<div class="grid-3 mb-xl">
    <a href="/Staff/PendingNovels" style="text-decoration:none;">
        <div class="stat-card" style="border:1px solid var(--color-hairline); transition:box-shadow .15s;">
            <div class="stat-card__label">Tiểu thuyết chờ duyệt</div>
            <div class="stat-card__value" style="color:var(--color-warning);">@Model.Dashboard.PendingNovels</div>
            <div class="text-caption text-mute">Xem tất cả →</div>
        </div>
    </a>
    <a href="/Staff/PendingChapters" style="text-decoration:none;">
        <div class="stat-card" style="border:1px solid var(--color-hairline);">
            <div class="stat-card__label">Chương chờ duyệt</div>
            <div class="stat-card__value" style="color:var(--color-link);">@Model.Dashboard.PendingChapters</div>
            <div class="text-caption text-mute">Xem tất cả →</div>
        </div>
    </a>
    <a href="/Staff/Reports" style="text-decoration:none;">
        <div class="stat-card" style="border:1px solid var(--color-hairline);">
            <div class="stat-card__label">Báo cáo đang mở</div>
            <div class="stat-card__value" style="color:var(--color-error);">@Model.Dashboard.OpenReports</div>
            <div class="text-caption text-mute">Xem tất cả →</div>
        </div>
    </a>
</div>

<!-- Quick access cards -->
<div class="grid-2 mb-xl">
    <div class="card">
        <h3 class="text-body-sm font-semibold mb-md">🆕 Tiểu thuyết chờ duyệt gần đây</h3>
        @if (!Model.PendingNovels.Any())
        {
            <div class="text-body-sm text-mute">Không có tiểu thuyết nào chờ duyệt.</div>
        }
        else
        {
            @foreach (var novel in Model.PendingNovels.Take(5))
            {
                <div class="queue-item mb-sm">
                    <div class="queue-item__cover">📖</div>
                    <div class="queue-item__body">
                        <div class="queue-item__title">@novel.Title</div>
                        <div class="queue-item__meta">@novel.Author?.Username · @novel.UpdatedAt.ToString("dd/MM HH:mm")</div>
                    </div>
                    <div class="queue-item__actions">
                        <a href="/Staff/NovelReview?id=@novel.Id" class="btn btn-secondary btn-sm">Xem</a>
                    </div>
                </div>
            }
            <a href="/Staff/PendingNovels" class="btn btn-ghost" style="width:100%; margin-top:var(--space-sm);">Xem tất cả →</a>
        }
    </div>

    <div class="card">
        <h3 class="text-body-sm font-semibold mb-md">⚠️ Báo cáo gần đây</h3>
        @if (!Model.PendingReports.Any())
        {
            <div class="text-body-sm text-mute">Không có báo cáo nào đang chờ xử lý.</div>
        }
        else
        {
            @foreach (var report in Model.PendingReports.Take(5))
            {
                <div class="flex gap-sm items-center mb-sm" style="padding:var(--space-xs) 0; border-bottom:1px solid var(--color-hairline);">
                    <div style="flex:1; min-width:0;">
                        <div class="text-body-sm font-medium text-ink truncate">@report.TargetNovel?.Title ?? report.TargetUser?.Username ?? "—"</div>
                        <div class="text-caption text-mute">@report.ReportType · @report.Reporter?.Username</div>
                    </div>
                    <a href="/Staff/ReportDetail?id=@report.Id" class="btn btn-secondary btn-sm">Xử lý</a>
                </div>
            }
            <a href="/Staff/Reports" class="btn btn-ghost" style="width:100%; margin-top:var(--space-sm);">Xem tất cả →</a>
        }
    </div>
</div>
