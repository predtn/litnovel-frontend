@page
@model litnovel_frontend.Pages.Staff.PendingChaptersModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Chương chờ duyệt"; }
@section Sidebar { <partial name="_StaffSidebar" /> }
<!-- SCR-41: Pending Chapters -->
<div class="page-header">
    <div>
        <h1 class="page-header__title"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> Chương chờ duyệt</h1>
        <p class="page-header__subtitle">@Model.TotalElements mục cần xem xét</p>
    </div>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Chương</th>
                <th>Tiểu thuyết</th>
                <th>Tác giả</th>
                <th>Ngày gửi</th>
                <th class="col-actions">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Chapters)
            {
                <tr>
                    <td>
                        <div class="text-body-sm font-medium">Chương @c.ChapterNumber</div>
                        <div class="text-caption text-mute">@c.Title</div>
                    </td>
                    <td>
                        <div class="text-body-sm font-medium">@c.NovelTitle</div>
                    </td>
                    <td class="text-body-sm">@c.AuthorUsername</td>
                    <td class="text-caption text-mute">@DisplayDateTime.Format(c.SubmittedAt, "dd/MM HH:mm")</td>
                    <td class="col-actions">
                        <a href="/Staff/ChapterReview?id=@c.Id" class="btn btn-primary btn-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Xem xét</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Chapters.Any())
{
    <div class="empty-state">
        <div class="empty-state__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="empty-state__title">Không có chương nào chờ duyệt</div>
        <div class="empty-state__subtitle">Tất cả chương đã được kiểm duyệt</div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?page=@i" class="pagination__item @(i == Model.Page ? "active" : "")">@i</a>
        }
    </div>
}

