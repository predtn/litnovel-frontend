@page
@model litnovel_frontend.Pages.Staff.PendingChaptersModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Chương chờ duyệt"; }
@section Sidebar {
    <a href="/Staff/Dashboard" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
        Tổng quan
    </a>
    <a href="/Staff/PendingNovels" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Tiểu thuyết chờ duyệt
        @if (Model.Dashboard.PendingNovels > 0) { <span class="sidebar__badge">@Model.Dashboard.PendingNovels</span> }
    </a>
    <a href="/Staff/PendingChapters" class="sidebar__link active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Chương chờ duyệt
        @if (Model.Dashboard.PendingChapters > 0) { <span class="sidebar__badge">@Model.Dashboard.PendingChapters</span> }
    </a>
    <a href="/Staff/Reports" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Báo cáo vi phạm
        @if (Model.Dashboard.OpenReports > 0) { <span class="sidebar__badge">@Model.Dashboard.OpenReports</span> }
    </a>
    <a href="/Staff/ModerationHistory" class="sidebar__link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Lịch sử kiểm duyệt
    </a>
}
<!-- SCR-41: Pending Chapters -->
<div class="page-header">
    <div>
        <h1 class="page-header__title"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> Chương chờ duyệt</h1>
        <p class="page-header__subtitle">@Model.TotalElements mục cần xem xét</p>
    </div>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Chương</th>
                <th>Tiểu thuyết</th>
                <th>Tác giả</th>
                <th>Ngày gửi</th>
                <th class="col-actions">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Chapters)
            {
                <tr>
                    <td>
                        <div class="text-body-sm font-medium">Chương @c.ChapterNumber</div>
                        <div class="text-caption text-mute">@c.Title</div>
                    </td>
                    <td>
                        <div class="text-body-sm font-medium">@c.NovelTitle</div>
                    </td>
                    <td class="text-body-sm">@c.AuthorUsername</td>
                    <td class="text-caption text-mute">@DisplayDateTime.Format(c.SubmittedAt, "dd/MM HH:mm")</td>
                    <td class="col-actions">
                        <a href="/Staff/ChapterReview?id=@c.Id" class="btn btn-primary btn-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Xem xét</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Chapters.Any())
{
    <div class="empty-state">
        <div class="empty-state__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="empty-state__title">Không có chương nào chờ duyệt</div>
        <div class="empty-state__subtitle">Tất cả chương đã được kiểm duyệt</div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?page=@i" class="pagination__item @(i == Model.Page ? "active" : "")">@i</a>
        }
    </div>
}
