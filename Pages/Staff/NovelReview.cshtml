@page
@model litnovel_frontend.Pages.Staff.NovelReviewModel
@{ Layout = "_LayoutDashboard"; ViewData["Title"] = "Xem xét tiểu thuyết"; }
@section Sidebar { <partial name="_StaffSidebar" /> }
<!-- SCR-40: Novel Review -->
<div class="page-header">
    <div>
        <a href="/Staff/PendingNovels" class="btn btn-secondary btn-sm">← Quay lại</a>
        <h1 class="page-header__title mt-sm">Xem xét tiểu thuyết</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ActionMessage))
{
    <div class="alert alert-danger">@Model.ActionMessage</div>
}
@if (Model.Novel != null)
{
    var n = Model.Novel;
    <div class="review-grid">
        <div class="review-main">
            <div class="card">
                <div class="card__header">
                    <h2 class="card__title">@n.Title</h2>
                    <span class="status-badge status-@n.Status.ToLower()">@DisplayText.Status(n.Status)</span>
                </div>
                <div class="card__body">
                    @if (!string.IsNullOrEmpty(n.Description))
                    {
                        <p class="novel-description">@n.Description</p>
                    }
                    <div class="meta-grid">
                        <div class="meta-item"><span class="meta-label">Tác giả</span><span class="meta-value">@n.AuthorUsername</span></div>
                        <div class="meta-item"><span class="meta-label">Thể loại</span><span class="meta-value">@(n.CategoryName ?? "—")</span></div>
                        <div class="meta-item"><span class="meta-label">Tổng chương</span><span class="meta-value">@n.TotalChapters</span></div>
                        <div class="meta-item"><span class="meta-label">Lượt xem</span><span class="meta-value">@n.ViewCount</span></div>
                        <div class="meta-item"><span class="meta-label">Ngày tạo</span><span class="meta-value">@DisplayDateTime.Format(n.CreatedAt, "dd/MM/yyyy")</span></div>
                        <div class="meta-item"><span class="meta-label">Cập nhật</span><span class="meta-value">@DisplayDateTime.Format(n.UpdatedAt, "dd/MM/yyyy HH:mm")</span></div>
                    </div>
                    @if (n.Tags.Any())
                    {
                        <div class="tags-row mt-sm">
                            @foreach (var tag in n.Tags)
                            {
                                <span class="badge badge-secondary">@tag</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Volume & Chapter List -->
            @foreach (var vol in n.Volumes)
            {
                <div class="volume-block">
                    <div class="volume-header">
                        <span class="volume-number">Tập @vol.VolumeNumber</span>
                        <span class="volume-title">@vol.Title</span>
                        <span class="badge badge-secondary">@vol.Chapters.Count chương</span>
                    </div>
                    <div class="chapter-list">
                        @foreach (var ch in vol.Chapters)
                        {
                            <div class="chapter-item">
                                <span class="chapter-num">Chương @ch.ChapterNumber</span>
                                <span class="chapter-title">@ch.Title</span>
                                <span class="status-badge status-@ch.Status.ToLower() badge-sm">@DisplayText.Status(ch.Status)</span>
                                <a href="/Staff/ChapterReview?id=@ch.Id" class="btn btn-secondary btn-xs">Xem</a>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (!n.Volumes.Any())
            {
                <div class="empty-state">
                    <div class="empty-state__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
                    <div class="empty-state__title">Chưa có tập/chương nào</div>
                </div>
            }
        </div>

        <!-- Right sidebar: cover + action panel -->
        <div class="review-sidebar">
            @if (!string.IsNullOrEmpty(n.CoverImage))
            {
                <div class="card">
                    <img src="@n.CoverImage" class="novel-cover-full" alt="Cover" />
                </div>
            }

            <div class="card action-card">
                <div class="card__header"><h3 class="card__title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Hành động kiểm duyệt</h3></div>
                <div class="card__body">
                    <!-- Approve -->
                    <form method="post">
                        <input type="hidden" name="id" value="@n.Id" />
                        <input type="hidden" name="action" value="Approve" />
                        <button type="submit" class="btn btn-success w-full mb-sm"
                                onclick="return confirm('Phê duyệt tiểu thuyết này?')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Phê duyệt (Approve)
                        </button>
                    </form>
                    <!-- Reject -->
                    <button type="button" class="btn btn-danger w-full mb-sm"
                            onclick="document.getElementById('rejectModal').showModal()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Từ chối (Reject)
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <dialog id="rejectModal" class="modal-dialog">
        <form method="post" class="modal-content">
            <div class="modal-header"><h3>Từ chối tiểu thuyết</h3></div>
            <div class="modal-body">
                <input type="hidden" name="id" value="@n.Id" />
                <input type="hidden" name="action" value="Reject" />
                <label class="form-label">Lý do từ chối *</label>
                <textarea name="reason" class="form-control" rows="4" placeholder="Nhập lý do từ chối..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('rejectModal').close()">Hủy</button>
                <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
            </div>
        </form>
    </dialog>


}
else
{
    <div class="empty-state"><div class="empty-state__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div><div class="empty-state__title">Không tìm thấy tiểu thuyết</div></div>
}

