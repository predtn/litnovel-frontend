@page "/Profile/{userId:int}"
@model litnovel_frontend.Pages.Profile.PublicModel
@{
    ViewData["Title"] = Model.User?.Username ?? "Hồ sơ";
    var u = Model.User;
    var joinedAt = u?.JoinedAt == default ? u?.CreatedAt : u?.JoinedAt;
}
<!-- SCR-07: Public Profile -->
<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);">
    @if (u == null)
    {
        <div class="empty-state"><div class="empty-state__icon">🔍</div><div class="empty-state__title">Không tìm thấy người dùng</div></div>
        return;
    }
    <!-- Profile header -->
    <div class="card mb-xl public-profile-header">
        @if (!string.IsNullOrEmpty(u.Avatar))
        { <img src="@u.Avatar" class="avatar avatar-2xl public-profile-header__avatar" /> }
        else
        { <div class="avatar-placeholder avatar-2xl public-profile-header__avatar">@(u.Username.Substring(0,1).ToUpper())</div> }
        <div class="public-profile-header__body">
            <div class="profile-title-row public-profile-header__title-row">
                <h1 class="text-display-sm">@u.Username</h1>
                <span class="profile-meta-badge role-@u.Role.ToLower()">@RoleLabel(u.Role)</span>
                <span class="profile-meta-badge status-@u.Status.ToLower()">@UserStatusLabel(u.Status)</span>
                @if (u.Badges.Any())
                {
                    <span class="public-profile-header__mini-badges">
                        @foreach (var badge in u.Badges)
                        {
                            <span class="profile-mini-badge" style="--badge-color:@BadgeColor(badge.Color);" title="@badge.Name">@badge.Name</span>
                        }
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(u.Bio)) { <p class="text-body-sm text-body mb-md">@u.Bio</p> }
            <div class="public-profile-header__stats">
                <div><span class="text-display-sm font-semibold">@u.Reputation</span> <span class="text-caption text-mute">Reputation</span></div>
                <div><span class="text-display-sm font-semibold">@u.Stats.NovelsCreated</span> <span class="text-caption text-mute">Truyện</span></div>
                <div><span class="text-display-sm font-semibold">@u.Stats.ChaptersPublished</span> <span class="text-caption text-mute">Chương</span></div>
            </div>
            <div class="text-caption text-mute">Tham gia từ @DisplayDateTime.Format(joinedAt, "dd/MM/yyyy")</div>
        </div>
    </div>

    <!-- Badges -->
    <div class="card mb-xl">
        <div class="profile-section-header">
            <h2 class="text-body-sm font-semibold">Huy hiệu</h2>
            <span class="text-caption text-mute">@u.Badges.Count huy hiệu</span>
        </div>
        @if (u.Badges.Any())
        {
            <div class="profile-badge-grid">
                @foreach (var b in u.Badges)
                {
                    <div class="profile-badge-card" style="--badge-color:@BadgeColor(b.Color);" title="@b.Name">
                        <div class="profile-badge-card__icon">
                            @if (IsImageIcon(b.Icon))
                            {
                                <img src="@b.Icon" alt="" />
                            }
                            else if (!string.IsNullOrWhiteSpace(b.Icon))
                            {
                                <span>@b.Icon</span>
                            }
                            else
                            {
                                <span>@Initials(b.Name)</span>
                            }
                        </div>
                        <div class="profile-badge-card__body">
                            <div class="profile-badge-card__name">@b.Name</div>
                            @if (b.EarnedAt != default)
                            {
                                <div class="profile-badge-card__meta">Nhận @DisplayDateTime.Format(b.EarnedAt, "dd/MM/yyyy")</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state empty-state--compact">
                <div class="empty-state__title">Chưa có huy hiệu nào</div>
            </div>
        }
    </div>

    @if (!Model.IsOwnProfile)
    {
        <!-- Report user -->
        <div class="card mb-xl">
            <h2 class="text-body-sm font-semibold mb-md">Báo cáo người dùng</h2>
            <form method="post" asp-page-handler="Report" class="auth-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Loại báo cáo</label>
                    <select name="ReportType" class="form-input">
                        <option value="Harassment">Harassment</option>
                        <option value="Spam">Spam</option>
                        <option value="Inappropriate">Inappropriate</option>
                        <option value="Copyright">Copyright</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-textarea" maxlength="1000" placeholder="Mô tả ngắn gọn lý do báo cáo..."></textarea>
                </div>
                <button type="submit" class="btn btn-secondary" style="border-radius:var(--radius-sm);">Gửi báo cáo</button>
            </form>
        </div>
    }

    <!-- Novels by this author -->
    <h2 class="text-display-sm mb-lg">Tiểu thuyết của @u.Username</h2>
    @if (!Model.Novels.Any())
    { <div class="empty-state"><div class="empty-state__icon">✎</div><div class="empty-state__title">Chưa có truyện nào</div></div> }
    else
    {
        <div class="grid-4" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));">
            @foreach (var n in Model.Novels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(n.Slug) ? n.Slug : n.Id.ToString();
                <a href="/Novels/@novelUrl" class="novel-card">
                    @if (!string.IsNullOrWhiteSpace(n.CoverImage))
                    {
                        <img class="novel-card__cover" src="@n.CoverImage" alt="@n.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="novel-card__cover-placeholder">📖</div>
                    }
                    <div class="novel-card__body">
                        <div class="novel-card__title">@n.Title</div>
                        <div class="profile-novel-meta">
                            <span class="status-badge status-@n.Status.ToLowerInvariant()">@StatusLabel(n.Status)</span>
                        </div>
                        <div class="profile-novel-details">
                            <div><span>Số volume: @n.TotalVolumes</span></div>
                            <div><span>Số chương: @n.TotalChapters</span></div>
                            <div><span>Đánh giá: ★ @n.RatingAverage.ToString("0.0")</span></div>
                            <div><span>Cập nhật: @DisplayDateTime.Format(n.UpdatedAt, "dd/MM/yyyy")</span></div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@functions {
    private static bool IsImageIcon(string? icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return false;
        return Uri.TryCreate(icon, UriKind.Absolute, out _)
            || icon.StartsWith("/", StringComparison.Ordinal)
            || icon.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase);
    }

    private static string StatusLabel(string? status) => DisplayText.Status(status);

    private static string UserStatusLabel(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "online" => "Online",
        "offline" => "Offline",
        "banned" => "Banned",
        _ => string.IsNullOrWhiteSpace(status) ? "Offline" : status
    };

    private static string RoleLabel(string? role) => role?.Trim().ToLowerInvariant() switch
    {
        "admin" => "Admin",
        "staff" => "Staff",
        "user" => "User",
        _ => string.IsNullOrWhiteSpace(role) ? "User" : role
    };

    private static string Initials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "H";
        return value.Trim().Substring(0, 1).ToUpperInvariant();
    }

    private static string BadgeColor(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "#8b5cf6" : value;
    }
}
