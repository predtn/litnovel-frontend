@page
@model litnovel_frontend.Pages.Profile.ChangePasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);max-width:480px;">
    <div class="breadcrumb"><a href="/Profile">Hồ sơ</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">Đổi mật khẩu</span></div>
    @if (TempData["Success"] is string ok) { <div class="alert alert-success mt-md alert-auto-close">@ok</div> }
    @if (TempData["Error"]   is string er) { <div class="alert alert-error mt-md">@er</div> }
    <div class="card mt-md">
        <h1 class="text-display-sm mb-xl">Đổi mật khẩu</h1>
        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Mật khẩu hiện tại</label>
                <input name="currentPassword" type="password" class="form-input" placeholder="••••••••" required />
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu mới</label>
                <input name="newPassword" type="password" class="form-input" placeholder="Tối thiểu 8 ký tự" required />
            </div>
            <div class="form-group">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <input name="confirmPassword" type="password" class="form-input" placeholder="Nhập lại" required />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;height:44px;border-radius:var(--radius-sm);">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>
