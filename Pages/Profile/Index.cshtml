@page
@model litnovel_frontend.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var u = Model.UserDetail;
}
<!-- SCR-06: User Profile (Edit) -->
<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);max-width:720px;">
    <div class="breadcrumb"><a href="/">Trang chủ</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">Hồ sơ cá nhân</span></div>
    <div class="card mt-md">
        <div class="profile-edit-layout">
            <!-- Avatar -->
            <div class="profile-edit-sidebar">
                @if (!string.IsNullOrEmpty(u?.Avatar))
                {
                    <img src="@u.Avatar" class="avatar avatar-2xl profile-edit-avatar" data-avatar-preview />
                    <div class="avatar-placeholder avatar-2xl profile-edit-avatar hidden" data-avatar-placeholder>@(u?.Username?.Substring(0, 1).ToUpper() ?? "U")</div>
                }
                else
                {
                    <img src="" class="avatar avatar-2xl profile-edit-avatar hidden" data-avatar-preview />
                    <div class="avatar-placeholder avatar-2xl profile-edit-avatar" data-avatar-placeholder>@(u?.Username?.Substring(0, 1).ToUpper() ?? "U")</div>
                }
                <div class="text-body-sm font-medium">@u?.Username</div>
                <div class="profile-header-badges mt-xs">
                    <span class="profile-meta-badge role-@u?.Role.ToLower()">@u?.Role</span>
                </div>
            </div>
            <!-- Form -->
            <form method="post" class="auth-form profile-edit-form" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="avatar" value="@u?.Avatar" />
                <div class="form-group">
                    <label class="form-label">Tên đăng nhập</label>
                    <input class="form-input" value="@u?.Username" disabled style="background:var(--color-canvas-soft);" />
                    <span class="form-hint">Không thể thay đổi tên đăng nhập</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-input" value="@u?.Email" disabled style="background:var(--color-canvas-soft);" />
                    <span class="form-hint">Email không thể thay đổi tại đây</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Tiểu sử</label>
                    <textarea name="bio" class="form-textarea" placeholder="Giới thiệu về bản thân...">@u?.Bio</textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="AvatarFile">Ảnh đại diện</label>
                    <label class="publish-upload">
                        <input asp-for="AvatarFile" type="file" accept="image/png,image/jpeg,image/webp" data-avatar-input />
                        <span class="publish-upload__text">Tải lên JPG, PNG hoặc WEBP</span>
                    </label>
                    <span class="form-hint">Tối đa 2MB. Bỏ trống nếu muốn giữ ảnh hiện tại.</span>
                    <span class="form-error" asp-validation-for="AvatarFile"></span>
                </div>
                <button type="submit" class="btn btn-primary" style="border-radius:var(--radius-sm);">Lưu thay đổi</button>
            </form>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid-4 mt-xl" style="grid-template-columns:repeat(4,1fr);">
        <div class="stat-card"><div class="stat-card__label">Tổng truyện</div><div class="stat-card__value">@u?.Stats.NovelsCreated</div></div>
        <div class="stat-card"><div class="stat-card__label">Tổng chương</div><div class="stat-card__value">@u?.Stats.ChaptersPublished</div></div>
        <div class="stat-card"><div class="stat-card__label">Yêu thích</div><div class="stat-card__value">@u?.Stats.FavoritesCount</div></div>
        <div class="stat-card"><div class="stat-card__label">Bình luận</div><div class="stat-card__value">@u?.Stats.CommentsCount</div></div>
    </div>

    <!-- Badges -->
    <div class="card mt-xl">
        <div class="profile-section-header">
            <h3 class="text-body-sm font-semibold">Huy hiệu đạt được</h3>
            <span class="text-caption text-mute">@(u?.Badges.Count ?? 0) huy hiệu</span>
        </div>
        @if (u?.Badges.Any() == true)
        {
            <div class="profile-badge-grid">
                @foreach (var b in u.Badges)
                {
                    <div class="profile-badge-card" style="--badge-color:@BadgeColor(b.Color);" title="@b.Name">
                        <div class="profile-badge-card__icon">
                            @if (IsImageIcon(b.Icon))
                            {
                                <img src="@b.Icon" alt="" />
                            }
                            else if (!string.IsNullOrWhiteSpace(b.Icon))
                            {
                                <span>@b.Icon</span>
                            }
                            else
                            {
                                <span>@Initials(b.Name)</span>
                            }
                        </div>
                        <div class="profile-badge-card__body">
                            <div class="profile-badge-card__name">@b.Name</div>
                            @if (b.EarnedAt != default)
                            {
                                <div class="profile-badge-card__meta">Nhận @DisplayDateTime.Format(b.EarnedAt, "dd/MM/yyyy")</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state empty-state--compact">
                <div class="empty-state__title">Chưa có huy hiệu nào</div>
            </div>
        }
    </div>

    <!-- Links -->
    <div class="flex gap-sm mt-xl">
        <a href="/Profile/ChangePassword" class="btn btn-secondary" style="border-radius:var(--radius-sm);">Đổi mật khẩu</a>
        <a href="/Profile/@u?.Id" class="btn btn-ghost">Xem trang công khai →</a>
    </div>
</div>

@functions {
    private static bool IsImageIcon(string? icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return false;
        return Uri.TryCreate(icon, UriKind.Absolute, out _)
            || icon.StartsWith("/", StringComparison.Ordinal)
            || icon.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase);
    }

    private static string Initials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "H";
        return value.Trim().Substring(0, 1).ToUpperInvariant();
    }

    private static string BadgeColor(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "#8b5cf6" : value;
    }
}

@section Scripts {
    <script>
        (() => {
            const input = document.querySelector('[data-avatar-input]');
            const preview = document.querySelector('[data-avatar-preview]');
            const placeholder = document.querySelector('[data-avatar-placeholder]');
            let objectUrl;

            if (!input || !preview) return;

            input.addEventListener('change', () => {
                const file = input.files && input.files[0];
                if (objectUrl) {
                    URL.revokeObjectURL(objectUrl);
                    objectUrl = null;
                }

                if (!file) return;

                objectUrl = URL.createObjectURL(file);
                preview.src = objectUrl;
                preview.classList.remove('hidden');
                placeholder?.classList.add('hidden');
            });
        })();
    </script>
}
