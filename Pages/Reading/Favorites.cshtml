@page
@model litnovel_frontend.Pages.Reading.FavoritesModel
@{
    ViewData["Title"] = "Truyện yêu thích";
}

<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);">
    <div class="page-header">
        <h1 class="page-header__title">Truyện yêu thích</h1>
        <p class="page-header__subtitle">@Model.Novels.Count truyện</p>
    </div>

    @if (!Model.Novels.Any())
    {
        <div class="empty-state">
            <div class="empty-state__icon">♡</div>
            <div class="empty-state__title">Chưa có truyện yêu thích</div>
            <a href="/Novels" class="btn btn-primary mt-md">Khám phá ngay</a>
        </div>
    }
    else
    {
        <div class="grid-4" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));">
            @foreach (var n in Model.Novels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(n.Slug) ? n.Slug : n.Id.ToString();
                <div class="novel-card" style="position:relative;">
                    <a href="/Novels/@novelUrl">
                        @if (!string.IsNullOrWhiteSpace(n.CoverImage))
                        {
                            <img class="novel-card__cover" src="@n.CoverImage" alt="@n.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="novel-card__cover-placeholder">📖</div>
                        }
                    </a>
                    <div class="novel-card__body">
                        <div class="novel-card__title">
                            <a href="/Novels/@novelUrl" style="color:inherit;text-decoration:none;">@n.Title</a>
                        </div>
                        <div class="novel-card__meta">
                            <span>★ @n.RatingAverage.ToString("0.0")</span>
                            <span class="status-badge status-@n.Status.ToLower()">@StatusLabel(n.Status)</span>
                        </div>
                    </div>
                    <form method="post" style="position:absolute;top:var(--space-xs);right:var(--space-xs);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="novelId" value="@n.Id" />
                        <button type="submit" class="btn-icon" title="Bỏ yêu thích" style="color:var(--color-error);background:rgba(255,255,255,.9);">♡</button>
                    </form>
                </div>
            }
        </div>
    }
</div>

@functions {
    private static string StatusLabel(string status) => status?.Trim().ToLowerInvariant() switch
    {
        "draft" => "Bản nháp",
        "pending" => "Chờ duyệt",
        "ongoing" => "Đang ra",
        "published" => "Đã xuất bản",
        "ended" => "Hoàn thành",
        "rejected" => "Bị từ chối",
        "hiatus" => "Tạm dừng",
        "locked" => "Đã khóa",
        _ => string.IsNullOrWhiteSpace(status) ? "Không rõ" : status
    };
}
