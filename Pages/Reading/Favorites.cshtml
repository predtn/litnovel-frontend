@page
@model litnovel_frontend.Pages.Reading.FavoritesModel
@{
    ViewData["Title"] = "Truyện yêu thích";
}

<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);">
    <div class="page-header">
        <h1 class="page-header__title">Truyện yêu thích</h1>
        <p class="page-header__subtitle">@Model.Novels.Count truyện</p>
    </div>

    @if (!Model.Novels.Any())
    {
        <div class="empty-state">
            <div class="empty-state__icon">♡</div>
            <div class="empty-state__title">Chưa có truyện yêu thích</div>
            <a href="/Novels" class="btn btn-primary mt-md">Khám phá ngay</a>
        </div>
    }
    else
    {
        <div class="catalog-list view-grid">
            @foreach (var n in Model.Novels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(n.Slug) ? n.Slug : n.Id.ToString();
                <div class="novel-item-card" data-novel-id="@n.Id">
                    <form method="post" style="display:contents;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="novelId" value="@n.Id" />
                        <input type="hidden" name="page" value="@Model.PageNumber" />
                        <button type="submit" class="novel-card__fav-btn active" title="Bỏ yêu thích" aria-label="Bỏ yêu thích">
                            <svg class="heart-icon" viewBox="0 0 24 24">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                        </button>
                    </form>
                    <a href="/Novels/@novelUrl" class="novel-card__cover-wrapper">
                        @if (!string.IsNullOrWhiteSpace(n.CoverImage))
                        {
                            <img class="novel-card__cover" src="@n.CoverImage" alt="@n.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="novel-card__cover-placeholder">Sách</div>
                        }
                    </a>
                    <div class="novel-card__body">
                        <div class="novel-card__header">
                            <a href="/Novels/@novelUrl" class="novel-card__title">@n.Title</a>
                            @if (n.Category != null)
                            {
                                <a href="/Novels?categoryId=@n.Category.Id&view=grid" class="novel-card__category">@n.Category.Name</a>
                            }
                        </div>
                        <div class="novel-card__author">Tác giả: <span>@n.Author?.Username</span></div>

                        @if (n.Tags != null && n.Tags.Any())
                        {
                            <div class="novel-card__tags">
                                @foreach (var tag in n.Tags.Take(8))
                                {
                                    <a href="/Novels?tagId=@tag.Id&view=grid" class="tag novel-card__tag">@tag.Name</a>
                                }
                            </div>
                        }

                        <div class="novel-card__meta">
                            <span class="novel-card__metric novel-card__metric--rated" title="Đánh giá">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
                                @n.RatingAverage.ToString("0.0")
                            </span>
                            <span class="novel-card__metric novel-card__meta-item--volumes" title="Số tập">@n.TotalVolumes tập</span>
                            <span class="novel-card__metric novel-card__meta-item--chapters" title="Số chương">@n.TotalChapters chương</span>
                            <span class="status-badge status-@n.Status.ToLowerInvariant()"><span class="status-badge__text">@StatusLabel(n.Status)</span></span>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="flex justify-center mt-xl">
                <div class="pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@PageUrl(Model.PageNumber - 1)" class="pagination__btn">←</a>
                    }
                    @foreach (var item in PaginationItems())
                    {
                        if (item.HasValue)
                        {
                            var pageNumber = item.Value;
                            <a href="@PageUrl(pageNumber)" class="pagination__btn @(pageNumber == Model.PageNumber ? "active" : "")">@pageNumber</a>
                        }
                        else
                        {
                            <span class="pagination__btn disabled">...</span>
                        }
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="@PageUrl(Model.PageNumber + 1)" class="pagination__btn">→</a>
                    }
                    <button type="button" class="pagination__btn" onclick="openModal('favoritesPageModal')" title="Chọn trang" aria-label="Chọn trang">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="4" y1="7" x2="20" y2="7"></line>
                            <line x1="4" y1="12" x2="20" y2="12"></line>
                            <line x1="4" y1="17" x2="20" y2="17"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-overlay" id="favoritesPageModal">
                <div class="modal modal-lg" role="dialog" aria-modal="true" aria-labelledby="favoritesPageModalTitle">
                    <div class="modal__header">
                        <div class="modal__title" id="favoritesPageModalTitle">Chọn trang</div>
                        <button type="button" class="modal__close" onclick="closeModal('favoritesPageModal')" aria-label="Đóng">×</button>
                    </div>
                    <div class="catalog-page-modal">
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a href="@PageUrl(pageNumber)" class="pagination__btn @(pageNumber == Model.PageNumber ? "active" : "")">@pageNumber</a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@functions {
    private string PageUrl(int page) => $"/Reading/Favorites?page={page}";

    private List<int?> PaginationItems()
    {
        var total = Model.TotalPages;
        var current = Math.Min(Math.Max(Model.PageNumber, 1), total);
        var visiblePages = new SortedSet<int>();

        void AddPage(int page)
        {
            if (page >= 1 && page <= total) visiblePages.Add(page);
        }

        if (total <= 7)
        {
            for (var page = 1; page <= total; page++) AddPage(page);
        }
        else
        {
            AddPage(1);
            AddPage(total);

            for (var page = current - 1; page <= current + 1; page++) AddPage(page);

            if (current <= 4)
            {
                for (var page = 2; page <= 5; page++) AddPage(page);
            }

            if (current >= total - 3)
            {
                for (var page = total - 4; page < total; page++) AddPage(page);
            }
        }

        var items = new List<int?>();
        int? previous = null;
        foreach (var page in visiblePages)
        {
            if (previous.HasValue && page - previous.Value > 1) items.Add(null);
            items.Add(page);
            previous = page;
        }

        return items;
    }

    private static string StatusLabel(string? status) => DisplayText.Status(status);
}
