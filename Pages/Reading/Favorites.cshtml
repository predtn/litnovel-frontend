@page
@model litnovel_frontend.Pages.Reading.FavoritesModel
@{
    ViewData["Title"] = "Truyện yêu thích";
}

<div class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-4xl);">
    <div class="page-header">
        <h1 class="page-header__title">Truyện yêu thích</h1>
        <p class="page-header__subtitle">@Model.Novels.Count truyện</p>
    </div>

    @if (!Model.Novels.Any())
    {
        <div class="empty-state">
            <div class="empty-state__icon">♡</div>
            <div class="empty-state__title">Chưa có truyện yêu thích</div>
            <a href="/Novels" class="btn btn-primary mt-md">Khám phá ngay</a>
        </div>
    }
    else
    {
        <div class="grid-4" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));">
            @foreach (var n in Model.Novels)
            {
                var novelUrl = !string.IsNullOrWhiteSpace(n.Slug) ? n.Slug : n.Id.ToString();
                <div class="novel-card" style="position:relative;">
                    <a href="/Novels/@novelUrl">
                        @if (!string.IsNullOrWhiteSpace(n.CoverImage))
                        {
                            <img class="novel-card__cover" src="@n.CoverImage" alt="@n.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="novel-card__cover-placeholder">Sách</div>
                        }
                    </a>
                    <div class="novel-card__body">
                        <div class="novel-card__title">
                            <a href="/Novels/@novelUrl" style="color:inherit;text-decoration:none;">@n.Title</a>
                        </div>
                        <div class="novel-card__meta">
                            <span>★ @n.RatingAverage.ToString("0.0")</span>
                            <span class="status-badge status-@n.Status.ToLower()">@StatusLabel(n.Status)</span>
                        </div>
                    </div>
                    <form method="post" style="position:absolute;top:var(--space-xs);right:var(--space-xs);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="novelId" value="@n.Id" />
                        <input type="hidden" name="page" value="@Model.PageNumber" />
                        <button type="submit" class="btn-icon" title="Bỏ yêu thích" style="color:var(--color-error);background:rgba(255,255,255,.9);">♡</button>
                    </form>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="flex justify-center mt-xl">
                <div class="pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@PageUrl(Model.PageNumber - 1)" class="pagination__btn">←</a>
                    }
                    @foreach (var item in PaginationItems())
                    {
                        if (item.HasValue)
                        {
                            var pageNumber = item.Value;
                            <a href="@PageUrl(pageNumber)" class="pagination__btn @(pageNumber == Model.PageNumber ? "active" : "")">@pageNumber</a>
                        }
                        else
                        {
                            <span class="pagination__btn disabled">...</span>
                        }
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="@PageUrl(Model.PageNumber + 1)" class="pagination__btn">→</a>
                    }
                    <button type="button" class="pagination__btn" onclick="openModal('favoritesPageModal')" title="Chọn trang" aria-label="Chọn trang">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="4" y1="7" x2="20" y2="7"></line>
                            <line x1="4" y1="12" x2="20" y2="12"></line>
                            <line x1="4" y1="17" x2="20" y2="17"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-overlay" id="favoritesPageModal">
                <div class="modal modal-lg" role="dialog" aria-modal="true" aria-labelledby="favoritesPageModalTitle">
                    <div class="modal__header">
                        <div class="modal__title" id="favoritesPageModalTitle">Chọn trang</div>
                        <button type="button" class="modal__close" onclick="closeModal('favoritesPageModal')" aria-label="Đóng">×</button>
                    </div>
                    <div class="catalog-page-modal">
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a href="@PageUrl(pageNumber)" class="pagination__btn @(pageNumber == Model.PageNumber ? "active" : "")">@pageNumber</a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@functions {
    private string PageUrl(int page) => $"/Reading/Favorites?page={page}";

    private List<int?> PaginationItems()
    {
        var total = Model.TotalPages;
        var current = Math.Min(Math.Max(Model.PageNumber, 1), total);
        var visiblePages = new SortedSet<int>();

        void AddPage(int page)
        {
            if (page >= 1 && page <= total) visiblePages.Add(page);
        }

        if (total <= 7)
        {
            for (var page = 1; page <= total; page++) AddPage(page);
        }
        else
        {
            AddPage(1);
            AddPage(total);

            for (var page = current - 1; page <= current + 1; page++) AddPage(page);

            if (current <= 4)
            {
                for (var page = 2; page <= 5; page++) AddPage(page);
            }

            if (current >= total - 3)
            {
                for (var page = total - 4; page < total; page++) AddPage(page);
            }
        }

        var items = new List<int?>();
        int? previous = null;
        foreach (var page in visiblePages)
        {
            if (previous.HasValue && page - previous.Value > 1) items.Add(null);
            items.Add(page);
            previous = page;
        }

        return items;
    }

    private static string StatusLabel(string? status) => DisplayText.Status(status);
}
